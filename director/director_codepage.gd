## The resolved name and the two directions built from it. Static because the
## codepage is a property of the title and every reader has to agree on it: a
## cast that decoded one way and a writer that encoded another would corrupt on
## the round trip, which is the failure this file exists to end.
static var _active := ""
static var _decode: Array = []
static var _encode: Dictionary = {}


## Which codepage is in force, resolving it on first use.
##
## `--codepage <name>` beats the config, exactly as `--root` does and for the same
## reason: a harness has to be able to run a title the config is not pointing at
## without editing the config. Then `[game] codepage`, then the identity.
##
## An unknown name is *not* silently ignored -- it says so and falls back --
## because a typo that quietly reverted to the identity would present as "the
## encoding fix did not work" with nothing anywhere to say why.
static func active() -> String:
	if _active == "":
		use(_configured())
	return _active


## Force a codepage, for a tool measuring one rather than using the configured
## one. Rebuilds both directions.
static func use(name: String) -> void:
	var wanted := name.strip_edges().to_lower().replace("-", "_")
	if wanted == "":
		wanted = IDENTITY
	if wanted != IDENTITY and not TABLES.has(wanted):
		print("codepage: no table named %s; using %s (known: %s)" % [
			name, IDENTITY, ", ".join(names())])
		wanted = IDENTITY
	_active = wanted
	_decode = [] if wanted == IDENTITY else TABLES[wanted]
	_encode = {}
	if wanted == IDENTITY:
		return
	# Lowest byte wins, so ASCII claims its own code points before a script
	# system's second copy of them can. See the class comment.
	for byte in 128:
		_encode[byte] = byte
	for i in 128:
		var point: int = _decode[i]
		if not _encode.has(point):
			_encode[point] = 128 + i


## Forget what was resolved, so the next `active()` reads the configuration
## again. For a tool that has been forcing tables and now wants to report what a
## player's process would actually get.
static func reset() -> void:
	_active = ""
	_decode = []
	_encode = {}


## Every codepage this knows, the identity first and the tables sorted.
static func names() -> PackedStringArray:
	var out := PackedStringArray([IDENTITY])
	var keys: Array = TABLES.keys()
	keys.sort()
	for key in keys:
		out.append(str(key))
	return out


## Container bytes -> text.
##
## The all-ASCII fast path is the common case by a wide margin -- a script body or
## a member name usually is one -- and takes the same call the port used before
## any of this existed, so the reader costs one scan on the text it did not
## change.
static func decode(raw: PackedByteArray) -> String:
	if active() == IDENTITY:
		return raw.get_string_from_ascii()
	for byte in raw:
		if byte >= 0x80:
			var out := ""
			for b in raw:
				out += String.chr(b if b < 0x80 else int(_decode[b - 0x80]))
			return out
	return raw.get_string_from_ascii()


## Text -> container bytes, one byte per character.
##
## A character the codepage cannot hold is written as `?`, which is what Director
## did with anything outside the authoring script system. That is now the narrow
## case it was always meant to be: before this file *every* code point at or above
## 256 took that branch, so every Hebrew character a player typed did.
static func encode(text: String) -> PackedByteArray:
	var out := PackedByteArray()
	if active() == IDENTITY:
		for i in text.length():
			var point := text.unicode_at(i)
			out.append(point if point < 256 else 0x3f)
		return out
	for i in text.length():
		out.append(int(_encode.get(text.unicode_at(i), 0x3f)))
	return out


## Can the active codepage carry every character of `text`? For a caller that
## wants to report what a save would lose rather than losing it.
static func holds(text: String) -> bool:
	for i in text.length():
		if not can_hold(text.unicode_at(i)):
			return false
	return true


static func can_hold(point: int) -> bool:
	if active() == IDENTITY:
		return point < 256
	return _encode.has(point)


## The configured name, or "" when nothing says.
static func _configured() -> String:
	var override := _from_command_line()
	if override != "":
		return override
	var cfg := ConfigFile.new()
	if cfg.load(CONFIG_PATH) != OK:
		return ""
	return str(cfg.get_value("game", "codepage", ""))


static func _from_command_line() -> String:
	var expecting := false
	for arg in OS.get_cmdline_user_args():
		if expecting:
			return str(arg)
		if str(arg).begins_with("--codepage="):
			return str(arg).substr(11)
		if str(arg) == "--codepage":
			expecting = true
	return ""
