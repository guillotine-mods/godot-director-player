on exitFrame
  [  0] pushsymb 5 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 11 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"esh31.aif">
  [  9] joinstr ................................. <tlkpath & "esh31.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "esh31.aif">
  [ 12] extcall 6 ............................... sound playFile 1, tlkpath & "esh31.aif"
  [ 14] ret
end
