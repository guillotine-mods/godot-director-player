on exitFrame
  [  0] pushsymb 5 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 4 ............................. <soundspath>
  [  7] pushcons 0 .............................. <"zev25.aif">
  [  9] joinstr ................................. <soundspath & "zev25.aif">
  [ 10] pusharglistnoret 3 ...................... <1, soundspath & "zev25.aif">
  [ 12] extcall 6 ............................... sound playFile 1, soundspath & "zev25.aif"
  [ 14] ret
end
