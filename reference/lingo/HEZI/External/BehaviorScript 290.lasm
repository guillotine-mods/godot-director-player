  [ 42] pushcons 16 ............................. <"firsttalk">
  [ 44] pusharglistnoret 1 ...................... <"firsttalk">
  [ 46] extcall 2 ............................... go("firsttalk")
  [ 48] jmp [ 57]
  [ 51] pushcons 24 ............................. <"rilstrt">
  [ 53] pusharglistnoret 1 ...................... <"rilstrt">
  [ 55] extcall 2 ............................... go("rilstrt")
  [ 57] pushint8 50 ............................. <50>
