  [ 18] getchunk ................................ <item 5 of firsttalk>
  [ 19] pushcons 8 .............................. <"0">
  [ 21] eq ...................................... <item 5 of firsttalk = "0">
  [ 22] jmpifz [ 51] ............................ if item 5 of firsttalk = "0" then / else
  [ 25] pushint8 1 .............................. <1>
  [ 28] pushzero ................................ <0>
  [ 29] pushzero ................................ <0>
  [ 30] pushzero ................................ <0>
