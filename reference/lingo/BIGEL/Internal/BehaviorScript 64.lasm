on exitFrame
  [  0] pushsymb 32 ............................. <#playFile>
  [  3] pushint8 1 .............................. <1>
  [  6] getglobal 34 ............................ <soundspath>
  [  9] pushcons 0 .............................. <"mrk9b.aif">
  [ 11] joinstr ................................. <soundspath & "mrk9b.aif">
  [ 12] pusharglistnoret 3 ...................... <1, soundspath & "mrk9b.aif">
  [ 14] extcall 33 .............................. sound playFile 1, soundspath & "mrk9b.aif"
  [ 17] ret
end
