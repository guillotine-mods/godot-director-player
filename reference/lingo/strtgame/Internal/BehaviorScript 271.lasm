on exitFrame
  [  0] pushsymb 15 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 20 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"strt10.aif">
  [  9] joinstr ................................. <tlkpath & "strt10.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "strt10.aif">
  [ 12] extcall 16 .............................. sound playFile 1, tlkpath & "strt10.aif"
  [ 14] ret
end
