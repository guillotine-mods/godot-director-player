on exitFrame
  [  0] pushint8 2 .............................. <2>
  [  3] pusharglist 1 ........................... <2>
  [  5] extcall 17 .............................. <soundBusy(2)>
  [  7] not ..................................... <not soundBusy(2)>
  [  8] jmpifz [ 25] ............................ if not soundBusy(2) then
  [ 11] pushsymb 15 ............................. <#playFile>
  [ 13] pushint8 2 .............................. <2>
  [ 16] getglobal 21 ............................ <effectspath>
  [ 18] pushcons 0 .............................. <"song1.aif">
  [ 20] joinstr ................................. <effectspath & "song1.aif">
  [ 21] pusharglistnoret 3 ...................... <2, effectspath & "song1.aif">
  [ 23] extcall 16 .............................. sound playFile 2, effectspath & "song1.aif"
  [ 25] ret
end
