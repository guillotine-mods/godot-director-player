on exitFrame
  [  0] pushint8 1 .............................. <1>
  [  3] pushint8 8 .............................. <8>
  [  6] set 7 ................................... set the exitLock to 1
  [  8] pushcons 0 .............................. <"strtgame">
  [ 10] pusharglistnoret 1 ...................... <"strtgame">
  [ 12] extcall 20 .............................. tlkpath("strtgame")
  [ 14] pushzero ................................ <0>
  [ 15] setglobal 32 ............................ globalday = 0
  [ 18] ret
end
