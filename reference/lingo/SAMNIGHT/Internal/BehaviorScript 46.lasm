on exitFrame
  [  0] getglobal 23 ............................ <optcounter>
  [  2] pushint8 1 .............................. <1>
  [  5] add ..................................... <optcounter + 1>
  [  6] setglobal 23 ............................ optcounter = optcounter + 1
  [  8] getglobal 23 ............................ <optcounter>
  [ 10] pushint8 3 .............................. <3>
  [ 13] gteq .................................... <optcounter >= 3>
  [ 14] jmpifz [ 26] ............................ if optcounter >= 3 then / else
  [ 17] pushcons 0 .............................. <"choose1abc">
  [ 19] pusharglistnoret 1 ...................... <"choose1abc">
  [ 21] extcall 2 ............................... go("choose1abc")
  [ 23] jmp [ 32]
  [ 26] pushcons 8 .............................. <"choose1">
  [ 28] pusharglistnoret 1 ...................... <"choose1">
  [ 30] extcall 2 ............................... go("choose1")
  [ 32] ret
end
