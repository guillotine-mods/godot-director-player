on exitFrame
  [  0] pushsymb 19 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 24 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"clap.aif">
  [  9] joinstr ................................. <effectspath & "clap.aif">
  [ 10] pusharglistnoret 3 ...................... <1, effectspath & "clap.aif">
  [ 12] extcall 20 .............................. sound playFile 1, effectspath & "clap.aif"
  [ 14] ret
end
