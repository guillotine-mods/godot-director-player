on exitFrame
  [  0] pushsymb 19 ............................. <#playFile>
  [  2] pushint8 2 .............................. <2>
  [  5] getglobal 21 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"hez18.aif">
  [  9] joinstr ................................. <tlkpath & "hez18.aif">
  [ 10] pusharglistnoret 3 ...................... <2, tlkpath & "hez18.aif">
  [ 12] extcall 20 .............................. sound playFile 2, tlkpath & "hez18.aif"
  [ 14] ret
end
