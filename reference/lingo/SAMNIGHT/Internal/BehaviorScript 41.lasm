on exitFrame
  [  0] pushsymb 19 ............................. <#playFile>
  [  2] pushint8 2 .............................. <2>
  [  5] getglobal 24 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"doornob.aif">
  [  9] joinstr ................................. <effectspath & "doornob.aif">
  [ 10] pusharglistnoret 3 ...................... <2, effectspath & "doornob.aif">
  [ 12] extcall 20 .............................. sound playFile 2, effectspath & "doornob.aif"
  [ 14] pushsymb 19 ............................. <#playFile>
  [ 16] pushint8 1 .............................. <1>
  [ 19] getglobal 21 ............................ <tlkpath>
  [ 21] pushcons 8 .............................. <"sam1.aif">
  [ 23] joinstr ................................. <tlkpath & "sam1.aif">
  [ 24] pusharglistnoret 3 ...................... <1, tlkpath & "sam1.aif">
  [ 26] extcall 20 .............................. sound playFile 1, tlkpath & "sam1.aif"
  [ 28] ret
end
