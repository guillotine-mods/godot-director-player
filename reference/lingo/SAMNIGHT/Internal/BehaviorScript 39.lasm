on exitFrame
  [  0] pushsymb 19 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 21 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"mog2.aif">
  [  9] joinstr ................................. <tlkpath & "mog2.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "mog2.aif">
  [ 12] extcall 20 .............................. sound playFile 1, tlkpath & "mog2.aif"
  [ 14] pushzero ................................ <0>
  [ 15] setglobal 23 ............................ optcounter = 0
  [ 17] ret
end
