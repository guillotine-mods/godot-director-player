on mouseUp
  [  0] pushsymb 26 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 28 ............................ <soundspath>
  [  7] pushcons 0 .............................. <"joe6.aif">
  [  9] joinstr ................................. <soundspath & "joe6.aif">
  [ 10] pusharglistnoret 3 ...................... <1, soundspath & "joe6.aif">
  [ 12] extcall 27 .............................. sound playFile 1, soundspath & "joe6.aif"
  [ 14] pushcons 8 .............................. <"choose1a">
  [ 16] pusharglistnoret 1 ...................... <"choose1a">
  [ 18] extcall 7 ............................... go("choose1a")
  [ 20] ret
end
