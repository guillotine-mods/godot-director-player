on exitFrame
  [  0] pushsymb 14 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 16 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"ish30.aif">
  [  9] joinstr ................................. <tlkpath & "ish30.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "ish30.aif">
  [ 12] extcall 15 .............................. sound playFile 1, tlkpath & "ish30.aif"
  [ 14] pushsymb 14 ............................. <#playFile>
  [ 16] pushint8 3 .............................. <3>
  [ 19] getglobal 20 ............................ <effectspath>
  [ 21] pushcons 8 .............................. <"doornob.aif">
  [ 23] joinstr ................................. <effectspath & "doornob.aif">
  [ 24] pusharglistnoret 3 ...................... <3, effectspath & "doornob.aif">
  [ 26] extcall 15 .............................. sound playFile 3, effectspath & "doornob.aif"
  [ 28] ret
end
