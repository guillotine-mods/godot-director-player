on exitFrame
  [  0] pushsymb 14 ............................. <#playFile>
  [  2] pushint8 2 .............................. <2>
  [  5] getglobal 20 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"box2.aif">
  [  9] joinstr ................................. <effectspath & "box2.aif">
  [ 10] pusharglistnoret 3 ...................... <2, effectspath & "box2.aif">
  [ 12] extcall 15 .............................. sound playFile 2, effectspath & "box2.aif"
  [ 14] ret
end
