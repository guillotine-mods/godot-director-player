on exitFrame
  [  0] pushsymb 14 ............................. <#playFile>
  [  2] pushint8 2 .............................. <2>
  [  5] getglobal 20 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"doornob.aif">
  [  9] joinstr ................................. <effectspath & "doornob.aif">
  [ 10] pusharglistnoret 3 ...................... <2, effectspath & "doornob.aif">
  [ 12] extcall 15 .............................. sound playFile 2, effectspath & "doornob.aif"
  [ 14] ret
end
