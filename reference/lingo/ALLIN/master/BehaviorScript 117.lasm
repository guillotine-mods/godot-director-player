on exitFrame
  [  0] pushsymb 14 ............................. <#playFile>
  [  2] pushint8 3 .............................. <3>
  [  5] getglobal 20 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"floor.aif">
  [  9] joinstr ................................. <effectspath & "floor.aif">
  [ 10] pusharglistnoret 3 ...................... <3, effectspath & "floor.aif">
  [ 12] extcall 15 .............................. sound playFile 3, effectspath & "floor.aif"
  [ 14] ret
end
