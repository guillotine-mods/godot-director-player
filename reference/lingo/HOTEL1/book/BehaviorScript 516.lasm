on exitFrame
  [  0] pushsymb 52 ............................. <#playFile>
  [  3] pushint8 1 .............................. <1>
  [  6] getglobal 37 ............................ <soundspath>
  [  9] pushcons 0 .............................. <"inbath.aif">
  [ 11] joinstr ................................. <soundspath & "inbath.aif">
  [ 12] pusharglistnoret 3 ...................... <1, soundspath & "inbath.aif">
  [ 14] extcall 53 .............................. sound playFile 1, soundspath & "inbath.aif"
  [ 17] ret
end
