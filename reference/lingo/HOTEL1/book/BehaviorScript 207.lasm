on exitFrame
  [  0] pushzero ................................ <0>
  [  1] pushzero ................................ <0>
  [  2] pushzero ................................ <0>
  [  3] pushzero ................................ <0>
  [  4] pushint8 1 .............................. <1>
  [  7] pushzero ................................ <0>
  [  8] pushzero ................................ <0>
  [  9] pushzero ................................ <0>
  [ 10] getglobal 24 ............................ <nextroomdata>
  [ 12] getchunk ................................ <item 1 of nextroomdata>
  [ 13] pusharglistnoret 1 ...................... <item 1 of nextroomdata>
  [ 15] extcall 3 ............................... go(item 1 of nextroomdata)
  [ 17] pushint8 30 ............................. <30>
  [ 20] pusharglist 1 ........................... <30>
  [ 22] extcall 12 .............................. <sprite(30)>
  [ 24] pushint8 1 .............................. <1>
  [ 27] setobjprop 13 ........................... sprite(30).visible = 1
  [ 29] pushcons 0 .............................. <"000">
  [ 31] setglobal 24 ............................ nextroomdata = "000"
  [ 33] ret
end
