on exitFrame
  [  0] pushint8 16 ............................. <16>
  [  3] pusharglist 1 ........................... <16>
  [  5] extcall 12 .............................. <sprite(16)>
  [  7] pushint8 1 .............................. <1>
  [ 10] setobjprop 13 ........................... sprite(16).visible = 1
  [ 12] ret
end
