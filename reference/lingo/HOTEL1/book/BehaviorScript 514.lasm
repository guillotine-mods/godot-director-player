on exitFrame
  [  0] pushint8 32 ............................. <32>
  [  3] pusharglist 1 ........................... <32>
  [  5] extcall 12 .............................. <sprite(32)>
  [  7] pushint8 1 .............................. <1>
  [ 10] setobjprop 13 ........................... sprite(32).visible = 1
  [ 12] pushint8 34 ............................. <34>
  [ 15] pusharglist 1 ........................... <34>
  [ 17] extcall 12 .............................. <sprite(34)>
  [ 19] pushint8 1 .............................. <1>
  [ 22] setobjprop 13 ........................... sprite(34).visible = 1
  [ 24] ret
end
