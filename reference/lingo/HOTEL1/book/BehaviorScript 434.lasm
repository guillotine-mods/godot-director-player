on mouseUp
  [  0] pushsymb 52 ............................. <#playFile>
  [  3] pushint8 1 .............................. <1>
  [  6] getglobal 37 ............................ <soundspath>
  [  9] pushcons 0 .............................. <"hatrooma.aif">
  [ 11] joinstr ................................. <soundspath & "hatrooma.aif">
  [ 12] pusharglistnoret 3 ...................... <1, soundspath & "hatrooma.aif">
  [ 14] extcall 53 .............................. sound playFile 1, soundspath & "hatrooma.aif"
  [ 17] pushcons 8 .............................. <"hatspkroom1">
  [ 19] pusharglistnoret 1 ...................... <"hatspkroom1">
  [ 21] extcall 68 .............................. play frame "hatspkroom1"
  [ 24] ret
end
