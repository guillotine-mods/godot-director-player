on exitFrame
  [  0] pushcons 0 .............................. <"verandaz">
  [  2] pushcons 8 .............................. <"day1.dir">
  [  4] pusharglistnoret 2 ...................... <"verandaz", "day1.dir">
  [  6] extcall 3 ............................... go("verandaz", "day1.dir")
  [  8] pusharglistnoret 0 ...................... <>
  [ 10] extcall 27 .............................. peoplefunk()
  [ 12] pushint8 30 ............................. <30>
  [ 15] pushint8 1 .............................. <1>
  [ 18] pusharglistnoret 2 ...................... <30, 1>
  [ 20] extcall 31 .............................. puppetSprite(30, 1)
  [ 22] pushint8 30 ............................. <30>
  [ 25] pusharglist 1 ........................... <30>
  [ 27] extcall 12 .............................. <sprite(30)>
  [ 29] pushint8 1 .............................. <1>
  [ 32] setobjprop 13 ........................... sprite(30).visible = 1
  [ 34] pushcons 16 ............................. <"000">
  [ 36] setglobal 24 ............................ nextroomdata = "000"
  [ 38] getmovieprop 120 ........................ <the movieName>
  [ 41] pushcons 24 ............................. <"day1.dxr">
  [ 43] eq ...................................... <the movieName = "day1.dxr">
  [ 44] jmpifz [ 56] ............................ if the movieName = "day1.dxr" then
  [ 47] pusharglistnoret 0 ...................... <>
  [ 49] extcall 30 .............................. cursorfunk()
  [ 51] pusharglistnoret 0 ...................... <>
  [ 53] extcall 74 .............................. displayobject()
  [ 56] ret
end
