  [  7] pushzero ................................ <0>
  [  8] pushzero ................................ <0>
  [  9] pushzero ................................ <0>
  [ 10] getglobal 39 ............................ <inexits>
  [ 13] getchunk ................................ <item 6 of inexits>
  [ 14] pusharglist 1 ........................... <item 6 of inexits>
  [ 16] extcall 23 .............................. <value(item 6 of inexits)>
  [ 18] pushcons 0 .............................. <"4">
  [ 20] eq ...................................... <value(item 6 of inexits) = "4">
  [ 21] jmpifz [ 46] ............................ if value(item 6 of inexits) = "4" then
  [ 24] pushint8 18 ............................. <18>
  [ 27] pusharglist 1 ........................... <18>
  [ 29] extcall 12 .............................. <sprite(18)>
  [ 31] pushzero ................................ <0>
  [ 32] setobjprop 13 ........................... sprite(18).visible = 0
  [ 34] pushint8 34 ............................. <34>
