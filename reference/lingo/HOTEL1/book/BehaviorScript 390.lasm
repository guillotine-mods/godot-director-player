on exitFrame
  [  0] pushsymb 52 ............................. <#playFile>
  [  3] pushint8 1 .............................. <1>
  [  6] getglobal 37 ............................ <soundspath>
  [  9] pushcons 0 .............................. <"sink2.aif">
  [ 11] joinstr ................................. <soundspath & "sink2.aif">
  [ 12] pusharglistnoret 3 ...................... <1, soundspath & "sink2.aif">
  [ 14] extcall 53 .............................. sound playFile 1, soundspath & "sink2.aif"
  [ 17] ret
end
