on mouseUp
  [  0] pushsymb 52 ............................. <#playFile>
  [  3] pushint8 1 .............................. <1>
  [  6] getglobal 37 ............................ <soundspath>
  [  9] pushcons 0 .............................. <"manday1a.aif">
  [ 11] joinstr ................................. <soundspath & "manday1a.aif">
  [ 12] pusharglistnoret 3 ...................... <1, soundspath & "manday1a.aif">
  [ 14] extcall 53 .............................. sound playFile 1, soundspath & "manday1a.aif"
  [ 17] pushcons 8 .............................. <"mantalk">
  [ 19] pusharglistnoret 1 ...................... <"mantalk">
  [ 21] extcall 68 .............................. play frame "mantalk"
  [ 24] ret
end
