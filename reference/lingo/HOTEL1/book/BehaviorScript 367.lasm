on exitFrame
  [  0] pushint8 1 .............................. <1>
  [  3] pusharglist 1 ........................... <1>
  [  5] extcall 58 .............................. <soundBusy(1)>
  [  8] not ..................................... <not soundBusy(1)>
  [  9] jmpifz [ 23] ............................ if not soundBusy(1) then
  [ 12] pushint8 1 .............................. <1>
  [ 15] pusharglist 1 ........................... <1>
  [ 17] extcall 2 ............................... <marker(1)>
  [ 19] pusharglistnoret 1 ...................... <marker(1)>
  [ 21] extcall 3 ............................... go(marker(1))
  [ 23] ret
end
