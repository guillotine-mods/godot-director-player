on exitFrame
  [  0] pushint8 22 ............................. <22>
  [  3] pusharglist 1 ........................... <22>
  [  5] extcall 12 .............................. <sprite(22)>
  [  7] pushzero ................................ <0>
  [  8] setobjprop 13 ........................... sprite(22).visible = 0
  [ 10] pushint8 9 .............................. <9>
  [ 13] setglobal 19 ............................ syz = 9
  [ 15] pushint8 30 ............................. <30>
  [ 18] pushcons 0 .............................. <"standright9">
  [ 20] pushzero ................................ <0>
  [ 21] pushint8 10 ............................. <10>
  [ 24] get 9 ................................... <the number of member "standright9">
  [ 26] pushint8 35 ............................. <35>
  [ 29] set 6 ................................... set the memberNum of sprite 30 to the number of member "standright9"
  [ 31] pushcons 8 .............................. <"roomb">
  [ 33] pusharglistnoret 1 ...................... <"roomb">
  [ 35] extcall 3 ............................... go("roomb")
  [ 37] pushint8 30 ............................. <30>
  [ 40] pusharglist 1 ........................... <30>
  [ 42] extcall 12 .............................. <sprite(30)>
  [ 44] pushint8 1 .............................. <1>
  [ 47] setobjprop 13 ........................... sprite(30).visible = 1
  [ 49] pushcons 16 ............................. <"000">
  [ 51] setglobal 24 ............................ nextroomdata = "000"
  [ 53] ret
end
