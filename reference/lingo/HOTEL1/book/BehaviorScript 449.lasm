on exitFrame
  [  0] pushint8 30 ............................. <30>
  [  3] pusharglist 1 ........................... <30>
  [  5] extcall 12 .............................. <sprite(30)>
  [  7] pushint8 1 .............................. <1>
  [ 10] setobjprop 13 ........................... sprite(30).visible = 1
  [ 12] pushcons 0 .............................. <"recept">
  [ 14] pusharglistnoret 1 ...................... <"recept">
  [ 16] extcall 3 ............................... go("recept")
  [ 18] ret
end
