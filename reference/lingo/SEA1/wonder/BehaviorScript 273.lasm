on exitFrame
  [  0] pushint8 3 .............................. <3>
  [  2] setlocal 0
  [  4] getlocal 0
  [  6] pushint8 6 .............................. <6>
  [  8] lteq
  [  9] jmpifz [ 38] ............................ repeat with i = 3 to 6
  [ 12] getlocal 0 .............................. <i>
  [ 14] pushzero ................................ <0>
  [ 15] pushint8 25 ............................. <25>
  [ 17] set 6 ................................... set the visible of sprite i to 0
  [ 19] getlocal 0 .............................. <i>
  [ 21] pushint8 13 ............................. <13>
  [ 23] add ..................................... <i + 13>
  [ 24] pushzero ................................ <0>
  [ 25] pushint8 25 ............................. <25>
  [ 27] set 6 ................................... set the visible of sprite (i + 13) to 0
  [ 29] pushint8 1
  [ 31] getlocal 0
  [ 33] add
  [ 34] setlocal 0
  [ 36] endrepeat [  4]
  [ 38] pushint8 17 ............................. <17>
  [ 40] pushint8 1 .............................. <1>
  [ 42] pushint8 25 ............................. <25>
  [ 44] set 6 ................................... set the visible of sprite 17 to 1
  [ 46] pushcons 0 .............................. <"map">
  [ 48] pusharglistnoret 1 ...................... <"map">
  [ 50] extcall 3 ............................... go("map")
  [ 52] ret
end
