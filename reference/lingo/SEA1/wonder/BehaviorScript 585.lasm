on exitFrame
  [  0] pushsymb 42 ............................. <#playFile>
  [  3] pushint8 1 .............................. <1>
  [  6] getglobal 20 ............................ <soundspath>
  [  8] pushcons 0 .............................. <"dubmony3.aif">
  [ 10] joinstr ................................. <soundspath & "dubmony3.aif">
  [ 11] pusharglistnoret 3 ...................... <1, soundspath & "dubmony3.aif">
  [ 13] extcall 43 .............................. sound playFile 1, soundspath & "dubmony3.aif"
  [ 16] ret
end
