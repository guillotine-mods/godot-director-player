on exitFrame
  [  0] pushint8 1 .............................. <1>
  [  2] pusharglist 1 ........................... <1>
  [  4] extcall 50 .............................. <soundBusy(1)>
  [  6] not ..................................... <not soundBusy(1)>
  [  7] jmpifz [ 20] ............................ if not soundBusy(1) then
  [ 10] pushint8 1 .............................. <1>
  [ 12] pusharglist 1 ........................... <1>
  [ 14] extcall 2 ............................... <marker(1)>
  [ 16] pusharglistnoret 1 ...................... <marker(1)>
  [ 18] extcall 3 ............................... go(marker(1))
  [ 20] ret
end
