on exitFrame
  [  0] pushint8 30 ............................. <30>
  [  3] pusharglist 1 ........................... <30>
  [  5] extcall 58 .............................. <sprite(30)>
  [  8] pushzero ................................ <0>
  [  9] setobjprop 89 ........................... sprite(30).visible = 0
  [ 12] pushint8 31 ............................. <31>
  [ 15] pusharglist 1 ........................... <31>
  [ 17] extcall 58 .............................. <sprite(31)>
  [ 20] pushzero ................................ <0>
  [ 21] setobjprop 89 ........................... sprite(31).visible = 0
  [ 24] pushint8 4 .............................. <4>
  [ 27] pusharglist 1 ........................... <4>
  [ 29] extcall 58 .............................. <sprite(4)>
  [ 32] pushint8 1 .............................. <1>
  [ 35] setobjprop 89 ........................... sprite(4).visible = 1
  [ 38] pushint8 5 .............................. <5>
  [ 41] pusharglist 1 ........................... <5>
  [ 43] extcall 58 .............................. <sprite(5)>
  [ 46] pushint8 1 .............................. <1>
  [ 49] setobjprop 89 ........................... sprite(5).visible = 1
  [ 52] pushint8 18 ............................. <18>
  [ 55] pusharglist 1 ........................... <18>
  [ 57] extcall 58 .............................. <sprite(18)>
  [ 60] pushint8 1 .............................. <1>
  [ 63] setobjprop 89 ........................... sprite(18).visible = 1
  [ 66] pushint8 19 ............................. <19>
  [ 69] pusharglist 1 ........................... <19>
  [ 71] extcall 58 .............................. <sprite(19)>
  [ 74] pushint8 1 .............................. <1>
  [ 77] setobjprop 89 ........................... sprite(19).visible = 1
  [ 80] pushint8 2 .............................. <2>
  [ 83] pushint8 90 ............................. <90>
  [ 86] pushint8 1 .............................. <1>
  [ 89] set 4 ................................... set the volume of sound 2 to 90
  [ 91] pushsymb 42 ............................. <#playFile>
  [ 94] pushint8 1 .............................. <1>
  [ 97] getglobal 20 ............................ <soundspath>
  [ 99] pushcons 0 .............................. <"eatthis.aif">
  [101] joinstr ................................. <soundspath & "eatthis.aif">
  [102] pusharglistnoret 3 ...................... <1, soundspath & "eatthis.aif">
  [104] extcall 43 .............................. sound playFile 1, soundspath & "eatthis.aif"
  [107] ret
end
