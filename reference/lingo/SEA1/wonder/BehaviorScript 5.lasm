on exitFrame
  [  0] pushcons 0 .............................. <"show">
  [  2] setlocal 0 .............................. x = "show"
  [  4] pushint8 1 .............................. <1>
  [  6] setlocal 8
  [  8] getlocal 8
  [ 10] pushint8 30 ............................. <30>
  [ 12] lteq
  [ 13] jmpifz [ 50] ............................ repeat with i = 1 to 30
  [ 16] pushzero ................................ <0>
  [ 17] pushzero ................................ <0>
  [ 18] pushzero ................................ <0>
  [ 19] pushzero ................................ <0>
  [ 20] pushzero ................................ <0>
  [ 21] pushzero ................................ <0>
  [ 22] getlocal 8 .............................. <i>
  [ 24] pushzero ................................ <0>
  [ 25] pushcons 8 .............................. <"objectsfield">
  [ 27] pushcons 16 ............................. <"master">
  [ 29] getfield ................................ <field("objectsfield", "master")>
  [ 30] getchunk ................................ <line i of field "objectsfield" of castLib "master">
  [ 31] pushcons 24 ............................. <"tools">
  [ 33] eq ...................................... <line i of field "objectsfield" of castLib "master" = "tools">
  [ 34] jmpifz [ 41] ............................ if line i of field "objectsfield" of castLib "master" = "tools" then
  [ 37] pushcons 32 ............................. <"hide">
  [ 39] setlocal 0 .............................. x = "hide"
  [ 41] pushint8 1
  [ 43] getlocal 8
  [ 45] add
  [ 46] setlocal 8
  [ 48] endrepeat [  8]
  [ 50] getlocal 0 .............................. <x>
  [ 52] pushcons 40 ............................. <"hide">
  [ 54] eq ...................................... <x = "hide">
  [ 55] jmpifz [ 68] ............................ if x = "hide" then / else
  [ 58] pushint8 17 ............................. <17>
  [ 60] pushzero ................................ <0>
  [ 61] pushint8 25 ............................. <25>
  [ 63] set 6 ................................... set the visible of sprite 17 to 0
  [ 65] jmp [ 76]
  [ 68] pushint8 17 ............................. <17>
  [ 70] pushint8 1 .............................. <1>
  [ 72] pushint8 25 ............................. <25>
  [ 74] set 6 ................................... set the visible of sprite 17 to 1
  [ 76] ret
end
