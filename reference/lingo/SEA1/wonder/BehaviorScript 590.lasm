on mouseUp
  [  0] pushsymb 96 ............................. <#stop>
  [  3] pushint8 2 .............................. <2>
  [  6] pusharglistnoret 2 ...................... <2>
  [  8] extcall 43 .............................. sound stop 2
  [ 11] pushsymb 42 ............................. <#playFile>
  [ 14] pushint8 1 .............................. <1>
  [ 17] getglobal 20 ............................ <soundspath>
  [ 19] pushcons 0 .............................. <"octo">
  [ 21] pushint8 3 .............................. <3>
  [ 24] pusharglist 1 ........................... <3>
  [ 26] extcall 44 .............................. <random(3)>
  [ 29] joinstr ................................. <"octo" & random(3)>
  [ 30] pushcons 8 .............................. <".aif">
  [ 32] joinstr ................................. <"octo" & random(3) & ".aif">
  [ 33] joinstr ................................. <soundspath & "octo" & random(3) & ".aif">
  [ 34] pusharglistnoret 3 ...................... <1, soundspath & "octo" & random(3) & ".aif">
  [ 36] extcall 43 .............................. sound playFile 1, soundspath & "octo" & random(3) & ".aif"
  [ 39] ret
end
