on exitFrame
  [  0] pushint8 2 .............................. <2>
  [  3] pusharglist 1 ........................... <2>
  [  5] extcall 50 .............................. <soundBusy(2)>
  [  8] not ..................................... <not soundBusy(2)>
  [  9] getglobal 97 ............................ <whichsnd>
  [ 12] pushcons 0 .............................. <"dive1">
  [ 14] nteq .................................... <whichsnd <> "dive1">
  [ 15] or ...................................... <not soundBusy(2) or (whichsnd <> "dive1")>
  [ 16] jmpifz [ 63] ............................ if not soundBusy(2) or (whichsnd <> "dive1") then
  [ 19] pushint8 2 .............................. <2>
  [ 22] pushint8 90 ............................. <90>
  [ 25] pushint8 1 .............................. <1>
  [ 28] set 4 ................................... set the volume of sound 2 to 90
  [ 30] pushint8 1 .............................. <1>
  [ 33] pusharglist 1 ........................... <1>
  [ 35] extcall 50 .............................. <soundBusy(1)>
  [ 38] not ..................................... <not soundBusy(1)>
  [ 39] jmpifz [ 58] ............................ if not soundBusy(1) then
  [ 42] pushsymb 42 ............................. <#playFile>
  [ 45] pushint8 2 .............................. <2>
  [ 48] getglobal 21 ............................ <effectspath>
  [ 50] pushcons 8 .............................. <"dive1.aif">
  [ 52] joinstr ................................. <effectspath & "dive1.aif">
  [ 53] pusharglistnoret 3 ...................... <2, effectspath & "dive1.aif">
  [ 55] extcall 43 .............................. sound playFile 2, effectspath & "dive1.aif"
  [ 58] pushcons 16 ............................. <"dive1">
  [ 60] setglobal 97 ............................ whichsnd = "dive1"
  [ 63] ret
end
