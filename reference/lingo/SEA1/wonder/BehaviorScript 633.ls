on exitFrame
  global effectspath
  sound playFile 1, effectspath & "boom.aif"
  x = value(the text of field "points" of castLib "master")
  x = x + 1
  if x < 10 then
    put "00" & x into field "points" of castLib "master"
  else
    put "0" & x into field "points" of castLib "master"
  end if
end
