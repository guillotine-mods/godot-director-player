on exitFrame
  [  0] getglobal 15 ............................ <dubi>
  [  2] pushzero ................................ <0>
  [  3] eq ...................................... <dubi = 0>
  [  4] jmpifz [ 16] ............................ if dubi = 0 then / else
  [  7] pushcons 0 .............................. <"enterwarehouse1">
  [  9] pusharglistnoret 1 ...................... <"enterwarehouse1">
  [ 11] extcall 3 ............................... go("enterwarehouse1")
  [ 13] jmp [ 60]
  [ 16] getglobal 15 ............................ <dubi>
  [ 18] pushint8 1 .............................. <1>
  [ 20] eq ...................................... <dubi = 1>
  [ 21] jmpifz [ 33] ............................ if dubi = 1 then / else
  [ 24] pushcons 8 .............................. <"enterwarehouse2">
  [ 26] pusharglistnoret 1 ...................... <"enterwarehouse2">
  [ 28] extcall 3 ............................... go("enterwarehouse2")
  [ 30] jmp [ 60]
  [ 33] pushint8 26 ............................. <26>
  [ 35] pushzero ................................ <0>
  [ 36] pushint8 25 ............................. <25>
  [ 38] set 6 ................................... set the visible of sprite 26 to 0
  [ 40] pushint8 25 ............................. <25>
  [ 42] pushzero ................................ <0>
  [ 43] pushint8 25 ............................. <25>
  [ 45] set 6 ................................... set the visible of sprite 25 to 0
  [ 47] pushint8 31 ............................. <31>
  [ 49] pushzero ................................ <0>
  [ 50] pushint8 25 ............................. <25>
  [ 52] set 6 ................................... set the visible of sprite 31 to 0
  [ 54] pushcons 16 ............................. <"enterwarehouse3">
  [ 56] pusharglistnoret 1 ...................... <"enterwarehouse3">
  [ 58] extcall 3 ............................... go("enterwarehouse3")
  [ 60] ret
end
