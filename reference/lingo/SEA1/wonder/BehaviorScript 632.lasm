on enterFrame
  [  0] pushint8 30 ............................. <30>
  [  3] pusharglist 1 ........................... <30>
  [  5] extcall 58 .............................. <sprite(30)>
  [  8] pushzero ................................ <0>
  [  9] setobjprop 89 ........................... sprite(30).visible = 0
  [ 12] pushint8 31 ............................. <31>
  [ 15] pusharglist 1 ........................... <31>
  [ 17] extcall 58 .............................. <sprite(31)>
  [ 20] pushint8 1 .............................. <1>
  [ 23] setobjprop 89 ........................... sprite(31).visible = 1
  [ 26] pushint8 32 ............................. <32>
  [ 29] pusharglist 1 ........................... <32>
  [ 31] extcall 58 .............................. <sprite(32)>
  [ 34] pushint8 1 .............................. <1>
  [ 37] setobjprop 89 ........................... sprite(32).visible = 1
  [ 40] pushint8 33 ............................. <33>
  [ 43] pusharglist 1 ........................... <33>
  [ 45] extcall 58 .............................. <sprite(33)>
  [ 48] pushint8 1 .............................. <1>
  [ 51] setobjprop 89 ........................... sprite(33).visible = 1
  [ 54] pushsymb 42 ............................. <#playFile>
  [ 57] pushint8 1 .............................. <1>
  [ 60] getglobal 20 ............................ <soundspath>
  [ 62] pushcons 0 .............................. <"hezifly.aif">
  [ 64] joinstr ................................. <soundspath & "hezifly.aif">
  [ 65] pusharglistnoret 3 ...................... <1, soundspath & "hezifly.aif">
  [ 67] extcall 43 .............................. sound playFile 1, soundspath & "hezifly.aif"
  [ 70] pushsymb 96 ............................. <#stop>
  [ 73] pushint8 2 .............................. <2>
  [ 76] pusharglistnoret 2 ...................... <2>
  [ 78] extcall 43 .............................. sound stop 2
  [ 81] ret
end
