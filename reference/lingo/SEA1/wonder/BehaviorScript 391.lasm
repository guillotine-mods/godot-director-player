on exitFrame
  [  0] pushcons 0 .............................. <"hall1,274,210">
  [  2] setglobal 23 ............................ nextroomdata = "hall1,274,210"
  [  4] pushcons 8 .............................. <"hall1">
  [  6] pusharglistnoret 1 ...................... <"hall1">
  [  8] extcall 3 ............................... go("hall1")
  [ 10] pushint8 210 ............................ <210>
  [ 13] setglobal 11 ............................ egozv = 210
  [ 15] pushint8 274 ............................ <274>
  [ 18] setglobal 10 ............................ egozh = 274
  [ 20] pushint8 30 ............................. <30>
  [ 22] pushint8 1 .............................. <1>
  [ 24] pusharglistnoret 2 ...................... <30, 1>
  [ 26] extcall 26 .............................. puppetSprite(30, 1)
  [ 28] pushint8 30 ............................. <30>
  [ 30] getglobal 10 ............................ <egozh>
  [ 32] pushint8 13 ............................. <13>
  [ 34] set 6 ................................... set the locH of sprite 30 to egozh
  [ 36] pushint8 30 ............................. <30>
  [ 38] getglobal 11 ............................ <egozv>
  [ 40] pushint8 14 ............................. <14>
  [ 42] set 6 ................................... set the locV of sprite 30 to egozv
  [ 44] pusharglistnoret 0 ...................... <>
  [ 46] extcall 12 .............................. updateStage()
  [ 48] ret
end
