on mouseUp
  [  0] pushint8 35 ............................. <35>
  [  3] pusharglist 1 ........................... <35>
  [  5] extcall 58 .............................. <sprite(35)>
  [  8] getobjprop 89 ........................... <sprite(35).visible>
  [ 11] pushint8 1 .............................. <1>
  [ 14] eq ...................................... <sprite(35).visible = 1>
  [ 15] jmpifz [ 52] ............................ if sprite(35).visible = 1 then
  [ 18] pushsymb 96 ............................. <#stop>
  [ 21] pushint8 2 .............................. <2>
  [ 24] pusharglistnoret 2 ...................... <2>
  [ 26] extcall 43 .............................. sound stop 2
  [ 29] pushsymb 42 ............................. <#playFile>
  [ 32] pushint8 1 .............................. <1>
  [ 35] getglobal 20 ............................ <soundspath>
  [ 37] pushcons 0 .............................. <"brjsub.aif">
  [ 39] joinstr ................................. <soundspath & "brjsub.aif">
  [ 40] pusharglistnoret 3 ...................... <1, soundspath & "brjsub.aif">
  [ 42] extcall 43 .............................. sound playFile 1, soundspath & "brjsub.aif"
  [ 45] pushcons 8 .............................. <"brjtalk2">
  [ 47] pusharglistnoret 1 ...................... <"brjtalk2">
  [ 49] extcall 48 .............................. play frame "brjtalk2"
  [ 52] ret
end
