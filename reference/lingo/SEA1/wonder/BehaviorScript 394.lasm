on exitFrame
  [  0] pushzero ................................ <0>
  [  1] pushzero ................................ <0>
  [  2] pushzero ................................ <0>
  [  3] pushzero ................................ <0>
  [  4] pushint8 1 .............................. <1>
  [  6] pushzero ................................ <0>
  [  7] pushzero ................................ <0>
  [  8] pushzero ................................ <0>
  [  9] getglobal 23 ............................ <nextroomdata>
  [ 11] getchunk ................................ <item 1 of nextroomdata>
  [ 12] pusharglistnoret 1 ...................... <item 1 of nextroomdata>
  [ 14] extcall 3 ............................... go(item 1 of nextroomdata)
  [ 16] pushint8 30 ............................. <30>
  [ 18] pushint8 1 .............................. <1>
  [ 20] pushint8 25 ............................. <25>
  [ 22] set 6 ................................... set the visible of sprite 30 to 1
  [ 24] pushcons 0 .............................. <"000">
  [ 26] setglobal 23 ............................ nextroomdata = "000"
  [ 28] ret
end
