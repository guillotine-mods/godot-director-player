on exitFrame
  [  0] pushcons 0 .............................. <"brjroom">
  [  2] pusharglistnoret 1 ...................... <"brjroom">
  [  4] extcall 3 ............................... go("brjroom")
  [  6] pushint8 30 ............................. <30>
  [  9] pusharglist 1 ........................... <30>
  [ 11] extcall 58 .............................. <sprite(30)>
  [ 14] pushint8 1 .............................. <1>
  [ 17] setobjprop 89 ........................... sprite(30).visible = 1
  [ 20] pushint8 31 ............................. <31>
  [ 23] pusharglist 1 ........................... <31>
  [ 25] extcall 58 .............................. <sprite(31)>
  [ 28] pushint8 1 .............................. <1>
  [ 31] setobjprop 89 ........................... sprite(31).visible = 1
  [ 34] ret
end
