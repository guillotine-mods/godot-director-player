on exitFrame
  [  0] pushint8 2 .............................. <2>
  [  3] pusharglist 1 ........................... <2>
  [  5] extcall 50 .............................. <soundBusy(2)>
  [  8] not ..................................... <not soundBusy(2)>
  [  9] jmpifz [ 28] ............................ if not soundBusy(2) then
  [ 12] pushsymb 42 ............................. <#playFile>
  [ 15] pushint8 2 .............................. <2>
  [ 18] getglobal 21 ............................ <effectspath>
  [ 20] pushcons 0 .............................. <"wreck3.aif">
  [ 22] joinstr ................................. <effectspath & "wreck3.aif">
  [ 23] pusharglistnoret 3 ...................... <2, effectspath & "wreck3.aif">
  [ 25] extcall 43 .............................. sound playFile 2, effectspath & "wreck3.aif"
  [ 28] ret
end
