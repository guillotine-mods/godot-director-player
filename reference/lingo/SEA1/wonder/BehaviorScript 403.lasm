on exitFrame
  [  0] pushint8 30 ............................. <30>
  [  2] pushcons 0 .............................. <"substandright">
  [  4] pushzero ................................ <0>
  [  5] pushint8 10 ............................. <10>
  [  7] get 9 ................................... <the number of member "substandright">
  [  9] pushint8 35 ............................. <35>
  [ 11] set 6 ................................... set the memberNum of sprite 30 to the number of member "substandright"
  [ 13] pushzero ................................ <0>
  [ 14] pushzero ................................ <0>
  [ 15] pushzero ................................ <0>
  [ 16] pushzero ................................ <0>
  [ 17] pushint8 1 .............................. <1>
  [ 19] pushzero ................................ <0>
  [ 20] pushzero ................................ <0>
  [ 21] pushzero ................................ <0>
  [ 22] getglobal 23 ............................ <nextroomdata>
  [ 24] getchunk ................................ <item 1 of nextroomdata>
  [ 25] pusharglistnoret 1 ...................... <item 1 of nextroomdata>
  [ 27] extcall 3 ............................... go(item 1 of nextroomdata)
  [ 29] pushint8 30 ............................. <30>
  [ 31] pushint8 1 .............................. <1>
  [ 33] pushint8 25 ............................. <25>
  [ 35] set 6 ................................... set the visible of sprite 30 to 1
  [ 37] pushcons 8 .............................. <"000">
  [ 39] setglobal 23 ............................ nextroomdata = "000"
  [ 41] ret
end
