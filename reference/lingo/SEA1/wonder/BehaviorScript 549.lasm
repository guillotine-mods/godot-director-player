on mouseUp
  [  0] pushsymb 42 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  4] getglobal 20 ............................ <soundspath>
  [  6] pushcons 0 .............................. <"lulurmrk.aif">
  [  8] joinstr ................................. <soundspath & "lulurmrk.aif">
  [  9] pusharglistnoret 3 ...................... <1, soundspath & "lulurmrk.aif">
  [ 11] extcall 43 .............................. sound playFile 1, soundspath & "lulurmrk.aif"
  [ 13] ret
end
