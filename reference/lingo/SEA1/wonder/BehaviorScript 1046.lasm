on exitFrame
  [  0] pushsymb 42 ............................. <#playFile>
  [  3] pushint8 2 .............................. <2>
  [  6] getglobal 21 ............................ <effectspath>
  [  8] pushcons 0 .............................. <"dive1.aif">
  [ 10] joinstr ................................. <effectspath & "dive1.aif">
  [ 11] pusharglistnoret 3 ...................... <2, effectspath & "dive1.aif">
  [ 13] extcall 43 .............................. sound playFile 2, effectspath & "dive1.aif"
  [ 16] ret
end
