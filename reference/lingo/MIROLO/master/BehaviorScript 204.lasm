on exitFrame
  [  0] pushsymb 34 ............................. <#stop>
  [  3] pushint8 2 .............................. <2>
  [  6] pusharglistnoret 2 ...................... <2>
  [  8] extcall 20 .............................. sound stop 2
  [ 10] pushint8 2 .............................. <2>
  [ 13] setlocal 0
  [ 15] getlocal 0
  [ 17] pushint8 40 ............................. <40>
  [ 20] lteq
  [ 21] jmpifz [ 54] ............................ repeat with i = 2 to 40
  [ 24] getlocal 0 .............................. <i>
  [ 26] pusharglist 1 ........................... <i>
  [ 28] extcall 30 .............................. <sprite(i)>
  [ 30] pushint8 1 .............................. <1>
  [ 33] setobjprop 31 ........................... sprite(i).visible = 1
  [ 35] getlocal 0 .............................. <i>
  [ 37] pushzero ................................ <0>
  [ 38] pusharglistnoret 2 ...................... <i, 0>
  [ 40] extcall 32 .............................. puppetSprite(i, 0)
  [ 43] pushint8 1
  [ 46] getlocal 0
  [ 48] add
  [ 49] setlocal 0
  [ 51] endrepeat [ 15]
  [ 54] pushint8 100 ............................ <100>
  [ 57] setlocal 0
  [ 59] getlocal 0
  [ 61] pushint8 110 ............................ <110>
  [ 64] lteq
  [ 65] jmpifz [ 86] ............................ repeat with i = 100 to 110
  [ 68] getlocal 0 .............................. <i>
  [ 70] pushzero ................................ <0>
  [ 71] pusharglistnoret 2 ...................... <i, 0>
  [ 73] extcall 32 .............................. puppetSprite(i, 0)
  [ 76] pushint8 1
  [ 79] getlocal 0
  [ 81] add
  [ 82] setlocal 0
  [ 84] endrepeat [ 59]
  [ 86] pushcons 0 .............................. <"done">
  [ 88] pushzero ................................ <0>
  [ 89] pushzero ................................ <0>
  [ 90] pushzero ................................ <0>
  [ 91] pushzero ................................ <0>
  [ 92] pushint8 7 .............................. <7>
  [ 95] pushzero ................................ <0>
  [ 96] pushzero ................................ <0>
  [ 97] pushzero ................................ <0>
  [ 98] pushvarref 1 ............................ <meetings>
  [100] putchunk 18 ............................. put "done" into item 7 of meetings
  [102] pushcons 8 .............................. <"s_night2">
  [104] pusharglistnoret 1 ...................... <"s_night2">
  [106] extcall 13 .............................. tlkpath("s_night2")
  [108] pushcons 16 ............................. <"nights">
  [110] pusharglistnoret 1 ...................... <"nights">
  [112] extcall 14 .............................. soundspath("nights")
  [114] pushsymb 19 ............................. <#playFile>
  [116] pushint8 1 .............................. <1>
  [119] getglobal 13 ............................ <tlkpath>
  [121] pushcons 24 ............................. <"man1.aif">
  [123] joinstr ................................. <tlkpath & "man1.aif">
  [124] pusharglistnoret 3 ...................... <1, tlkpath & "man1.aif">
  [126] extcall 20 .............................. sound playFile 1, tlkpath & "man1.aif"
  [128] pushzero ................................ <0>
  [129] setglobal 22 ............................ optcounter = 0
  [131] ret
end
