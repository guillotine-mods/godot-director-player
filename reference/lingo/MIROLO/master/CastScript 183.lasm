on mouseUp
  [  0] pushsymb 19 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 13 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"hez4.aif">
  [  9] joinstr ................................. <tlkpath & "hez4.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "hez4.aif">
  [ 12] extcall 20 .............................. sound playFile 1, tlkpath & "hez4.aif"
  [ 14] pushcons 8 .............................. <"choose1c">
  [ 16] pusharglistnoret 1 ...................... <"choose1c">
  [ 18] extcall 15 .............................. go("choose1c")
  [ 20] ret
end
