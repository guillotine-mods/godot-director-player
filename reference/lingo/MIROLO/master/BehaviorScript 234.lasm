on exitFrame
  [  0] pushsymb 19 ............................. <#playFile>
  [  2] pushint8 2 .............................. <2>
  [  5] getglobal 29 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"clik2.aif">
  [  9] joinstr ................................. <effectspath & "clik2.aif">
  [ 10] pusharglistnoret 3 ...................... <2, effectspath & "clik2.aif">
  [ 12] extcall 20 .............................. sound playFile 2, effectspath & "clik2.aif"
  [ 14] ret
end
