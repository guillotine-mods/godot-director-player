on exitFrame
  [  0] pushint8 101 ............................ <101>
  [  3] pusharglist 1 ........................... <101>
  [  5] extcall 7 ............................... <sprite(101)>
  [  7] pushzero ................................ <0>
  [  8] setobjprop 46 ........................... sprite(101).visible = 0
  [ 11] ret
end
