on exitFrame
  [  0] pushint8 100 ............................ <100>
  [  3] pusharglist 1 ........................... <100>
  [  5] extcall 7 ............................... <sprite(100)>
  [  7] pushzero ................................ <0>
  [  8] setobjprop 46 ........................... sprite(100).visible = 0
  [ 11] getglobal 49 ............................ <afganicnt>
  [ 14] pushint8 1 .............................. <1>
  [ 17] add ..................................... <afganicnt + 1>
  [ 18] setglobal 49 ............................ afganicnt = afganicnt + 1
  [ 21] getglobal 49 ............................ <afganicnt>
  [ 24] pushint8 72 ............................. <72>
  [ 27] gt ...................................... <afganicnt > 72>
  [ 28] jmpifz [ 37] ............................ if afganicnt > 72 then
  [ 31] pushint8 72 ............................. <72>
  [ 34] setglobal 49 ............................ afganicnt = 72
  [ 37] ret
end
