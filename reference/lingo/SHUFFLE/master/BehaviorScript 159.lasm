on exitFrame
  [  0] pushcons 0 .............................. <"games">
  [  2] pusharglistnoret 1 ...................... <"games">
  [  4] extcall 27 .............................. soundspath("games")
  [  6] pushzero ................................ <0>
  [  7] pushcons 8 .............................. <"hatscore">
  [  9] pushzero ................................ <0>
  [ 10] put 22 .................................. put 0 into field "hatscore"
  [ 12] pushzero ................................ <0>
  [ 13] pushcons 16 ............................. <"hezscore">
  [ 15] pushzero ................................ <0>
  [ 16] put 22 .................................. put 0 into field "hezscore"
  [ 18] pushint8 2 .............................. <2>
  [ 21] pusharglist 1 ........................... <2>
  [ 23] extcall 23 .............................. <soundBusy(2)>
  [ 25] not ..................................... <not soundBusy(2)>
  [ 26] jmpifz [ 55] ............................ if not soundBusy(2) then
  [ 29] pushint8 2 .............................. <2>
  [ 32] pushint8 50 ............................. <50>
  [ 35] pushint8 1 .............................. <1>
  [ 38] set 4 ................................... set the volume of sound 2 to 50
  [ 40] pushsymb 25 ............................. <#playFile>
  [ 42] pushint8 2 .............................. <2>
  [ 45] getglobal 45 ............................ <effectspath>
  [ 48] pushcons 24 ............................. <"arcade.aif">
  [ 50] joinstr ................................. <effectspath & "arcade.aif">
  [ 51] pusharglistnoret 3 ...................... <2, effectspath & "arcade.aif">
  [ 53] extcall 26 .............................. sound playFile 2, effectspath & "arcade.aif"
  [ 55] ret
end
