on exitFrame
  [  0] pushint8 101 ............................ <101>
  [  2] pushzero ................................ <0>
  [  3] pushint8 25 ............................. <25>
  [  5] set 6 ................................... set the visible of sprite 101 to 0
  [  7] pushsymb 25 ............................. <#playFile>
  [  9] pushint8 1 .............................. <1>
  [ 11] getglobal 27 ............................ <soundspath>
  [ 13] pushcons 0 .............................. <"sflhezl.aif">
  [ 15] joinstr ................................. <soundspath & "sflhezl.aif">
  [ 16] pusharglistnoret 3 ...................... <1, soundspath & "sflhezl.aif">
  [ 18] extcall 26 .............................. sound playFile 1, soundspath & "sflhezl.aif"
  [ 20] ret
end
