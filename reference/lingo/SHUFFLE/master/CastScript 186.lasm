on mouseUp
  [  0] pushcons 0 .............................. <"days">
  [  2] pusharglistnoret 1 ...................... <"days">
  [  4] extcall 27 .............................. soundspath("days")
  [  6] pushcons 8 .............................. <"arcade">
  [  8] pushcons 16 ............................. <"hotel1.dir">
  [ 10] pusharglistnoret 2 ...................... <"arcade", "hotel1.dir">
  [ 12] extcall 2 ............................... go("arcade", "hotel1.dir")
  [ 14] pushint8 2 .............................. <2>
  [ 17] pushint8 255 ............................ <255>
  [ 20] pushint8 1 .............................. <1>
  [ 23] set 4 ................................... set the volume of sound 2 to 255
  [ 25] pushint8 30 ............................. <30>
  [ 28] pushint8 1 .............................. <1>
  [ 31] pusharglistnoret 2 ...................... <30, 1>
  [ 33] extcall 3 ............................... puppetSprite(30, 1)
  [ 35] pushint8 30 ............................. <30>
  [ 38] pusharglist 1 ........................... <30>
  [ 40] extcall 7 ............................... <sprite(30)>
  [ 42] pushint8 1 .............................. <1>
  [ 45] setobjprop 46 ........................... sprite(30).visible = 1
  [ 48] pusharglistnoret 0 ...................... <>
  [ 50] extcall 29 .............................. cursorfunk()
  [ 52] pusharglistnoret 0 ...................... <>
  [ 54] extcall 44 .............................. displayobject()
  [ 57] ret
end
