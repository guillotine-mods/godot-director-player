on exitFrame
  [  0] pushint8 100 ............................ <100>
  [  3] pusharglist 1 ........................... <100>
  [  5] extcall 7 ............................... <sprite(100)>
  [  7] pushzero ................................ <0>
  [  8] setobjprop 46 ........................... sprite(100).visible = 0
  [ 11] pushsymb 25 ............................. <#playFile>
  [ 13] pushint8 1 .............................. <1>
  [ 16] getglobal 27 ............................ <soundspath>
  [ 18] pushcons 0 .............................. <"sfl">
  [ 20] pushzero ................................ <0>
  [ 21] pushzero ................................ <0>
  [ 22] pushzero ................................ <0>
  [ 23] pushzero ................................ <0>
  [ 24] pushint8 3 .............................. <3>
  [ 27] pushzero ................................ <0>
  [ 28] pushzero ................................ <0>
  [ 29] pushzero ................................ <0>
  [ 30] getglobal 22 ............................ <foe>
  [ 32] getchunk ................................ <item 3 of foe>
  [ 33] joinstr ................................. <"sfl" & item 3 of foe>
  [ 34] pushcons 8 .............................. <"w.aif">
  [ 36] joinstr ................................. <"sfl" & item 3 of foe & "w.aif">
  [ 37] joinstr ................................. <soundspath & "sfl" & item 3 of foe & "w.aif">
  [ 38] pusharglistnoret 3 ...................... <1, soundspath & "sfl" & item 3 of foe & "w.aif">
  [ 40] extcall 26 .............................. sound playFile 1, soundspath & "sfl" & item 3 of foe & "w.aif"
  [ 42] ret
end
