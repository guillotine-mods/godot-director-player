on exitFrame
  [  0] pushsymb 3 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 2 ............................. <tlkpath>
  [  7] pushcons 0 .............................. <"pat9.aif">
  [  9] joinstr ................................. <tlkpath & "pat9.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "pat9.aif">
  [ 12] extcall 4 ............................... sound playFile 1, tlkpath & "pat9.aif"
  [ 14] ret
end
