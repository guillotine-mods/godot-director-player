on exitFrame
  [  0] pushint8 2 .............................. <2>
  [  3] setlocal 0
  [  5] getlocal 0
  [  7] pushint8 40 ............................. <40>
  [ 10] lteq
  [ 11] jmpifz [ 43] ............................ repeat with i = 2 to 40
  [ 14] getlocal 0 .............................. <i>
  [ 16] pusharglist 1 ........................... <i>
  [ 18] extcall 23 .............................. <sprite(i)>
  [ 20] pushint8 1 .............................. <1>
  [ 23] setobjprop 24 ........................... sprite(i).visible = 1
  [ 25] getlocal 0 .............................. <i>
  [ 27] pushzero ................................ <0>
  [ 28] pusharglistnoret 2 ...................... <i, 0>
  [ 30] extcall 31 .............................. puppetSprite(i, 0)
  [ 32] pushint8 1
  [ 35] getlocal 0
  [ 37] add
  [ 38] setlocal 0
  [ 40] endrepeat [  5]
  [ 43] pushcons 0 .............................. <"done">
  [ 45] pushzero ................................ <0>
  [ 46] pushzero ................................ <0>
  [ 47] pushzero ................................ <0>
  [ 48] pushzero ................................ <0>
  [ 49] pushint8 5 .............................. <5>
  [ 52] pushzero ................................ <0>
  [ 53] pushzero ................................ <0>
  [ 54] pushzero ................................ <0>
  [ 55] pushvarref 1 ............................ <meetings>
  [ 57] putchunk 18 ............................. put "done" into item 5 of meetings
  [ 59] pushcons 8 .............................. <"s_night3">
  [ 61] pusharglistnoret 1 ...................... <"s_night3">
  [ 63] extcall 2 ............................... tlkpath("s_night3")
  [ 65] pushsymb 3 .............................. <#playFile>
  [ 67] pushint8 1 .............................. <1>
  [ 70] getglobal 2 ............................. <tlkpath>
  [ 72] pushcons 16 ............................. <"hez1.aif">
  [ 74] joinstr ................................. <tlkpath & "hez1.aif">
  [ 75] pusharglistnoret 3 ...................... <1, tlkpath & "hez1.aif">
  [ 77] extcall 4 ............................... sound playFile 1, tlkpath & "hez1.aif"
  [ 79] ret
end
