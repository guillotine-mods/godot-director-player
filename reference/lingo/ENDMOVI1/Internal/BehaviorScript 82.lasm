on exitFrame
  [  0] pushint8 1 .............................. <1>
  [  3] getmovieprop 29 ......................... <the moviePath>
  [  5] pushcons 0 .............................. <"endmovi2.dir">
  [  7] joinstr ................................. <the moviePath & "endmovi2.dir">
  [  8] pusharglistnoret 2 ...................... <1, the moviePath & "endmovi2.dir">
  [ 10] extcall 8 ............................... go(1, the moviePath & "endmovi2.dir")
  [ 12] ret
end
