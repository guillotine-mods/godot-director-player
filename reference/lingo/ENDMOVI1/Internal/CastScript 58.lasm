on mouseUp
  [  0] pushsymb 3 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 2 ............................. <tlkpath>
  [  7] pushcons 0 .............................. <"hez2.aif">
  [  9] joinstr ................................. <tlkpath & "hez2.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "hez2.aif">
  [ 12] extcall 4 ............................... sound playFile 1, tlkpath & "hez2.aif"
  [ 14] pushcons 8 .............................. <"choose1a">
  [ 16] pusharglistnoret 1 ...................... <"choose1a">
  [ 18] extcall 8 ............................... go("choose1a")
  [ 20] ret
end
