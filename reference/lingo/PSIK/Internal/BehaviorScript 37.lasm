on exitFrame
  [  0] pushsymb 29 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 32 ............................ <effectspath>
  [  8] pushcons 0 .............................. <"kick.aif">
  [ 10] joinstr ................................. <effectspath & "kick.aif">
  [ 11] pusharglistnoret 3 ...................... <1, effectspath & "kick.aif">
  [ 13] extcall 30 .............................. sound playFile 1, effectspath & "kick.aif"
  [ 15] pushsymb 29 ............................. <#playFile>
  [ 17] pushint8 2 .............................. <2>
  [ 20] getglobal 28 ............................ <tlkpath>
  [ 22] pushcons 8 .............................. <"zevah.aif">
  [ 24] joinstr ................................. <tlkpath & "zevah.aif">
  [ 25] pusharglistnoret 3 ...................... <2, tlkpath & "zevah.aif">
  [ 27] extcall 30 .............................. sound playFile 2, tlkpath & "zevah.aif"
  [ 29] ret
end
