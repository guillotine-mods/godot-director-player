on mouseUp
  [  0] pushsymb 29 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 31 ............................ <soundspath>
  [  7] pushcons 0 .............................. <"zev11.aif">
  [  9] joinstr ................................. <soundspath & "zev11.aif">
  [ 10] pusharglistnoret 3 ...................... <1, soundspath & "zev11.aif">
  [ 12] extcall 30 .............................. sound playFile 1, soundspath & "zev11.aif"
  [ 14] pushcons 8 .............................. <"choose1b">
  [ 16] pusharglistnoret 1 ...................... <"choose1b">
  [ 18] extcall 18 .............................. go("choose1b")
  [ 20] ret
end
