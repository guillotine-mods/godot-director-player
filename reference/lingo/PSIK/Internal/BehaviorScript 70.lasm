on exitFrame
  [  0] pushsymb 29 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 32 ............................ <effectspath>
  [  8] pushcons 0 .............................. <"splsh1.aif">
  [ 10] joinstr ................................. <effectspath & "splsh1.aif">
  [ 11] pusharglistnoret 3 ...................... <1, effectspath & "splsh1.aif">
  [ 13] extcall 30 .............................. sound playFile 1, effectspath & "splsh1.aif"
  [ 15] ret
end
