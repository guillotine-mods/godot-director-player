on exitFrame
  [  0] pushsymb 29 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 31 ............................ <soundspath>
  [  7] pushcons 0 .............................. <"zev6.aif">
  [  9] joinstr ................................. <soundspath & "zev6.aif">
  [ 10] pusharglistnoret 3 ...................... <1, soundspath & "zev6.aif">
  [ 12] extcall 30 .............................. sound playFile 1, soundspath & "zev6.aif"
  [ 14] ret
end
