on exitFrame
  [  0] getglobal 17 ............................ <optcount>
  [  2] pushint8 1 .............................. <1>
  [  5] add ..................................... <optcount + 1>
  [  6] setglobal 17 ............................ optcount = optcount + 1
  [  8] getglobal 17 ............................ <optcount>
  [ 10] pushint8 1 .............................. <1>
  [ 13] gt ...................................... <optcount > 1>
  [ 14] jmpifz [ 26] ............................ if optcount > 1 then / else
  [ 17] pushcons 0 .............................. <"conect1">
  [ 19] pusharglistnoret 1 ...................... <"conect1">
  [ 21] extcall 15 .............................. go("conect1")
  [ 23] jmp [ 32]
  [ 26] pushcons 8 .............................. <"choose1">
  [ 28] pusharglistnoret 1 ...................... <"choose1">
  [ 30] extcall 15 .............................. go("choose1")
  [ 32] ret
end
