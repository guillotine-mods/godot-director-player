on exitFrame
  [  0] pushsymb 15 ............................. <#playFile>
  [  2] pushint8 3 .............................. <3>
  [  5] getglobal 20 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"kick.aif">
  [  9] joinstr ................................. <effectspath & "kick.aif">
  [ 10] pusharglistnoret 3 ...................... <3, effectspath & "kick.aif">
  [ 12] extcall 16 .............................. sound playFile 3, effectspath & "kick.aif"
  [ 14] ret
end
