on mouseUp
  [  0] pushsymb 15 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 13 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"hez26.aif">
  [  9] joinstr ................................. <tlkpath & "hez26.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "hez26.aif">
  [ 12] extcall 16 .............................. sound playFile 1, tlkpath & "hez26.aif"
  [ 14] pushcons 8 .............................. <"choose1bc">
  [ 16] pusharglistnoret 1 ...................... <"choose1bc">
  [ 18] extcall 19 .............................. go("choose1bc")
  [ 20] ret
end
