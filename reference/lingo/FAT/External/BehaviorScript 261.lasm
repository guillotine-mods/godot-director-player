on exitFrame
  [  0] pushsymb 1 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 3 ............................. <tlkpath>
  [  7] pushcons 0 .............................. <"hez46b.aif">
  [  9] joinstr ................................. <tlkpath & "hez46b.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "hez46b.aif">
  [ 12] extcall 2 ............................... sound playFile 1, tlkpath & "hez46b.aif"
  [ 14] ret
end
