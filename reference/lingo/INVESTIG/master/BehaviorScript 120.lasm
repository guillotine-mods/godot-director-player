on exitFrame
  [  0] pushsymb 18 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 17 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"online.aif">
  [  9] joinstr ................................. <effectspath & "online.aif">
  [ 10] pusharglistnoret 3 ...................... <1, effectspath & "online.aif">
  [ 12] extcall 19 .............................. sound playFile 1, effectspath & "online.aif"
  [ 14] ret
end
