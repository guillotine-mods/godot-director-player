on exitFrame
  [  0] pushsymb 26 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 32 ............................ <tlkpath>
  [  8] pushcons 0 .............................. <"man7.aif">
  [ 10] joinstr ................................. <tlkpath & "man7.aif">
  [ 11] pusharglistnoret 3 ...................... <1, tlkpath & "man7.aif">
  [ 13] extcall 27 .............................. sound playFile 1, tlkpath & "man7.aif"
  [ 15] ret
end
