on enterFrame
  [  0] pushint8 1 .............................. <1>
  [  3] setlocal 0
  [  5] getlocal 0
  [  7] pushint8 40 ............................. <40>
  [ 10] lteq
  [ 11] jmpifz [ 35] ............................ repeat with i = 1 to 40
  [ 14] getlocal 0 .............................. <i>
  [ 16] pusharglist 1 ........................... <i>
  [ 18] extcall 8 ............................... <sprite(i)>
  [ 20] pushint8 1 .............................. <1>
  [ 23] setobjprop 9 ............................ sprite(i).visible = 1
  [ 25] pushint8 1
  [ 28] getlocal 0
  [ 30] add
  [ 31] setlocal 0
  [ 33] endrepeat [  5]
  [ 35] pushsymb 5 .............................. <#playFile>
  [ 37] pushint8 2 .............................. <2>
  [ 40] getglobal 6 ............................. <effectspath>
  [ 42] pushcons 0 .............................. <"rocks.aif">
  [ 44] joinstr ................................. <effectspath & "rocks.aif">
  [ 45] pusharglistnoret 3 ...................... <2, effectspath & "rocks.aif">
  [ 47] extcall 4 ............................... sound playFile 2, effectspath & "rocks.aif"
  [ 49] ret
end
