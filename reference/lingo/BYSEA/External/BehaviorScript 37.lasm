on exitFrame
  [  0] pushsymb 5 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 11 ............................ <soundspath>
  [  7] pushcons 0 .............................. <"dubimony.aif">
  [  9] joinstr ................................. <soundspath & "dubimony.aif">
  [ 10] pusharglistnoret 3 ...................... <1, soundspath & "dubimony.aif">
  [ 12] extcall 4 ............................... sound playFile 1, soundspath & "dubimony.aif"
  [ 14] ret
end
