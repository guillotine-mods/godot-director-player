on exitFrame
  [  0] pushsymb 5 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 6 ............................. <effectspath>
  [  7] pushcons 0 .............................. <"splsh1.aif">
  [  9] joinstr ................................. <effectspath & "splsh1.aif">
  [ 10] pusharglistnoret 3 ...................... <1, effectspath & "splsh1.aif">
  [ 12] extcall 4 ............................... sound playFile 1, effectspath & "splsh1.aif"
  [ 14] ret
end
