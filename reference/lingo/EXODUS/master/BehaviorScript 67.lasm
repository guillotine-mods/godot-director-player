on exitFrame
  [  0] pushint8 7 .............................. <7>
  [  3] setglobal 32 ............................ newsyz = 7
  [  6] pushint8 7 .............................. <7>
  [  9] setglobal 33 ............................ syz = 7
  [ 12] pushint8 2 .............................. <2>
  [ 15] pushint8 255 ............................ <255>
  [ 18] pushint8 1 .............................. <1>
  [ 21] set 4 ................................... set the volume of sound 2 to 255
  [ 23] pushint8 1 .............................. <1>
  [ 26] pushcons 0 .............................. <"day1.dir">
  [ 28] pusharglistnoret 2 ...................... <1, "day1.dir">
  [ 30] extcall 30 .............................. go(1, "day1.dir")
  [ 32] pushint8 30 ............................. <30>
  [ 35] pushint8 1 .............................. <1>
  [ 38] pusharglistnoret 2 ...................... <30, 1>
  [ 40] extcall 34 .............................. puppetSprite(30, 1)
  [ 43] pushint8 30 ............................. <30>
  [ 46] pushcons 8 .............................. <"standleft7">
  [ 48] pushzero ................................ <0>
  [ 49] pushint8 10 ............................. <10>
  [ 52] get 9 ................................... <the number of member "standleft7">
  [ 54] pushint8 35 ............................. <35>
  [ 57] set 6 ................................... set the memberNum of sprite 30 to the number of member "standleft7"
  [ 59] pusharglistnoret 0 ...................... <>
  [ 61] extcall 8 ............................... updateStage()
  [ 63] pushint8 30 ............................. <30>
  [ 66] pusharglist 1 ........................... <30>
  [ 68] extcall 35 .............................. <sprite(30)>
  [ 71] pushint8 1 .............................. <1>
  [ 74] setobjprop 36 ........................... sprite(30).visible = 1
  [ 77] pusharglistnoret 0 ...................... <>
  [ 79] extcall 37 .............................. displayobject()
  [ 82] pusharglistnoret 0 ...................... <>
  [ 84] extcall 38 .............................. cursorfunk()
  [ 87] ret
end
