on exitFrame
  [  0] pushint8 2 .............................. <2>
  [  3] pusharglist 1 ........................... <2>
  [  5] extcall 28 .............................. <soundBusy(2)>
  [  7] not ..................................... <not soundBusy(2)>
  [  8] jmpifz [ 25] ............................ if not soundBusy(2) then
  [ 11] pushsymb 21 ............................. <#playFile>
  [ 13] pushint8 2 .............................. <2>
  [ 16] getglobal 24 ............................ <effectspath>
  [ 18] pushcons 0 .............................. <"sea.aif">
  [ 20] joinstr ................................. <effectspath & "sea.aif">
  [ 21] pusharglistnoret 3 ...................... <2, effectspath & "sea.aif">
  [ 23] extcall 22 .............................. sound playFile 2, effectspath & "sea.aif"
  [ 25] ret
end
