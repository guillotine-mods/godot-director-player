on exitFrame
  [  0] pushsymb 21 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 23 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"hez2.aif">
  [  9] joinstr ................................. <tlkpath & "hez2.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "hez2.aif">
  [ 12] extcall 22 .............................. sound playFile 1, tlkpath & "hez2.aif"
  [ 14] pushint8 2 .............................. <2>
  [ 17] pushint8 170 ............................ <170>
  [ 20] pushint8 1 .............................. <1>
  [ 23] set 4 ................................... set the volume of sound 2 to 170
  [ 25] ret
end
