on exitFrame
  [  0] pushsymb 21 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 23 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"hez11.aif">
  [  9] joinstr ................................. <tlkpath & "hez11.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "hez11.aif">
  [ 12] extcall 22 .............................. sound playFile 1, tlkpath & "hez11.aif"
  [ 14] ret
end
