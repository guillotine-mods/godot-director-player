on exitFrame
  [  0] pushsymb 21 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 24 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"eyes.aif">
  [  9] joinstr ................................. <effectspath & "eyes.aif">
  [ 10] pusharglistnoret 3 ...................... <1, effectspath & "eyes.aif">
  [ 12] extcall 22 .............................. sound playFile 1, effectspath & "eyes.aif"
  [ 14] ret
end
