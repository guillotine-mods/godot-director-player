on mouseUp
  [  0] pushsymb 13 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 15 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"hez33.aif">
  [  9] joinstr ................................. <tlkpath & "hez33.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "hez33.aif">
  [ 12] extcall 14 .............................. sound playFile 1, tlkpath & "hez33.aif"
  [ 14] pushcons 8 .............................. <"choose1c">
  [ 16] pusharglistnoret 1 ...................... <"choose1c">
  [ 18] extcall 20 .............................. go("choose1c")
  [ 20] ret
end
