on exitFrame
  [  0] pushsymb 13 ............................. <#playFile>
  [  2] pushint8 2 .............................. <2>
  [  5] getglobal 18 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"drama.aif">
  [  9] joinstr ................................. <effectspath & "drama.aif">
  [ 10] pusharglistnoret 3 ...................... <2, effectspath & "drama.aif">
  [ 12] extcall 14 .............................. sound playFile 2, effectspath & "drama.aif"
  [ 14] ret
end
