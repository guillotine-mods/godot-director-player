on exitFrame
  [  0] getglobal 17 ............................ <optcount>
  [  2] pushint8 1 .............................. <1>
  [  5] add ..................................... <optcount + 1>
  [  6] setglobal 17 ............................ optcount = optcount + 1
  [  8] getglobal 17 ............................ <optcount>
  [ 10] pushint8 3 .............................. <3>
  [ 13] lt ...................................... <optcount < 3>
  [ 14] jmpifz [ 26] ............................ if optcount < 3 then / else
  [ 17] pushcons 0 .............................. <"choose2">
  [ 19] pusharglistnoret 1 ...................... <"choose2">
  [ 21] extcall 15 .............................. go("choose2")
  [ 23] jmp [ 35]
  [ 26] pushcons 8 .............................. <"conect2">
  [ 28] pusharglistnoret 1 ...................... <"conect2">
  [ 30] extcall 15 .............................. go("conect2")
  [ 32] pushzero ................................ <0>
  [ 33] setglobal 17 ............................ optcount = 0
  [ 35] ret
end
