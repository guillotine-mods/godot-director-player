on exitFrame
  [  0] pushsymb 12 ............................. <#playFile>
  [  2] pushint8 2 .............................. <2>
  [  5] getglobal 18 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"bell.aif">
  [  9] joinstr ................................. <effectspath & "bell.aif">
  [ 10] pusharglistnoret 3 ...................... <2, effectspath & "bell.aif">
  [ 12] extcall 13 .............................. sound playFile 2, effectspath & "bell.aif"
  [ 14] ret
end
