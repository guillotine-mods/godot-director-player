on exitFrame
  [  0] pushint8 2 .............................. <2>
  [  3] setlocal 0
  [  5] getlocal 0
  [  7] pushint8 40 ............................. <40>
  [ 10] lteq
  [ 11] jmpifz [ 43] ............................ repeat with i = 2 to 40
  [ 14] getlocal 0 .............................. <i>
  [ 16] pusharglist 1 ........................... <i>
  [ 18] extcall 30 .............................. <sprite(i)>
  [ 20] pushint8 1 .............................. <1>
  [ 23] setobjprop 31 ........................... sprite(i).visible = 1
  [ 25] getlocal 0 .............................. <i>
  [ 27] pushzero ................................ <0>
  [ 28] pusharglistnoret 2 ...................... <i, 0>
  [ 30] extcall 28 .............................. puppetSprite(i, 0)
  [ 32] pushint8 1
  [ 35] getlocal 0
  [ 37] add
  [ 38] setlocal 0
  [ 40] endrepeat [  5]
  [ 43] pushint8 100 ............................ <100>
  [ 46] setlocal 0
  [ 48] getlocal 0
  [ 50] pushint8 110 ............................ <110>
  [ 53] lteq
  [ 54] jmpifz [ 74] ............................ repeat with i = 100 to 110
  [ 57] getlocal 0 .............................. <i>
  [ 59] pushzero ................................ <0>
  [ 60] pusharglistnoret 2 ...................... <i, 0>
  [ 62] extcall 28 .............................. puppetSprite(i, 0)
  [ 64] pushint8 1
  [ 67] getlocal 0
  [ 69] add
  [ 70] setlocal 0
  [ 72] endrepeat [ 48]
  [ 74] ret
end
