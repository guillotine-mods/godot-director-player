on exitFrame
  [  0] pushzero ................................ <0>
  [  1] setglobal 17 ............................ optcount = 0
  [  3] pushsymb 12 ............................. <#playFile>
  [  5] pushint8 1 .............................. <1>
  [  8] getglobal 18 ............................ <effectspath>
  [ 10] pushcons 0 .............................. <"bell.aif">
  [ 12] joinstr ................................. <effectspath & "bell.aif">
  [ 13] pusharglistnoret 3 ...................... <1, effectspath & "bell.aif">
  [ 15] extcall 13 .............................. sound playFile 1, effectspath & "bell.aif"
  [ 17] ret
end
