on exitFrame
  [  0] pushsymb 12 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 14 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"esh10b.aif">
  [  9] joinstr ................................. <tlkpath & "esh10b.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "esh10b.aif">
  [ 12] extcall 13 .............................. sound playFile 1, tlkpath & "esh10b.aif"
  [ 14] ret
end
