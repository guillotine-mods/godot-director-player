on mouseUp
  [  0] pushsymb 12 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 14 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"hez43.aif">
  [  9] joinstr ................................. <tlkpath & "hez43.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "hez43.aif">
  [ 12] extcall 13 .............................. sound playFile 1, tlkpath & "hez43.aif"
  [ 14] pushcons 8 .............................. <"choose1abc">
  [ 16] pusharglistnoret 1 ...................... <"choose1abc">
  [ 18] extcall 15 .............................. go("choose1abc")
  [ 20] ret
end
