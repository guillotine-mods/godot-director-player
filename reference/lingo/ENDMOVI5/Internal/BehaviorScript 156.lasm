on exitFrame
  [  0] pushsymb 14 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 16 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"hez103.aif">
  [  9] joinstr ................................. <tlkpath & "hez103.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "hez103.aif">
  [ 12] extcall 15 .............................. sound playFile 1, tlkpath & "hez103.aif"
  [ 14] ret
end
