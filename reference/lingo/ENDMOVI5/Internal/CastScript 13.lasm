on mouseUp
  [  0] pushsymb 14 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 16 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"hez117.aif">
  [  9] joinstr ................................. <tlkpath & "hez117.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "hez117.aif">
  [ 12] extcall 15 .............................. sound playFile 1, tlkpath & "hez117.aif"
  [ 14] pushcons 8 .............................. <"choose1a">
  [ 16] pusharglistnoret 1 ...................... <"choose1a">
  [ 18] extcall 12 .............................. go("choose1a")
  [ 20] ret
end
