on mouseUp
  [  0] pushsymb 2 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 4 ............................. <tlkpath>
  [  7] pushcons 0 .............................. <"hez36.aif">
  [  9] joinstr ................................. <tlkpath & "hez36.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "hez36.aif">
  [ 12] extcall 3 ............................... sound playFile 1, tlkpath & "hez36.aif"
  [ 14] pushcons 8 .............................. <"choose1b">
  [ 16] pusharglistnoret 1 ...................... <"choose1b">
  [ 18] extcall 7 ............................... go("choose1b")
  [ 20] ret
end
