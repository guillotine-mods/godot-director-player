on exitFrame
  [  0] pushsymb 2 .............................. <#playFile>
  [  2] pushint8 2 .............................. <2>
  [  5] getglobal 4 ............................. <tlkpath>
  [  7] pushcons 0 .............................. <"pat33.aif">
  [  9] joinstr ................................. <tlkpath & "pat33.aif">
  [ 10] pusharglistnoret 3 ...................... <2, tlkpath & "pat33.aif">
  [ 12] extcall 3 ............................... sound playFile 2, tlkpath & "pat33.aif"
  [ 14] pushsymb 2 .............................. <#playFile>
  [ 16] pushint8 1 .............................. <1>
  [ 19] getglobal 4 ............................. <tlkpath>
  [ 21] pushcons 8 .............................. <"rin9.aif">
  [ 23] joinstr ................................. <tlkpath & "rin9.aif">
  [ 24] pusharglistnoret 3 ...................... <1, tlkpath & "rin9.aif">
  [ 26] extcall 3 ............................... sound playFile 1, tlkpath & "rin9.aif"
  [ 28] ret
end
