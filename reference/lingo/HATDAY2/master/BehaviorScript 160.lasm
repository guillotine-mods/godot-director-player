on exitFrame
  [  0] pushsymb 2 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 4 ............................. <tlkpath>
  [  7] pushcons 0 .............................. <"hat38.aif">
  [  9] joinstr ................................. <tlkpath & "hat38.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "hat38.aif">
  [ 12] extcall 3 ............................... sound playFile 1, tlkpath & "hat38.aif"
  [ 14] ret
end
