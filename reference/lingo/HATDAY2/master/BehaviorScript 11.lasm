on exitFrame
  [  0] pushzero ................................ <0>
  [  1] setglobal 1 ............................. optcount = 0
  [  3] pushsymb 2 .............................. <#playFile>
  [  5] pushint8 1 .............................. <1>
  [  8] getglobal 4 ............................. <tlkpath>
  [ 10] pushcons 0 .............................. <"hat31.aif">
  [ 12] joinstr ................................. <tlkpath & "hat31.aif">
  [ 13] pusharglistnoret 3 ...................... <1, tlkpath & "hat31.aif">
  [ 15] extcall 3 ............................... sound playFile 1, tlkpath & "hat31.aif"
  [ 17] pushint8 18 ............................. <18>
  [ 20] pusharglist 1 ........................... <18>
  [ 22] extcall 28 .............................. <sprite(18)>
  [ 24] pushint8 1 .............................. <1>
  [ 27] setobjprop 29 ........................... sprite(18).visible = 1
  [ 29] pushint8 19 ............................. <19>
  [ 32] pusharglist 1 ........................... <19>
  [ 34] extcall 28 .............................. <sprite(19)>
  [ 36] pushint8 1 .............................. <1>
  [ 39] setobjprop 29 ........................... sprite(19).visible = 1
  [ 41] pushint8 36 ............................. <36>
  [ 44] pusharglist 1 ........................... <36>
  [ 46] extcall 28 .............................. <sprite(36)>
  [ 48] pushint8 1 .............................. <1>
  [ 51] setobjprop 29 ........................... sprite(36).visible = 1
  [ 53] pushint8 37 ............................. <37>
  [ 56] pusharglist 1 ........................... <37>
  [ 58] extcall 28 .............................. <sprite(37)>
  [ 60] pushint8 1 .............................. <1>
  [ 63] setobjprop 29 ........................... sprite(37).visible = 1
  [ 65] ret
end
