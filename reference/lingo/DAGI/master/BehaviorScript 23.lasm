on exitFrame
  [  0] pushsymb 27 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 26 ............................ <soundspath>
  [  7] pushcons 0 .............................. <"dag10.aif">
  [  9] joinstr ................................. <soundspath & "dag10.aif">
  [ 10] pusharglistnoret 3 ...................... <1, soundspath & "dag10.aif">
  [ 12] extcall 28 .............................. sound playFile 1, soundspath & "dag10.aif"
  [ 14] ret
end
