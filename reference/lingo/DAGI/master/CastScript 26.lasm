on mouseUp
  [  0] pushsymb 27 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 26 ............................ <soundspath>
  [  7] pushcons 0 .............................. <"dag9.aif">
  [  9] joinstr ................................. <soundspath & "dag9.aif">
  [ 10] pusharglistnoret 3 ...................... <1, soundspath & "dag9.aif">
  [ 12] extcall 28 .............................. sound playFile 1, soundspath & "dag9.aif"
  [ 14] pushcons 8 .............................. <"choose1c">
  [ 16] pusharglistnoret 1 ...................... <"choose1c">
  [ 18] extcall 7 ............................... go("choose1c")
  [ 20] ret
end
