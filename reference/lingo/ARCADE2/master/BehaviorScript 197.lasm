on exitFrame
  [  0] pushint8 8 .............................. <8>
  [  2] setlocal 0
  [  4] getlocal 0
  [  6] pushint8 30 ............................. <30>
  [  8] lteq
  [  9] jmpifz [ 29] ............................ repeat with i = 8 to 30
  [ 12] getlocal 0 .............................. <i>
  [ 14] pushint8 1 .............................. <1>
  [ 16] pushint8 25 ............................. <25>
  [ 18] set 6 ................................... set the visible of sprite i to 1
  [ 20] pushint8 1
  [ 22] getlocal 0
  [ 24] add
  [ 25] setlocal 0
  [ 27] endrepeat [  4]
  [ 29] pushint8 7 .............................. <7>
  [ 31] pushzero ................................ <0>
  [ 32] pusharglistnoret 2 ...................... <7, 0>
  [ 34] extcall 6 ............................... puppetSprite(7, 0)
  [ 36] ret
end
