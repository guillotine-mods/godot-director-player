on exitFrame
  [  0] pushcons 0 .............................. <"0">
  [  2] pushcons 8 .............................. <"score">
  [  4] pushzero ................................ <0>
  [  5] put 22 .................................. put "0" into field "score"
  [  7] pushint8 100 ............................ <100>
  [ 10] setlocal 0
  [ 12] getlocal 0
  [ 14] pushint8 109 ............................ <109>
  [ 17] lteq
  [ 18] jmpifz [ 43] ............................ repeat with i = 100 to 109
  [ 21] getlocal 0 .............................. <i>
  [ 23] pusharglist 1 ........................... <i>
  [ 25] extcall 24 .............................. <sprite(i)>
  [ 27] pushint8 1 .............................. <1>
  [ 30] setobjprop 39 ........................... sprite(i).visible = 1
  [ 33] pushint8 1
  [ 36] getlocal 0
  [ 38] add
  [ 39] setlocal 0
  [ 41] endrepeat [ 12]
  [ 43] pushcons 16 ............................. <EMPTY>
  [ 45] pushint8 3 .............................. <3>
  [ 48] set 0 ................................... set the keyDownScript to EMPTY
  [ 50] pushint8 94 ............................. <94>
  [ 53] pusharglist 1 ........................... <94>
  [ 55] extcall 24 .............................. <sprite(94)>
  [ 57] pushint8 1 .............................. <1>
  [ 60] setobjprop 39 ........................... sprite(94).visible = 1
  [ 63] pushint8 95 ............................. <95>
  [ 66] pusharglist 1 ........................... <95>
  [ 68] extcall 24 .............................. <sprite(95)>
  [ 70] pushint8 1 .............................. <1>
  [ 73] setobjprop 39 ........................... sprite(95).visible = 1
  [ 76] pushint8 96 ............................. <96>
  [ 79] pusharglist 1 ........................... <96>
  [ 81] extcall 24 .............................. <sprite(96)>
  [ 83] pushint8 1 .............................. <1>
  [ 86] setobjprop 39 ........................... sprite(96).visible = 1
  [ 89] pushint8 106 ............................ <106>
  [ 92] pusharglist 1 ........................... <106>
  [ 94] extcall 24 .............................. <sprite(106)>
  [ 96] pushint8 1 .............................. <1>
  [ 99] setobjprop 39 ........................... sprite(106).visible = 1
  [102] pushint8 2 .............................. <2>
  [105] pushint8 75 ............................. <75>
  [108] pushint8 1 .............................. <1>
  [111] set 4 ................................... set the volume of sound 2 to 75
  [113] pushcons 24 ............................. <"games">
  [115] pusharglistnoret 1 ...................... <"games">
  [117] extcall 15 .............................. soundspath("games")
  [119] ret
end
