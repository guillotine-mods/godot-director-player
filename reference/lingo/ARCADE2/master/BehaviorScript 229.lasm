on exitFrame
  [  0] pushsymb 10 ............................. <#playFile>
  [  2] pushint8 3 .............................. <3>
  [  5] getglobal 12 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"gunright.aif">
  [  9] joinstr ................................. <effectspath & "gunright.aif">
  [ 10] pusharglistnoret 3 ...................... <3, effectspath & "gunright.aif">
  [ 12] extcall 11 .............................. sound playFile 3, effectspath & "gunright.aif"
  [ 14] ret
end
