  [115] extcall 6 ............................... puppetSprite(7, 0)
  [117] pushcons 0 .............................. <"end4">
  [119] pusharglistnoret 1 ...................... <"end4">
  [121] extcall 2 ............................... go("end4")
  [123] jmp [132]
  [126] pushcons 8 .............................. <"end4">
  [128] pusharglistnoret 1 ...................... <"end4">
  [130] extcall 2 ............................... go("end4")
  [132] ret
end
