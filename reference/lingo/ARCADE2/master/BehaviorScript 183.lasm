on exitFrame
  [  0] pushzero ................................ <0>
  [  1] setlocal 0 .............................. x = 0
  [  3] pushint8 8 .............................. <8>
  [  6] setlocal 8
  [  8] getlocal 8
  [ 10] pushint8 18 ............................. <18>
  [ 13] lteq
  [ 14] jmpifz [ 64] ............................ repeat with i = 8 to 18
  [ 17] getlocal 8 .............................. <i>
  [ 19] pusharglist 1 ........................... <i>
  [ 21] extcall 24 .............................. <sprite(i)>
  [ 23] getobjprop 39 ........................... <sprite(i).visible>
  [ 26] pushzero ................................ <0>
  [ 27] eq ...................................... <sprite(i).visible = 0>
  [ 28] jmpifz [ 53] ............................ if sprite(i).visible = 0 then
  [ 31] pushint8 1 .............................. <1>
  [ 34] getlocal 0 .............................. <x>
  [ 36] add ..................................... <1 + x>
  [ 37] setlocal 0 .............................. x = 1 + x
  [ 39] getlocal 8 .............................. <i>
  [ 41] pushint8 15 ............................. <15>
  [ 44] add ..................................... <i + 15>
  [ 45] pusharglist 1 ........................... <i + 15>
  [ 47] extcall 24 .............................. <sprite(i + 15)>
  [ 49] pushzero ................................ <0>
  [ 50] setobjprop 39 ........................... sprite(i + 15).visible = 0
  [ 53] pushint8 1
  [ 56] getlocal 8
  [ 58] add
  [ 59] setlocal 8
  [ 61] endrepeat [  8]
  [ 64] getlocal 0 .............................. <x>
  [ 66] pushint8 10 ............................. <10>
  [ 69] gt ...................................... <x > 10>
  [ 70] jmpifz [126] ............................ if x > 10 then / else
  [ 73] pushint8 8 .............................. <8>
  [ 76] setlocal 8
  [ 78] getlocal 8
  [ 80] pushint8 33 ............................. <33>
  [ 83] lteq
  [ 84] jmpifz [109] ............................ repeat with i = 8 to 33
  [ 87] getlocal 8 .............................. <i>
  [ 89] pusharglist 1 ........................... <i>
  [ 91] extcall 24 .............................. <sprite(i)>
  [ 93] pushint8 1 .............................. <1>
