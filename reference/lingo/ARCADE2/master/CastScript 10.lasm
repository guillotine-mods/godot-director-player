on mouseUp
  [  0] pushcons 0 .............................. <"days">
  [  2] pusharglistnoret 1 ...................... <"days">
  [  4] extcall 15 .............................. soundspath("days")
  [  6] pushint8 2 .............................. <2>
  [  9] pushint8 255 ............................ <255>
  [ 12] pushint8 1 .............................. <1>
  [ 15] set 4 ................................... set the volume of sound 2 to 255
  [ 17] pushcons 8 .............................. <"arcade">
  [ 19] pushcons 16 ............................. <"hotel1.dir">
  [ 21] pusharglistnoret 2 ...................... <"arcade", "hotel1.dir">
  [ 23] extcall 2 ............................... go("arcade", "hotel1.dir")
  [ 25] pushint8 30 ............................. <30>
  [ 28] pushint8 1 .............................. <1>
  [ 31] pusharglistnoret 2 ...................... <30, 1>
  [ 33] extcall 6 ............................... puppetSprite(30, 1)
  [ 35] pushint8 30 ............................. <30>
  [ 38] pushcons 24 ............................. <"standright5">
  [ 40] pushzero ................................ <0>
  [ 41] pushint8 10 ............................. <10>
  [ 44] get 9 ................................... <the number of member "standright5">
  [ 46] pushint8 35 ............................. <35>
  [ 49] set 6 ................................... set the memberNum of sprite 30 to the number of member "standright5"
  [ 51] pushint8 30 ............................. <30>
  [ 54] pusharglist 1 ........................... <30>
  [ 56] extcall 24 .............................. <sprite(30)>
  [ 58] pushint8 1 .............................. <1>
  [ 61] setobjprop 39 ........................... sprite(30).visible = 1
  [ 64] pusharglistnoret 0 ...................... <>
  [ 66] extcall 5 ............................... cursorfunk()
  [ 68] pusharglistnoret 0 ...................... <>
  [ 70] extcall 38 .............................. displayobject()
  [ 73] ret
end
