on exitFrame
  [  0] pushsymb 10 ............................. <#playFile>
  [  2] pushint8 2 .............................. <2>
  [  5] getglobal 12 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"splsh1.aif">
  [  9] joinstr ................................. <effectspath & "splsh1.aif">
  [ 10] pusharglistnoret 3 ...................... <2, effectspath & "splsh1.aif">
  [ 12] extcall 11 .............................. sound playFile 2, effectspath & "splsh1.aif"
  [ 14] ret
end
