on exitFrame
  [  0] pushsymb 10 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 15 ............................ <soundspath>
  [  7] pushcons 0 .............................. <"zigend61.aif">
  [  9] joinstr ................................. <soundspath & "zigend61.aif">
  [ 10] pusharglistnoret 3 ...................... <1, soundspath & "zigend61.aif">
  [ 12] extcall 11 .............................. sound playFile 1, soundspath & "zigend61.aif"
  [ 14] ret
end
