on exitFrame
  [  0] pushsymb 10 ............................. <#playFile>
  [  2] pushint8 3 .............................. <3>
  [  5] getglobal 15 ............................ <soundspath>
  [  7] pushcons 0 .............................. <"gunshot.aif">
  [  9] joinstr ................................. <soundspath & "gunshot.aif">
  [ 10] pusharglistnoret 3 ...................... <3, soundspath & "gunshot.aif">
  [ 12] extcall 11 .............................. sound playFile 3, soundspath & "gunshot.aif"
  [ 14] ret
end
