on exitFrame
  [  0] pushcons 0 .............................. <"zigiscript">
  [  2] pushint8 3 .............................. <3>
  [  4] set 0 ................................... set the keyDownScript to "zigiscript"
  [  6] pushint8 5 .............................. <5>
  [  8] pushzero ................................ <0>
  [  9] pushint8 25 ............................. <25>
  [ 11] set 6 ................................... set the visible of sprite 5 to 0
  [ 13] pushint8 6 .............................. <6>
  [ 15] pushzero ................................ <0>
  [ 16] pushint8 25 ............................. <25>
  [ 18] set 6 ................................... set the visible of sprite 6 to 0
  [ 20] pushint8 8 .............................. <8>
  [ 22] setlocal 0
  [ 24] getlocal 0
  [ 26] pushint8 30 ............................. <30>
  [ 28] lteq
  [ 29] jmpifz [ 49] ............................ repeat with i = 8 to 30
  [ 32] getlocal 0 .............................. <i>
  [ 34] pushint8 1 .............................. <1>
  [ 36] pushint8 25 ............................. <25>
  [ 38] set 6 ................................... set the visible of sprite i to 1
  [ 40] pushint8 1
  [ 42] getlocal 0
  [ 44] add
  [ 45] setlocal 0
  [ 47] endrepeat [ 24]
  [ 49] pushint8 23 ............................. <23>
  [ 51] setlocal 0
  [ 53] getlocal 0
  [ 55] pushint8 29 ............................. <29>
  [ 57] lteq
  [ 58] jmpifz [ 77] ............................ repeat with i = 23 to 29
  [ 61] getlocal 0 .............................. <i>
  [ 63] pushzero ................................ <0>
  [ 64] pushint8 25 ............................. <25>
  [ 66] set 6 ................................... set the visible of sprite i to 0
  [ 68] pushint8 1
  [ 70] getlocal 0
  [ 72] add
  [ 73] setlocal 0
  [ 75] endrepeat [ 53]
  [ 77] pushint8 40 ............................. <40>
  [ 79] pushint8 1 .............................. <1>
  [ 81] pusharglistnoret 2 ...................... <40, 1>
  [ 83] extcall 6 ............................... puppetSprite(40, 1)
  [ 85] ret
end
