on exitFrame
  [  0] pushsymb 10 ............................. <#playFile>
  [  2] pushint8 2 .............................. <2>
  [  5] getglobal 12 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"action.aif">
  [  9] joinstr ................................. <effectspath & "action.aif">
  [ 10] pusharglistnoret 3 ...................... <2, effectspath & "action.aif">
  [ 12] extcall 11 .............................. sound playFile 2, effectspath & "action.aif"
  [ 14] pushcons 8 .............................. <"score">
  [ 16] pushzero ................................ <0>
  [ 17] pushint8 2 .............................. <2>
  [ 20] get 11 .................................. <the text of field "score">
  [ 22] pusharglist 1 ........................... <the text of field "score">
  [ 24] extcall 14 .............................. <value(the text of field "score")>
  [ 26] pushint8 1 .............................. <1>
  [ 29] add ..................................... <value(the text of field "score") + 1>
  [ 30] pushcons 16 ............................. <"score">
  [ 32] pushzero ................................ <0>
  [ 33] put 22 .................................. put value(the text of field "score") + 1 into field "score"
  [ 35] pushint8 40 ............................. <40>
  [ 38] pushcons 24 ............................. <"zigi">
  [ 40] pushcons 32 ............................. <"score">
  [ 42] pushzero ................................ <0>
  [ 43] pushint8 2 .............................. <2>
  [ 46] get 11 .................................. <the text of field "score">
  [ 48] pusharglist 1 ........................... <the text of field "score">
  [ 50] extcall 14 .............................. <value(the text of field "score")>
  [ 52] joinstr ................................. <"zigi" & value(the text of field "score")>
  [ 53] pushzero ................................ <0>
  [ 54] pushint8 10 ............................. <10>
  [ 57] get 9 ................................... <the number of member ("zigi" & value(the text of field "score"))>
  [ 59] pushint8 35 ............................. <35>
  [ 62] set 6 ................................... set the memberNum of sprite 40 to the number of member ("zigi" & value(the text of field "score"))
  [ 64] ret
end
