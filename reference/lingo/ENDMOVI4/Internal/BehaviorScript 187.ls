  set the cursor of sprite 28 to [member("handcur1").memberNum, member("handcur2").memberNum]
  set the cursor of sprite 34 to [member("handcur1").memberNum, member("handcur2").memberNum]
  set the cursor of sprite 41 to [member("handcur1").memberNum, member("handcur2").memberNum]
