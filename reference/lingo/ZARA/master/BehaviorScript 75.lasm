on exitFrame
  [  0] pushsymb 16 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 32 ............................ <soundspath>
  [  8] pushcons 0 .............................. <"zat6.aif">
  [ 10] joinstr ................................. <soundspath & "zat6.aif">
  [ 11] pusharglistnoret 3 ...................... <1, soundspath & "zat6.aif">
  [ 13] extcall 17 .............................. sound playFile 1, soundspath & "zat6.aif"
  [ 15] ret
end
