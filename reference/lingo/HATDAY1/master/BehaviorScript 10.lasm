on exitFrame
  [  0] pushsymb 12 ............................. <#playFile>
  [  2] pushint8 2 .............................. <2>
  [  5] getglobal 19 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"clap.aif">
  [  9] joinstr ................................. <effectspath & "clap.aif">
  [ 10] pusharglistnoret 3 ...................... <2, effectspath & "clap.aif">
  [ 12] extcall 13 .............................. sound playFile 2, effectspath & "clap.aif"
  [ 14] ret
end
