on mouseUp
  [  0] pushsymb 12 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 14 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"hez63.aif">
  [  9] joinstr ................................. <tlkpath & "hez63.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "hez63.aif">
  [ 12] extcall 13 .............................. sound playFile 1, tlkpath & "hez63.aif"
  [ 14] pushcons 8 .............................. <"choose2ab">
  [ 16] pusharglistnoret 1 ...................... <"choose2ab">
  [ 18] extcall 26 .............................. go("choose2ab")
  [ 20] ret
end
