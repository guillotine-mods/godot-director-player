on exitFrame
  [  0] getglobal 27 ............................ <optcount>
  [  2] pushint8 1 .............................. <1>
  [  5] add ..................................... <optcount + 1>
  [  6] setglobal 27 ............................ optcount = optcount + 1
  [  8] getglobal 27 ............................ <optcount>
  [ 10] pushint8 1 .............................. <1>
  [ 13] eq ...................................... <optcount = 1>
  [ 14] jmpifz [ 26] ............................ if optcount = 1 then / else
  [ 17] pushcons 0 .............................. <"choose1">
  [ 19] pusharglistnoret 1 ...................... <"choose1">
  [ 21] extcall 26 .............................. go("choose1")
  [ 23] jmp [ 35]
  [ 26] pushcons 8 .............................. <"conect1">
  [ 28] pusharglistnoret 1 ...................... <"conect1">
  [ 30] extcall 26 .............................. go("conect1")
  [ 32] pushzero ................................ <0>
  [ 33] setglobal 27 ............................ optcount = 0
  [ 35] ret
end
