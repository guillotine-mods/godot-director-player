on exitFrame
  [  0] pushint8 1 .............................. <1>
  [  3] pusharglist 1 ........................... <1>
  [  5] extcall 47 .............................. <soundBusy(1)>
  [  8] not ..................................... <not soundBusy(1)>
  [  9] jmpifz [ 26] ............................ if not soundBusy(1) then
  [ 12] pushsymb 3 .............................. <#playFile>
  [ 14] pushint8 1 .............................. <1>
  [ 17] getglobal 23 ............................ <effectspath>
  [ 19] pushcons 0 .............................. <"dive1.aif">
  [ 21] joinstr ................................. <effectspath & "dive1.aif">
  [ 22] pusharglistnoret 3 ...................... <1, effectspath & "dive1.aif">
  [ 24] extcall 4 ............................... sound playFile 1, effectspath & "dive1.aif"
  [ 26] ret
end
