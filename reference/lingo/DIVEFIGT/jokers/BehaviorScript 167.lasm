on exitFrame
  [  0] pushint8 93 ............................. <93>
  [  3] pusharglist 1 ........................... <93>
  [  5] extcall 45 .............................. <sprite(93)>
  [  8] getobjprop 46 ........................... <sprite(93).visible>
  [ 11] pushzero ................................ <0>
  [ 12] eq ...................................... <sprite(93).visible = 0>
  [ 13] jmpifz [ 36] ............................ if sprite(93).visible = 0 then
  [ 16] pushint8 93 ............................. <93>
  [ 19] pusharglist 1 ........................... <93>
  [ 21] extcall 45 .............................. <sprite(93)>
  [ 24] pushint8 1 .............................. <1>
  [ 27] setobjprop 46 ........................... sprite(93).visible = 1
  [ 30] pushcons 0 .............................. <"cont1">
  [ 32] pusharglistnoret 1 ...................... <"cont1">
  [ 34] extcall 13 .............................. go("cont1")
  [ 36] ret
end
