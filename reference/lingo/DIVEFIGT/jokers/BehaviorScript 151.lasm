on exitFrame
  [  0] pushsymb 3 .............................. <#playFile>
  [  2] pushint8 3 .............................. <3>
  [  5] getglobal 23 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"metlhit2.aif">
  [  9] joinstr ................................. <effectspath & "metlhit2.aif">
  [ 10] pusharglistnoret 3 ...................... <3, effectspath & "metlhit2.aif">
  [ 12] extcall 4 ............................... sound playFile 3, effectspath & "metlhit2.aif"
  [ 14] ret
end
