on exitFrame
  [  0] pushsymb 13 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 15 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"hez5.aif">
  [  9] joinstr ................................. <tlkpath & "hez5.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "hez5.aif">
  [ 12] extcall 14 .............................. sound playFile 1, tlkpath & "hez5.aif"
  [ 14] ret
end
