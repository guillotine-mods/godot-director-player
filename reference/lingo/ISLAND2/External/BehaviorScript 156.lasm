on enterFrame
  [  0] pushcons 0 .............................. <"show">
  [  2] setlocal 0 .............................. x = "show"
  [  4] pushint8 1 .............................. <1>
  [  7] setlocal 8
  [  9] getlocal 8
  [ 11] pushint8 30 ............................. <30>
  [ 14] lteq
  [ 15] jmpifz [ 54] ............................ repeat with i = 1 to 30
  [ 18] pushzero ................................ <0>
  [ 19] pushzero ................................ <0>
  [ 20] pushzero ................................ <0>
  [ 21] pushzero ................................ <0>
  [ 22] pushzero ................................ <0>
  [ 23] pushzero ................................ <0>
  [ 24] getlocal 8 .............................. <i>
  [ 26] pushzero ................................ <0>
  [ 27] pushcons 8 .............................. <"objectsfield">
  [ 29] pushcons 16 ............................. <"master">
  [ 31] getfield ................................ <field("objectsfield", "master")>
  [ 32] getchunk ................................ <line i of field "objectsfield" of castLib "master">
  [ 33] pushcons 24 ............................. <"sulam">
  [ 35] eq ...................................... <line i of field "objectsfield" of castLib "master" = "sulam">
  [ 36] jmpifz [ 43] ............................ if line i of field "objectsfield" of castLib "master" = "sulam" then
  [ 39] pushcons 32 ............................. <"hide">
  [ 41] setlocal 0 .............................. x = "hide"
  [ 43] pushint8 1
  [ 46] getlocal 8
  [ 48] add
  [ 49] setlocal 8
  [ 51] endrepeat [  9]
  [ 54] pushzero ................................ <0>
  [ 55] pushzero ................................ <0>
  [ 56] pushzero ................................ <0>
  [ 57] pushzero ................................ <0>
  [ 58] pushint8 1 .............................. <1>
  [ 61] pushzero ................................ <0>
  [ 62] pushzero ................................ <0>
  [ 63] pushzero ................................ <0>
  [ 64] getglobal 52 ............................ <globalnight>
  [ 67] getchunk ................................ <item 1 of globalnight>
  [ 68] pushcons 40 ............................. <"0">
  [ 70] nteq .................................... <item 1 of globalnight <> "0">
  [ 71] jmpifz [ 78] ............................ if item 1 of globalnight <> "0" then
  [ 74] pushcons 48 ............................. <"hide">
  [ 76] setlocal 0 .............................. x = "hide"
  [ 78] getlocal 0 .............................. <x>
  [ 80] pushcons 56 ............................. <"hide">
  [ 82] eq ...................................... <x = "hide">
  [ 83] jmpifz [ 99] ............................ if x = "hide" then / else
  [ 86] pushint8 17 ............................. <17>
  [ 89] pusharglist 1 ........................... <17>
  [ 91] extcall 8 ............................... <sprite(17)>
  [ 93] pushzero ................................ <0>
  [ 94] setobjprop 9 ............................ sprite(17).visible = 0
  [ 96] jmp [111]
  [ 99] pushint8 17 ............................. <17>
  [102] pusharglist 1 ........................... <17>
  [104] extcall 8 ............................... <sprite(17)>
  [106] pushint8 1 .............................. <1>
  [109] setobjprop 9 ............................ sprite(17).visible = 1
  [111] pushint8 2 .............................. <2>
  [114] pusharglist 1 ........................... <2>
  [116] extcall 42 .............................. <soundBusy(2)>
  [119] not ..................................... <not soundBusy(2)>
  [120] getglobal 46 ............................ <whichsnd>
  [123] pushcons 64 ............................. <"path">
  [125] nteq .................................... <whichsnd <> "path">
  [126] or ...................................... <not soundBusy(2) or (whichsnd <> "path")>
  [127] jmpifz [150] ............................ if not soundBusy(2) or (whichsnd <> "path") then
  [130] pushsymb 23 ............................. <#playFile>
  [132] pushint8 2 .............................. <2>
  [135] getglobal 47 ............................ <effectspath>
  [138] pushcons 72 ............................. <"path.aif">
  [140] joinstr ................................. <effectspath & "path.aif">
  [141] pusharglistnoret 3 ...................... <2, effectspath & "path.aif">
  [143] extcall 24 .............................. sound playFile 2, effectspath & "path.aif"
  [145] pushcons 80 ............................. <"path">
  [147] setglobal 46 ............................ whichsnd = "path"
  [150] ret
end
