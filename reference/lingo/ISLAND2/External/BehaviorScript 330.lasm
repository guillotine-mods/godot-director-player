on exitFrame
  [  0] pushsymb 23 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 47 ............................ <effectspath>
  [  8] pushcons 0 .............................. <"toalet.aif">
  [ 10] joinstr ................................. <effectspath & "toalet.aif">
  [ 11] pusharglistnoret 3 ...................... <1, effectspath & "toalet.aif">
  [ 13] extcall 24 .............................. sound playFile 1, effectspath & "toalet.aif"
  [ 15] ret
end
