on mouseUp
  [  0] pushsymb 23 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 25 ............................ <soundspath>
  [  7] pushcons 0 .............................. <"skul.aif">
  [  9] joinstr ................................. <soundspath & "skul.aif">
  [ 10] pusharglistnoret 3 ...................... <1, soundspath & "skul.aif">
  [ 12] extcall 24 .............................. sound playFile 1, soundspath & "skul.aif"
  [ 14] pushcons 8 .............................. <"skulspk">
  [ 16] pusharglistnoret 1 ...................... <"skulspk">
  [ 18] extcall 41 .............................. play frame "skulspk"
  [ 21] ret
end
