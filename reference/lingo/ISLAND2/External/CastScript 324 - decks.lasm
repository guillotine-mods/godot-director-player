on mouseUp
  [  0] pushcons 0 .............................. <"000">
  [  2] setglobal 1 ............................. nextroomdata = "000"
  [  4] getglobal 3 ............................. <egozv>
  [  6] pushint8 319 ............................ <319>
  [  9] nteq .................................... <egozv <> 319>
  [ 10] getglobal 5 ............................. <egozh>
  [ 12] pushint8 342 ............................ <342>
  [ 15] nteq .................................... <egozh <> 342>
  [ 16] and ..................................... <(egozv <> 319) and (egozh <> 342)>
  [ 17] jmpifz [ 41] ............................ if (egozv <> 319) and (egozh <> 342) then / else
  [ 20] pushcons 8 .............................. <"0,0">
  [ 22] setglobal 13 ............................ ifmovie = "0,0"
  [ 24] pushint8 319 ............................ <319>
  [ 27] setglobal 3 ............................. egozv = 319
  [ 29] pushint8 342 ............................ <342>
  [ 32] setglobal 5 ............................. egozh = 342
  [ 34] pusharglistnoret 0 ...................... <>
  [ 36] extcall 6 ............................... walkonby()
  [ 38] jmp [ 58]
  [ 41] getglobal 18 ............................ <whatodo>
  [ 43] pushcons 16 ............................. <"stand">
  [ 45] eq ...................................... <whatodo = "stand">
  [ 46] jmpifz [ 58] ............................ if whatodo = "stand" then
  [ 49] pushint8 1 .............................. <1>
  [ 52] pushcons 24 ............................. <"chess.dxr">
  [ 54] pusharglistnoret 2 ...................... <1, "chess.dxr">
  [ 56] extcall 22 .............................. go(1, "chess.dxr")
  [ 58] ret
end
