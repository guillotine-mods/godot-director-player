on enterFrame
  [  0] pushcons 0 .............................. <"show">
  [  2] setlocal 0 .............................. x = "show"
  [  4] pushint8 1 .............................. <1>
  [  7] setlocal 8
  [  9] getlocal 8
  [ 11] pushint8 30 ............................. <30>
  [ 14] lteq
  [ 15] jmpifz [ 54] ............................ repeat with i = 1 to 30
  [ 18] pushzero ................................ <0>
  [ 19] pushzero ................................ <0>
  [ 20] pushzero ................................ <0>
  [ 21] pushzero ................................ <0>
  [ 22] pushzero ................................ <0>
  [ 23] pushzero ................................ <0>
  [ 24] getlocal 8 .............................. <i>
  [ 26] pushzero ................................ <0>
  [ 27] pushcons 8 .............................. <"objectsfield">
  [ 29] pushcons 16 ............................. <"master">
  [ 31] getfield ................................ <field("objectsfield", "master")>
  [ 32] getchunk ................................ <line i of field "objectsfield" of castLib "master">
  [ 33] pushcons 24 ............................. <"shovel">
  [ 35] eq ...................................... <line i of field "objectsfield" of castLib "master" = "shovel">
  [ 36] jmpifz [ 43] ............................ if line i of field "objectsfield" of castLib "master" = "shovel" then
  [ 39] pushcons 32 ............................. <"hide">
  [ 41] setlocal 0 .............................. x = "hide"
  [ 43] pushint8 1
  [ 46] getlocal 8
  [ 48] add
  [ 49] setlocal 8
  [ 51] endrepeat [  9]
  [ 54] getlocal 0 .............................. <x>
  [ 56] pushcons 40 ............................. <"hide">
  [ 58] eq ...................................... <x = "hide">
  [ 59] jmpifz [ 75] ............................ if x = "hide" then / else
  [ 62] pushint8 17 ............................. <17>
  [ 65] pusharglist 1 ........................... <17>
  [ 67] extcall 8 ............................... <sprite(17)>
  [ 69] pushzero ................................ <0>
  [ 70] setobjprop 9 ............................ sprite(17).visible = 0
  [ 72] jmp [ 87]
  [ 75] pushint8 17 ............................. <17>
  [ 78] pusharglist 1 ........................... <17>
  [ 80] extcall 8 ............................... <sprite(17)>
  [ 82] pushint8 1 .............................. <1>
  [ 85] setobjprop 9 ............................ sprite(17).visible = 1
  [ 87] pushint8 2 .............................. <2>
  [ 90] pusharglist 1 ........................... <2>
  [ 92] extcall 42 .............................. <soundBusy(2)>
  [ 95] not ..................................... <not soundBusy(2)>
  [ 96] getglobal 46 ............................ <whichsnd>
  [ 99] pushcons 48 ............................. <"path">
  [101] nteq .................................... <whichsnd <> "path">
  [102] or ...................................... <not soundBusy(2) or (whichsnd <> "path")>
  [103] jmpifz [126] ............................ if not soundBusy(2) or (whichsnd <> "path") then
  [106] pushsymb 23 ............................. <#playFile>
  [108] pushint8 2 .............................. <2>
  [111] getglobal 47 ............................ <effectspath>
  [114] pushcons 56 ............................. <"path.aif">
  [116] joinstr ................................. <effectspath & "path.aif">
  [117] pusharglistnoret 3 ...................... <2, effectspath & "path.aif">
  [119] extcall 24 .............................. sound playFile 2, effectspath & "path.aif"
  [121] pushcons 64 ............................. <"path">
  [123] setglobal 46 ............................ whichsnd = "path"
  [126] ret
end
