on mouseUp
  [  0] pushsymb 23 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 25 ............................ <soundspath>
  [  7] pushcons 0 .............................. <"hezskul3.aif">
  [  9] joinstr ................................. <soundspath & "hezskul3.aif">
  [ 10] pusharglistnoret 3 ...................... <1, soundspath & "hezskul3.aif">
  [ 12] extcall 24 .............................. sound playFile 1, soundspath & "hezskul3.aif"
  [ 14] ret
end
