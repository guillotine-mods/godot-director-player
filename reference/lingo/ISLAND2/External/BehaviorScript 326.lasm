on exitFrame
  [  0] pushint8 2 .............................. <2>
  [  3] pusharglist 1 ........................... <2>
  [  5] extcall 42 .............................. <soundBusy(2)>
  [  8] not ..................................... <not soundBusy(2)>
  [  9] getglobal 46 ............................ <whichsnd>
  [ 12] pushcons 0 .............................. <"path">
  [ 14] nteq .................................... <whichsnd <> "path">
  [ 15] or ...................................... <not soundBusy(2) or (whichsnd <> "path")>
  [ 16] jmpifz [ 39] ............................ if not soundBusy(2) or (whichsnd <> "path") then
  [ 19] pushsymb 23 ............................. <#playFile>
  [ 21] pushint8 2 .............................. <2>
  [ 24] getglobal 47 ............................ <effectspath>
  [ 27] pushcons 8 .............................. <"path.aif">
  [ 29] joinstr ................................. <effectspath & "path.aif">
  [ 30] pusharglistnoret 3 ...................... <2, effectspath & "path.aif">
  [ 32] extcall 24 .............................. sound playFile 2, effectspath & "path.aif"
  [ 34] pushcons 16 ............................. <"path">
  [ 36] setglobal 46 ............................ whichsnd = "path"
  [ 39] ret
end
