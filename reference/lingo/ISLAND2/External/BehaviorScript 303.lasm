on exitFrame
  [  0] pushcons 0 .............................. <"exitcave">
  [  2] pusharglistnoret 1 ...................... <"exitcave">
  [  4] extcall 22 .............................. go("exitcave")
  [  6] pushint8 4 .............................. <4>
  [  9] pusharglist 1 ........................... <4>
  [ 11] extcall 8 ............................... <sprite(4)>
  [ 13] pushint8 1 .............................. <1>
  [ 16] setobjprop 9 ............................ sprite(4).visible = 1
  [ 18] ret
end
