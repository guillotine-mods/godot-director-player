on exitFrame
  [  0] pushint8 40 ............................. <40>
  [  3] setlocal 0
  [  5] getlocal 0
  [  7] pushint8 59 ............................. <59>
  [ 10] lteq
  [ 11] jmpifz [ 35] ............................ repeat with i = 40 to 59
  [ 14] getlocal 0 .............................. <i>
  [ 16] pusharglist 1 ........................... <i>
  [ 18] extcall 8 ............................... <sprite(i)>
  [ 20] pushint8 1 .............................. <1>
  [ 23] setobjprop 9 ............................ sprite(i).visible = 1
  [ 25] pushint8 1
  [ 28] getlocal 0
  [ 30] add
  [ 31] setlocal 0
  [ 33] endrepeat [  5]
  [ 35] ret
end
