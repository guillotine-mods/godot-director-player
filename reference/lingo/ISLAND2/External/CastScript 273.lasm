on mouseUp
  [  0] getglobal 34 ............................ <map>
  [  3] setlocal 0 .............................. x = map
  [  5] pushcons 0 .............................. <"shore2">
  [  7] setglobal 34 ............................ map = "shore2"
  [ 10] pushcons 8 .............................. <"travel">
  [ 12] getlocal 0 .............................. <x>
  [ 14] joinstr ................................. <"travel" & x>
  [ 15] pusharglistnoret 1 ...................... <"travel" & x>
  [ 17] extcall 22 .............................. go("travel" & x)
  [ 19] ret
end
