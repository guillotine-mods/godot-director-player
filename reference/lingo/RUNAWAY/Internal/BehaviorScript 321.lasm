on exitFrame
  [  0] pushsymb 4 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 19 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"kick.aif">
  [  9] joinstr ................................. <effectspath & "kick.aif">
  [ 10] pusharglistnoret 3 ...................... <1, effectspath & "kick.aif">
  [ 12] extcall 3 ............................... sound playFile 1, effectspath & "kick.aif"
  [ 14] ret
end
