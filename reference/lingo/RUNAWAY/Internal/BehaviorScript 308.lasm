on exitFrame
  [  0] pushsymb 4 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 22 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"hez278.aif">
  [  9] joinstr ................................. <tlkpath & "hez278.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "hez278.aif">
  [ 12] extcall 3 ............................... sound playFile 1, tlkpath & "hez278.aif"
  [ 14] pushsymb 4 .............................. <#playFile>
  [ 16] pushint8 4 .............................. <4>
  [ 19] getglobal 19 ............................ <effectspath>
  [ 21] pushcons 8 .............................. <"rachbal.aif">
  [ 23] joinstr ................................. <effectspath & "rachbal.aif">
  [ 24] pusharglistnoret 3 ...................... <4, effectspath & "rachbal.aif">
  [ 26] extcall 3 ............................... sound playFile 4, effectspath & "rachbal.aif"
  [ 28] ret
end
