on exitFrame
  [  0] pushsymb 4 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 22 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"force1.aif">
  [  9] joinstr ................................. <tlkpath & "force1.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "force1.aif">
  [ 12] extcall 3 ............................... sound playFile 1, tlkpath & "force1.aif"
  [ 14] ret
end
