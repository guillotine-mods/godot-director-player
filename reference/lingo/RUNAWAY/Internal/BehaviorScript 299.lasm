on exitFrame
  [  0] pushint8 4 .............................. <4>
  [  3] pushint8 130 ............................ <130>
  [  6] pushint8 1 .............................. <1>
  [  9] set 4 ................................... set the volume of sound 4 to 130
  [ 11] pushsymb 4 .............................. <#playFile>
  [ 13] pushint8 4 .............................. <4>
  [ 16] getglobal 19 ............................ <effectspath>
  [ 18] pushcons 0 .............................. <"night1.aif">
  [ 20] joinstr ................................. <effectspath & "night1.aif">
  [ 21] pusharglistnoret 3 ...................... <4, effectspath & "night1.aif">
  [ 23] extcall 3 ............................... sound playFile 4, effectspath & "night1.aif"
  [ 25] ret
end
