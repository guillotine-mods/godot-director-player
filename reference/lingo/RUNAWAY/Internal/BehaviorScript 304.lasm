on exitFrame
  [  0] pushsymb 4 .............................. <#playFile>
  [  2] pushint8 2 .............................. <2>
  [  5] getglobal 19 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"running.aif">
  [  9] joinstr ................................. <effectspath & "running.aif">
  [ 10] pusharglistnoret 3 ...................... <2, effectspath & "running.aif">
  [ 12] extcall 3 ............................... sound playFile 2, effectspath & "running.aif"
  [ 14] pushsymb 4 .............................. <#playFile>
  [ 16] pushint8 4 .............................. <4>
  [ 19] getglobal 19 ............................ <effectspath>
  [ 21] pushcons 8 .............................. <"night1.aif">
  [ 23] joinstr ................................. <effectspath & "night1.aif">
  [ 24] pusharglistnoret 3 ...................... <4, effectspath & "night1.aif">
  [ 26] extcall 3 ............................... sound playFile 4, effectspath & "night1.aif"
  [ 28] ret
end
