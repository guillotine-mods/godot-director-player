on exitFrame
  [  0] pushsymb 4 .............................. <#playFile>
  [  2] pushint8 3 .............................. <3>
  [  5] getglobal 19 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"runing.aif">
  [  9] joinstr ................................. <effectspath & "runing.aif">
  [ 10] pusharglistnoret 3 ...................... <3, effectspath & "runing.aif">
  [ 12] extcall 3 ............................... sound playFile 3, effectspath & "runing.aif"
  [ 14] ret
end
