on exitFrame
  [  0] pushint8 4 .............................. <4>
  [  3] pusharglist 1 ........................... <4>
  [  5] extcall 24 .............................. <soundBusy(4)>
  [  7] not ..................................... <not soundBusy(4)>
  [  8] jmpifz [ 22] ............................ if not soundBusy(4) then
  [ 11] pushint8 1 .............................. <1>
  [ 14] pusharglist 1 ........................... <1>
  [ 16] extcall 25 .............................. <marker(1)>
  [ 18] pusharglistnoret 1 ...................... <marker(1)>
  [ 20] extcall 26 .............................. go(marker(1))
  [ 22] ret
end
