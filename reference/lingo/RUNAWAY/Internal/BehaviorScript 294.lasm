on exitFrame
  [  0] pushsymb 4 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 22 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"hat19.aif">
  [  9] joinstr ................................. <tlkpath & "hat19.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "hat19.aif">
  [ 12] extcall 3 ............................... sound playFile 1, tlkpath & "hat19.aif"
  [ 14] pushsymb 20 ............................. <#stop>
  [ 16] pushint8 2 .............................. <2>
  [ 19] pusharglistnoret 2 ...................... <2>
  [ 21] extcall 3 ............................... sound stop 2
  [ 23] pushsymb 20 ............................. <#stop>
  [ 25] pushint8 3 .............................. <3>
  [ 28] pusharglistnoret 2 ...................... <3>
  [ 30] extcall 3 ............................... sound stop 3
  [ 32] ret
end
