on exitFrame
  [  0] pushsymb 25 ............................. <#playFile>
  [  2] pushint8 2 .............................. <2>
  [  5] getglobal 28 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"clik1.aif">
  [  9] joinstr ................................. <effectspath & "clik1.aif">
  [ 10] pusharglistnoret 3 ...................... <2, effectspath & "clik1.aif">
  [ 12] extcall 26 .............................. sound playFile 2, effectspath & "clik1.aif"
  [ 14] ret
end
