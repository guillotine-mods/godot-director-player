on exitFrame
  [  0] pushsymb 25 ............................. <#playFile>
  [  2] pushint8 3 .............................. <3>
  [  5] getglobal 27 ............................ <soundspath>
  [  7] pushcons 0 .............................. <"gar9.aif">
  [  9] joinstr ................................. <soundspath & "gar9.aif">
  [ 10] pusharglistnoret 3 ...................... <3, soundspath & "gar9.aif">
  [ 12] extcall 26 .............................. sound playFile 3, soundspath & "gar9.aif"
  [ 14] ret
end
