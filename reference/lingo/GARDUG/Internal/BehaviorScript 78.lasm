on exitFrame
  [  0] pushsymb 25 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 28 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"bang.aif">
  [  9] joinstr ................................. <effectspath & "bang.aif">
  [ 10] pusharglistnoret 3 ...................... <1, effectspath & "bang.aif">
  [ 12] extcall 26 .............................. sound playFile 1, effectspath & "bang.aif"
  [ 14] ret
end
