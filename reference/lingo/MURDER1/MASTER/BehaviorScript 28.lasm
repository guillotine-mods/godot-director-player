on exitFrame
  [  0] pushsymb 13 ............................. <#playFile>
  [  2] pushint8 2 .............................. <2>
  [  5] getglobal 15 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"gold5.aif">
  [  9] joinstr ................................. <tlkpath & "gold5.aif">
  [ 10] pusharglistnoret 3 ...................... <2, tlkpath & "gold5.aif">
  [ 12] extcall 14 .............................. sound playFile 2, tlkpath & "gold5.aif"
  [ 14] ret
end
