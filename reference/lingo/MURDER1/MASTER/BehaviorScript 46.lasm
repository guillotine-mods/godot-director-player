on exitFrame
  [  0] pushsymb 13 ............................. <#playFile>
  [  2] pushint8 3 .............................. <3>
  [  5] getglobal 21 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"thudhgh.aif">
  [  9] joinstr ................................. <effectspath & "thudhgh.aif">
  [ 10] pusharglistnoret 3 ...................... <3, effectspath & "thudhgh.aif">
  [ 12] extcall 14 .............................. sound playFile 3, effectspath & "thudhgh.aif"
  [ 14] ret
end
