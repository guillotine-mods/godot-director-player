on exitFrame
  [  0] pushsymb 29 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 32 ............................ <tlkpath>
  [  8] pushcons 0 .............................. <"hez91.aif">
  [ 10] joinstr ................................. <tlkpath & "hez91.aif">
  [ 11] pusharglistnoret 3 ...................... <1, tlkpath & "hez91.aif">
  [ 13] extcall 30 .............................. sound playFile 1, tlkpath & "hez91.aif"
  [ 15] ret
end
