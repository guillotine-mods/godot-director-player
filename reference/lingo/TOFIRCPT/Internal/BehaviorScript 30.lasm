on exitFrame
  [  0] pushsymb 1 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 32 ............................ <tlkpath>
  [  8] pushcons 0 .............................. <"d1prom5.aif">
  [ 10] joinstr ................................. <tlkpath & "d1prom5.aif">
  [ 11] pusharglistnoret 3 ...................... <1, tlkpath & "d1prom5.aif">
  [ 13] extcall 2 ............................... sound playFile 1, tlkpath & "d1prom5.aif"
  [ 15] ret
end
