on exitFrame
  [  0] pushint8 1 .............................. <1>
  [  3] pusharglist 1 ........................... <1>
  [  5] extcall 38 .............................. <soundBusy(1)>
  [  8] not ..................................... <not soundBusy(1)>
  [  9] jmpifz [ 26] ............................ if not soundBusy(1) then
  [ 12] pushsymb 5 .............................. <#playFile>
  [ 14] pushint8 1 .............................. <1>
  [ 17] getglobal 7 ............................. <effectspath>
  [ 19] pushcons 0 .............................. <"wreck3.aif">
  [ 21] joinstr ................................. <effectspath & "wreck3.aif">
  [ 22] pusharglistnoret 3 ...................... <1, effectspath & "wreck3.aif">
  [ 24] extcall 6 ............................... sound playFile 1, effectspath & "wreck3.aif"
  [ 26] ret
end
