on exitFrame
  [  0] pushint8 2 .............................. <2>
  [  3] pushint8 100 ............................ <100>
  [  6] pushint8 1 .............................. <1>
  [  9] set 4 ................................... set the volume of sound 2 to 100
  [ 11] pushsymb 5 .............................. <#playFile>
  [ 13] pushint8 4 .............................. <4>
  [ 16] getglobal 13 ............................ <soundspath>
  [ 18] pushcons 0 .............................. <"pipend">
  [ 20] pushint8 3 .............................. <3>
  [ 23] pusharglist 1 ........................... <3>
  [ 25] extcall 14 .............................. <random(3)>
  [ 27] joinstr ................................. <"pipend" & random(3)>
  [ 28] pushcons 8 .............................. <".aif">
  [ 30] joinstr ................................. <"pipend" & random(3) & ".aif">
  [ 31] joinstr ................................. <soundspath & "pipend" & random(3) & ".aif">
  [ 32] pusharglistnoret 3 ...................... <4, soundspath & "pipend" & random(3) & ".aif">
  [ 34] extcall 6 ............................... sound playFile 4, soundspath & "pipend" & random(3) & ".aif"
  [ 36] ret
end
