on exitFrame
  [  0] pushsymb 1 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 3 ............................. <effectspath>
  [  7] pushcons 0 .............................. <"rachfar.aif">
  [  9] joinstr ................................. <effectspath & "rachfar.aif">
  [ 10] pusharglistnoret 3 ...................... <1, effectspath & "rachfar.aif">
  [ 12] extcall 2 ............................... sound playFile 1, effectspath & "rachfar.aif"
  [ 14] ret
end
