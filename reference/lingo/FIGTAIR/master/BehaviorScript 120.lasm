on exitFrame
  [  0] pushsymb 1 .............................. <#playFile>
  [  2] pushint8 2 .............................. <2>
  [  5] getglobal 3 ............................. <effectspath>
  [  7] pushcons 0 .............................. <"action.aif">
  [  9] joinstr ................................. <effectspath & "action.aif">
  [ 10] pusharglistnoret 3 ...................... <2, effectspath & "action.aif">
  [ 12] extcall 2 ............................... sound playFile 2, effectspath & "action.aif"
  [ 14] ret
end
