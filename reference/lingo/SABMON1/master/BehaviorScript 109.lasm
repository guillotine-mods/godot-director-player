on exitFrame
  [  0] pushsymb 27 ............................. <#playFile>
  [  2] pushint8 3 .............................. <3>
  [  5] getglobal 32 ............................ <tlkpath>
  [  8] pushcons 0 .............................. <"jump3.aif">
  [ 10] joinstr ................................. <tlkpath & "jump3.aif">
  [ 11] pusharglistnoret 3 ...................... <3, tlkpath & "jump3.aif">
  [ 13] extcall 28 .............................. sound playFile 3, tlkpath & "jump3.aif"
  [ 15] pushsymb 27 ............................. <#playFile>
  [ 17] pushint8 4 .............................. <4>
  [ 20] getglobal 32 ............................ <tlkpath>
  [ 23] pushcons 8 .............................. <"jump4.aif">
  [ 25] joinstr ................................. <tlkpath & "jump4.aif">
  [ 26] pusharglistnoret 3 ...................... <4, tlkpath & "jump4.aif">
  [ 28] extcall 28 .............................. sound playFile 4, tlkpath & "jump4.aif"
  [ 30] ret
end
