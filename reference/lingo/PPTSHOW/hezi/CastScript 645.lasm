on mouseUp
  [  0] pushsymb 21 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 25 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"clik2.aif">
  [  9] joinstr ................................. <effectspath & "clik2.aif">
  [ 10] pusharglistnoret 3 ...................... <1, effectspath & "clik2.aif">
  [ 12] extcall 22 .............................. sound playFile 1, effectspath & "clik2.aif"
  [ 14] pushcons 8 .............................. <"zif">
  [ 16] pusharglistnoret 1 ...................... <"zif">
  [ 18] extcall 4 ............................... go("zif")
  [ 20] ret
end
