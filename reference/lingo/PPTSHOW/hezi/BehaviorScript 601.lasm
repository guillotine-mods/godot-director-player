on exitFrame
  [  0] pushsymb 21 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 23 ............................ <soundspath>
  [  7] pushcons 0 .............................. <"bar26.aif">
  [  9] joinstr ................................. <soundspath & "bar26.aif">
  [ 10] pusharglistnoret 3 ...................... <1, soundspath & "bar26.aif">
  [ 12] extcall 22 .............................. sound playFile 1, soundspath & "bar26.aif"
  [ 14] ret
end
