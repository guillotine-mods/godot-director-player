on exitFrame
  [  0] pushsymb 21 ............................. <#playFile>
  [  2] pushint8 2 .............................. <2>
  [  5] getglobal 25 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"crash.aif">
  [  9] joinstr ................................. <effectspath & "crash.aif">
  [ 10] pusharglistnoret 3 ...................... <2, effectspath & "crash.aif">
  [ 12] extcall 22 .............................. sound playFile 2, effectspath & "crash.aif"
  [ 14] ret
end
