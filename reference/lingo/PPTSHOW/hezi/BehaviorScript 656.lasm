on exitFrame
  [  0] pushsymb 21 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 25 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"clik1.aif">
  [  9] joinstr ................................. <effectspath & "clik1.aif">
  [ 10] pusharglistnoret 3 ...................... <1, effectspath & "clik1.aif">
  [ 12] extcall 22 .............................. sound playFile 1, effectspath & "clik1.aif"
  [ 14] ret
end
