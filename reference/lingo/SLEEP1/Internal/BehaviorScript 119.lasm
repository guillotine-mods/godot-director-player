on exitFrame
  [  0] pushsymb 1 .............................. <#playFile>
  [  2] pushint8 2 .............................. <2>
  [  5] getglobal 4 ............................. <tlkpath>
  [  7] pushcons 0 .............................. <"tof20.aif">
  [  9] joinstr ................................. <tlkpath & "tof20.aif">
  [ 10] pusharglistnoret 3 ...................... <2, tlkpath & "tof20.aif">
  [ 12] extcall 2 ............................... sound playFile 2, tlkpath & "tof20.aif"
  [ 14] ret
end
