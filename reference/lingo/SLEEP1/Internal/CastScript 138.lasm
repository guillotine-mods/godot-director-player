on mouseUp
  [  0] pushsymb 1 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 4 ............................. <tlkpath>
  [  7] pushcons 0 .............................. <"hez22.aif">
  [  9] joinstr ................................. <tlkpath & "hez22.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "hez22.aif">
  [ 12] extcall 2 ............................... sound playFile 1, tlkpath & "hez22.aif"
  [ 14] pushcons 8 .............................. <"choose2b">
  [ 16] pusharglistnoret 1 ...................... <"choose2b">
  [ 18] extcall 6 ............................... go("choose2b")
  [ 20] ret
end
