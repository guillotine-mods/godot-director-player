on enterFrame
  [  0] pushint8 11 ............................. <11>
  [  3] setlocal 0
  [  5] getlocal 0
  [  7] pushint8 62 ............................. <62>
  [ 10] lteq
  [ 11] jmpifz [ 43] ............................ repeat with i = 11 to 62
  [ 14] getlocal 0 .............................. <i>
  [ 16] pushzero ................................ <0>
  [ 17] pusharglistnoret 2 ...................... <i, 0>
  [ 19] extcall 14 .............................. puppetSprite(i, 0)
  [ 21] getlocal 0 .............................. <i>
  [ 23] pusharglist 1 ........................... <i>
  [ 25] extcall 69 .............................. <sprite(i)>
  [ 28] pushzero ................................ <0>
  [ 29] setobjprop 70 ........................... sprite(i).visible = 0
  [ 32] pushint8 1
  [ 35] getlocal 0
  [ 37] add
  [ 38] setlocal 0
  [ 40] endrepeat [  5]
  [ 43] pushint8 2 .............................. <2>
  [ 46] pushint8 255 ............................ <255>
  [ 49] pushint8 1 .............................. <1>
  [ 52] set 4 ................................... set the volume of sound 2 to 255
  [ 54] pushsymb 8 .............................. <#playFile>
  [ 56] pushint8 3 .............................. <3>
  [ 59] getglobal 10 ............................ <soundspath>
  [ 61] pushcons 0 .............................. <"wonches.aif">
  [ 63] joinstr ................................. <soundspath & "wonches.aif">
  [ 64] pusharglistnoret 3 ...................... <3, soundspath & "wonches.aif">
  [ 66] extcall 9 ............................... sound playFile 3, soundspath & "wonches.aif"
  [ 68] ret
end
