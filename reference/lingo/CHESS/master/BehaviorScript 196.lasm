on exitFrame
  [  0] pushsymb 8 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 10 ............................ <soundspath>
  [  7] pushcons 0 .............................. <"arti">
  [  9] pushint8 10 ............................. <10>
  [ 12] pusharglist 1 ........................... <10>
  [ 14] extcall 18 .............................. <random(10)>
  [ 16] joinstr ................................. <"arti" & random(10)>
  [ 17] pushcons 8 .............................. <".aif">
  [ 19] joinstr ................................. <"arti" & random(10) & ".aif">
  [ 20] joinstr ................................. <soundspath & "arti" & random(10) & ".aif">
  [ 21] pusharglistnoret 3 ...................... <1, soundspath & "arti" & random(10) & ".aif">
  [ 23] extcall 9 ............................... sound playFile 1, soundspath & "arti" & random(10) & ".aif"
  [ 25] getglobal 48 ............................ <globalday>
  [ 28] pushint8 2 .............................. <2>
  [ 31] eq ...................................... <globalday = 2>
  [ 32] jmpifz [ 55] ............................ if globalday = 2 then
  [ 35] pushcons 16 ............................. <"done">
  [ 37] pushzero ................................ <0>
  [ 38] pushzero ................................ <0>
  [ 39] pushzero ................................ <0>
  [ 40] pushzero ................................ <0>
  [ 41] pushint8 8 .............................. <8>
  [ 44] pushzero ................................ <0>
  [ 45] pushint8 2 .............................. <2>
  [ 48] pushzero ................................ <0>
  [ 49] pushcons 24 ............................. <"Dprocess">
  [ 51] pushcons 32 ............................. <"master">
  [ 53] putchunk 22 ............................. put "done" into item 8 of line 2 of field "Dprocess" of castLib "master"
  [ 55] ret
end
