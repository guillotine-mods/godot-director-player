on exitFrame
  [  0] pushsymb 8 .............................. <#playFile>
  [  2] pushint8 2 .............................. <2>
  [  5] getglobal 71 ............................ <effectspath>
  [  8] pushcons 0 .............................. <"bang.aif">
  [ 10] joinstr ................................. <effectspath & "bang.aif">
  [ 11] pusharglistnoret 3 ...................... <2, effectspath & "bang.aif">
  [ 13] extcall 9 ............................... sound playFile 2, effectspath & "bang.aif"
  [ 15] ret
end
