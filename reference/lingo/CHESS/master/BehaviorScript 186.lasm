on exitFrame
  [  0] pushsymb 8 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  4] getglobal 10 ............................ <soundspath>
  [  6] pushcons 0 .............................. <"artlos1.aif">
  [  8] joinstr ................................. <soundspath & "artlos1.aif">
  [  9] pusharglistnoret 3 ...................... <1, soundspath & "artlos1.aif">
  [ 11] extcall 9 ............................... sound playFile 1, soundspath & "artlos1.aif"
  [ 13] ret
end
