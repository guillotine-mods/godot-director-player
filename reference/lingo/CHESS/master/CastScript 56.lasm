on mouseUp
  [  0] pushint8 28 ............................. <28>
  [  2] pushint8 1 .............................. <1>
  [  4] pushint8 25 ............................. <25>
  [  6] set 6 ................................... set the visible of sprite 28 to 1
  [  8] pushcons 0 .............................. <"boardinit">
  [ 10] pushzero ................................ <0>
  [ 11] pushint8 2 .............................. <2>
  [ 13] get 11 .................................. <the text of field "boardinit">
  [ 15] pushcons 8 .............................. <"board">
  [ 17] pushzero ................................ <0>
  [ 18] put 22 .................................. put the text of field "boardinit" into field "board"
  [ 20] pushcons 16 ............................. <"H">
  [ 22] pushzero ................................ <0>
  [ 23] pushzero ................................ <0>
  [ 24] pushzero ................................ <0>
  [ 25] pushzero ................................ <0>
  [ 26] pushint8 5 .............................. <5>
  [ 28] pushzero ................................ <0>
  [ 29] pushint8 3 .............................. <3>
  [ 31] pushzero ................................ <0>
  [ 32] pushcons 24 ............................. <"board">
  [ 34] pushzero ................................ <0>
  [ 35] putchunk 22 ............................. put "H" into item 5 of line 3 of field "board"
  [ 37] pushint8 7 .............................. <7>
  [ 39] setlocal 0
  [ 41] getlocal 0
  [ 43] pushint8 9 .............................. <9>
  [ 45] lteq
  [ 46] jmpifz [ 66] ............................ repeat with i = 7 to 9
  [ 49] getlocal 0 .............................. <i>
  [ 51] pushint8 1 .............................. <1>
  [ 53] pushint8 25 ............................. <25>
  [ 55] set 6 ................................... set the visible of sprite i to 1
  [ 57] pushint8 1
  [ 59] getlocal 0
  [ 61] add
  [ 62] setlocal 0
  [ 64] endrepeat [ 41]
  [ 66] pushsymb 8 .............................. <#playFile>
  [ 68] pushint8 1 .............................. <1>
  [ 70] getglobal 10 ............................ <soundspath>
  [ 72] pushcons 32 ............................. <"istrt.aif">
  [ 74] joinstr ................................. <soundspath & "istrt.aif">
  [ 75] pusharglistnoret 3 ...................... <1, soundspath & "istrt.aif">
  [ 77] extcall 9 ............................... sound playFile 1, soundspath & "istrt.aif"
  [ 79] pushint8 1 .............................. <1>
  [ 81] pusharglist 1 ........................... <1>
  [ 83] extcall 11 .............................. <marker(1)>
  [ 85] pusharglistnoret 1 ...................... <marker(1)>
  [ 87] extcall 6 ............................... go(marker(1))
  [ 89] ret
end
