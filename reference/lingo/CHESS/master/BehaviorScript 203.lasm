on exitFrame
  [  0] pushsymb 8 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 71 ............................ <effectspath>
  [  8] pushcons 0 .............................. <"clik1.aif">
  [ 10] joinstr ................................. <effectspath & "clik1.aif">
  [ 11] pusharglistnoret 3 ...................... <1, effectspath & "clik1.aif">
  [ 13] extcall 9 ............................... sound playFile 1, effectspath & "clik1.aif"
  [ 15] ret
end
