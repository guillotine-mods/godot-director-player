on exitFrame
  [  0] pushcons 0 .............................. <"done">
  [  2] pushzero ................................ <0>
  [  3] pushzero ................................ <0>
  [  4] pushzero ................................ <0>
  [  5] pushzero ................................ <0>
  [  6] pushint8 9 .............................. <9>
  [  9] pushzero ................................ <0>
  [ 10] pushint8 1 .............................. <1>
  [ 13] pushzero ................................ <0>
  [ 14] pushcons 8 .............................. <"Dprocess">
  [ 16] pushcons 16 ............................. <"master">
  [ 18] putchunk 22 ............................. put "done" into item 9 of line 1 of field "Dprocess" of castLib "master"
  [ 20] pushcons 24 ............................. <"points">
  [ 22] pushcons 32 ............................. <"master">
  [ 24] pushint8 2 .............................. <2>
  [ 27] get 11 .................................. <the text of field "points" of castLib "master">
  [ 29] pusharglist 1 ........................... <the text of field "points" of castLib "master">
  [ 31] extcall 22 .............................. <value(the text of field "points" of castLib "master")>
  [ 33] setlocal 0 .............................. x = value(the text of field "points" of castLib "master")
  [ 35] getlocal 0 .............................. <x>
  [ 37] pushint8 1 .............................. <1>
  [ 40] add ..................................... <x + 1>
  [ 41] setlocal 0 .............................. x = x + 1
  [ 43] getlocal 0 .............................. <x>
  [ 45] pushint8 10 ............................. <10>
  [ 48] lt ...................................... <x < 10>
  [ 49] jmpifz [ 66] ............................ if x < 10 then / else
  [ 52] pushcons 40 ............................. <"00">
  [ 54] getlocal 0 .............................. <x>
  [ 56] joinstr ................................. <"00" & x>
  [ 57] pushcons 48 ............................. <"points">
  [ 59] pushcons 56 ............................. <"master">
  [ 61] put 22 .................................. put "00" & x into field "points" of castLib "master"
  [ 63] jmp [ 77]
  [ 66] pushcons 64 ............................. <"0">
  [ 68] getlocal 0 .............................. <x>
  [ 70] joinstr ................................. <"0" & x>
  [ 71] pushcons 72 ............................. <"points">
  [ 73] pushcons 80 ............................. <"master">
  [ 75] put 22 .................................. put "0" & x into field "points" of castLib "master"
  [ 77] ret
end
