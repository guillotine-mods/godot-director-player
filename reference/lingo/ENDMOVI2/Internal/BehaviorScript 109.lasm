on exitFrame
  [  0] pushint8 1 .............................. <1>
  [  3] getmovieprop 21 ......................... <the moviePath>
  [  5] pushcons 0 .............................. <"endmovi3.dxr">
  [  7] joinstr ................................. <the moviePath & "endmovi3.dxr">
  [  8] pusharglistnoret 2 ...................... <1, the moviePath & "endmovi3.dxr">
  [ 10] extcall 18 .............................. go(1, the moviePath & "endmovi3.dxr")
  [ 12] ret
end
