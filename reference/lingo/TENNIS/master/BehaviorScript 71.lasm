on exitFrame
  [  0] pushint8 1 .............................. <1>
  [  3] setglobal 14 ............................ serve = 1
  [  5] pushcons 0 .............................. <"yes">
  [  7] setglobal 1 ............................. miss = "yes"
  [  9] pushint8 9 .............................. <9>
  [ 12] pushzero ................................ <0>
  [ 13] pusharglistnoret 2 ...................... <9, 0>
  [ 15] extcall 15 .............................. puppetSprite(9, 0)
  [ 17] pushcons 8 .............................. <"0">
  [ 19] pushcons 16 ............................. <"hatscore">
  [ 21] pushzero ................................ <0>
  [ 22] put 22 .................................. put "0" into field "hatscore"
  [ 24] pushcons 24 ............................. <"0">
  [ 26] pushcons 32 ............................. <"hezscore">
  [ 28] pushzero ................................ <0>
  [ 29] put 22 .................................. put "0" into field "hezscore"
  [ 31] pushcons 40 ............................. <"1,1,1">
  [ 33] setglobal 7 ............................. runcount = "1,1,1"
  [ 35] pushint8 13 ............................. <13>
  [ 38] pusharglist 1 ........................... <13>
  [ 40] extcall 16 .............................. <sprite(13)>
  [ 42] pushint8 1 .............................. <1>
  [ 45] setobjprop 17 ........................... sprite(13).visible = 1
  [ 47] pushcons 48 ............................. <"games">
  [ 49] pusharglistnoret 1 ...................... <"games">
  [ 51] extcall 18 .............................. soundspath("games")
  [ 53] ret
end
