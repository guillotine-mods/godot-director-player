on exitFrame
  [  0] pushcons 0 .............................. <"hitback">
  [  2] pushint8 3 .............................. <3>
  [  5] set 0 ................................... set the keyDownScript to "hitback"
  [  7] pushint8 7 .............................. <7>
  [ 10] pushint8 1 .............................. <1>
  [ 13] pusharglistnoret 2 ...................... <7, 1>
  [ 15] extcall 15 .............................. puppetSprite(7, 1)
  [ 17] pushint8 9 .............................. <9>
  [ 20] pushzero ................................ <0>
  [ 21] pusharglistnoret 2 ...................... <9, 0>
  [ 23] extcall 15 .............................. puppetSprite(9, 0)
  [ 25] pushsymb 20 ............................. <#playFile>
  [ 27] pushint8 1 .............................. <1>
  [ 30] getglobal 18 ............................ <soundspath>
  [ 32] pushcons 8 .............................. <"birdi.aif">
  [ 34] joinstr ................................. <soundspath & "birdi.aif">
  [ 35] pusharglistnoret 3 ...................... <1, soundspath & "birdi.aif">
  [ 37] extcall 21 .............................. sound playFile 1, soundspath & "birdi.aif"
  [ 39] ret
end
