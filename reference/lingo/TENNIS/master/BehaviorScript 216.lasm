on exitFrame
  [  0] pushcons 0 .............................. <EMPTY>
  [  2] pushint8 3 .............................. <3>
  [  5] set 0 ................................... set the keyDownScript to EMPTY
  [  7] pushcons 8 .............................. <"fromnow">
  [  9] pushint8 3 .............................. <3>
  [ 12] set 0 ................................... set the keyDownScript to "fromnow"
  [ 14] pushint8 7 .............................. <7>
  [ 17] pushzero ................................ <0>
  [ 18] pusharglistnoret 2 ...................... <7, 0>
  [ 20] extcall 15 .............................. puppetSprite(7, 0)
  [ 22] pushint8 9 .............................. <9>
  [ 25] pushzero ................................ <0>
  [ 26] pusharglistnoret 2 ...................... <9, 0>
  [ 28] extcall 15 .............................. puppetSprite(9, 0)
  [ 30] pushsymb 20 ............................. <#playFile>
  [ 32] pushint8 1 .............................. <1>
  [ 35] getglobal 18 ............................ <soundspath>
  [ 37] pushcons 16 ............................. <"jump.aif">
  [ 39] joinstr ................................. <soundspath & "jump.aif">
  [ 40] pusharglistnoret 3 ...................... <1, soundspath & "jump.aif">
  [ 42] extcall 21 .............................. sound playFile 1, soundspath & "jump.aif"
  [ 44] ret
end
