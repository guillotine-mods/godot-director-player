on exitFrame
  [  0] pushsymb 20 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 18 ............................ <soundspath>
  [  7] pushcons 0 .............................. <"konri.aif">
  [  9] joinstr ................................. <soundspath & "konri.aif">
  [ 10] pusharglistnoret 3 ...................... <1, soundspath & "konri.aif">
  [ 12] extcall 21 .............................. sound playFile 1, soundspath & "konri.aif"
  [ 14] ret
end
