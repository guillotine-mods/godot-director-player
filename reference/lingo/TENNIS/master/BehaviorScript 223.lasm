on exitFrame
  [  0] pushcons 0 .............................. <EMPTY>
  [  2] pushint8 3 .............................. <3>
  [  5] set 0 ................................... set the keyDownScript to EMPTY
  [  7] pushint8 7 .............................. <7>
  [ 10] pushcons 8 .............................. <"hezstnd">
  [ 12] pushzero ................................ <0>
  [ 13] pushint8 10 ............................. <10>
  [ 16] get 9 ................................... <the number of member "hezstnd">
  [ 18] pushint8 35 ............................. <35>
  [ 21] set 6 ................................... set the memberNum of sprite 7 to the number of member "hezstnd"
  [ 23] pushint8 7 .............................. <7>
  [ 26] pushzero ................................ <0>
  [ 27] pusharglistnoret 2 ...................... <7, 0>
  [ 29] extcall 15 .............................. puppetSprite(7, 0)
  [ 31] pushsymb 20 ............................. <#playFile>
  [ 33] pushint8 1 .............................. <1>
  [ 36] getglobal 19 ............................ <effectspath>
  [ 38] pushcons 16 ............................. <"tball">
  [ 40] pushint8 2 .............................. <2>
  [ 43] pusharglist 1 ........................... <2>
  [ 45] extcall 22 .............................. <random(2)>
  [ 47] joinstr ................................. <"tball" & random(2)>
  [ 48] pushcons 24 ............................. <".aif">
  [ 50] joinstr ................................. <"tball" & random(2) & ".aif">
  [ 51] joinstr ................................. <effectspath & "tball" & random(2) & ".aif">
  [ 52] pusharglistnoret 3 ...................... <1, effectspath & "tball" & random(2) & ".aif">
  [ 54] extcall 21 .............................. sound playFile 1, effectspath & "tball" & random(2) & ".aif"
  [ 56] pushint8 5 .............................. <5>
  [ 59] pusharglist 1 ........................... <5>
  [ 61] extcall 22 .............................. <random(5)>
  [ 63] pushint8 1 .............................. <1>
  [ 66] eq ...................................... <random(5) = 1>
  [ 67] jmpifz [ 76] ............................ if random(5) = 1 then
  [ 70] pushcons 32 ............................. <"coneri">
  [ 72] pusharglistnoret 1 ...................... <"coneri">
  [ 74] extcall 2 ............................... go("coneri")
  [ 76] ret
end
