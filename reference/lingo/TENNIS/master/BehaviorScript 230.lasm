on exitFrame
  [  0] pushsymb 20 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 19 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"jump.aif">
  [  9] joinstr ................................. <effectspath & "jump.aif">
  [ 10] pusharglistnoret 3 ...................... <1, effectspath & "jump.aif">
  [ 12] extcall 21 .............................. sound playFile 1, effectspath & "jump.aif"
  [ 14] ret
end
