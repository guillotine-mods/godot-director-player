on mouseUp
  [  0] pushsymb 6 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 8 ............................. <tlkpath>
  [  7] pushcons 0 .............................. <"hez25.aif">
  [  9] joinstr ................................. <tlkpath & "hez25.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "hez25.aif">
  [ 12] extcall 7 ............................... sound playFile 1, tlkpath & "hez25.aif"
  [ 14] pushcons 8 .............................. <"choose2a">
  [ 16] pusharglistnoret 1 ...................... <"choose2a">
  [ 18] extcall 4 ............................... go("choose2a")
  [ 20] ret
end
