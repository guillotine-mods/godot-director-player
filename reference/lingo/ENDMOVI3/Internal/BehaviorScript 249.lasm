on exitFrame
  [  0] pushint8 2 .............................. <2>
  [  3] pushint8 75 ............................. <75>
  [  6] pushint8 1 .............................. <1>
  [  9] set 4 ................................... set the volume of sound 2 to 75
  [ 11] pushsymb 6 .............................. <#playFile>
  [ 13] pushint8 2 .............................. <2>
  [ 16] getglobal 23 ............................ <effectspath>
  [ 18] pushcons 0 .............................. <"crash.aif">
  [ 20] joinstr ................................. <effectspath & "crash.aif">
  [ 21] pusharglistnoret 3 ...................... <2, effectspath & "crash.aif">
  [ 23] extcall 7 ............................... sound playFile 2, effectspath & "crash.aif"
  [ 25] ret
end
