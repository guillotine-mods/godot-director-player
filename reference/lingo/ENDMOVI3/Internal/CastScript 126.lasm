on mouseUp
  [  0] pushsymb 6 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 8 ............................. <tlkpath>
  [  7] pushcons 0 .............................. <"hez22.aif">
  [  9] joinstr ................................. <tlkpath & "hez22.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "hez22.aif">
  [ 12] extcall 7 ............................... sound playFile 1, tlkpath & "hez22.aif"
  [ 14] pushcons 8 .............................. <"choose1c">
  [ 16] pusharglistnoret 1 ...................... <"choose1c">
  [ 18] extcall 4 ............................... go("choose1c")
  [ 20] ret
end
