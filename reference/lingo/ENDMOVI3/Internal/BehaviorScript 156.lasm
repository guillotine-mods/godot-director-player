on exitFrame
  [  0] pushsymb 6 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 8 ............................. <tlkpath>
  [  7] pushcons 0 .............................. <"pat17.aif">
  [  9] joinstr ................................. <tlkpath & "pat17.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "pat17.aif">
  [ 12] extcall 7 ............................... sound playFile 1, tlkpath & "pat17.aif"
  [ 14] ret
end
