on exitFrame
  [  0] pushint8 2 .............................. <2>
  [  3] pushint8 75 ............................. <75>
  [  6] pushint8 1 .............................. <1>
  [  9] set 4 ................................... set the volume of sound 2 to 75
  [ 11] pushsymb 6 .............................. <#playFile>
  [ 13] pushint8 1 .............................. <1>
  [ 16] getglobal 8 ............................. <tlkpath>
  [ 18] pushcons 0 .............................. <"hez43.aif">
  [ 20] joinstr ................................. <tlkpath & "hez43.aif">
  [ 21] pusharglistnoret 3 ...................... <1, tlkpath & "hez43.aif">
  [ 23] extcall 7 ............................... sound playFile 1, tlkpath & "hez43.aif"
  [ 25] ret
end
