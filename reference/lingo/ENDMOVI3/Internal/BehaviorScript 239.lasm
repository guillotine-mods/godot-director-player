on exitFrame
  [  0] pushsymb 6 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 23 ............................ <effectspath>
  [  7] pushcons 0 .............................. <"kicked.aif">
  [  9] joinstr ................................. <effectspath & "kicked.aif">
  [ 10] pusharglistnoret 3 ...................... <1, effectspath & "kicked.aif">
  [ 12] extcall 7 ............................... sound playFile 1, effectspath & "kicked.aif"
  [ 14] ret
end
