on exitFrame
  [  0] pushsymb 15 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 17 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"hhez8.aif">
  [  9] joinstr ................................. <tlkpath & "hhez8.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "hhez8.aif">
  [ 12] extcall 16 .............................. sound playFile 1, tlkpath & "hhez8.aif"
  [ 14] ret
end
