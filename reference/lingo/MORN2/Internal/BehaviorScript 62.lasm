on exitFrame
  [  0] pushzero ................................ <0>
  [  1] setglobal 19 ............................ optcount = 0
  [  3] pushsymb 34 ............................. <#stop>
  [  6] pushint8 2 .............................. <2>
  [  9] pusharglistnoret 2 ...................... <2>
  [ 11] extcall 13 .............................. sound stop 2
  [ 13] ret
end
