on exitFrame
  [  0] pushint8 1 .............................. <1>
  [  3] pusharglist 1 ........................... <1>
  [  5] extcall 35 .............................. <soundBusy(1)>
  [  8] not ..................................... <not soundBusy(1)>
  [  9] jmpifz [ 26] ............................ if not soundBusy(1) then
  [ 12] pushsymb 3 .............................. <#playFile>
  [ 14] pushint8 3 .............................. <3>
  [ 17] getglobal 5 ............................. <effectspath>
  [ 19] pushcons 0 .............................. <"night1.aif">
  [ 21] joinstr ................................. <effectspath & "night1.aif">
  [ 22] pusharglistnoret 3 ...................... <3, effectspath & "night1.aif">
  [ 24] extcall 4 ............................... sound playFile 3, effectspath & "night1.aif"
  [ 26] ret
end
