on mouseUp
  [  0] pushcons 0 .............................. <"strtagin">
  [  2] pusharglistnoret 1 ...................... <"strtagin">
  [  4] extcall 1 ............................... go("strtagin")
  [  6] pushint8 10 ............................. <10>
  [  8] pushint8 1 .............................. <1>
  [ 10] pushint8 25 ............................. <25>
  [ 12] set 6 ................................... set the visible of sprite 10 to 1
  [ 14] ret
end
