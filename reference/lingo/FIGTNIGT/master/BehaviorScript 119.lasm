on exitFrame
  [  0] pushsymb 3 .............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 5 ............................. <effectspath>
  [  7] pushcons 0 .............................. <"crank.aif">
  [  9] joinstr ................................. <effectspath & "crank.aif">
  [ 10] pusharglistnoret 3 ...................... <1, effectspath & "crank.aif">
  [ 12] extcall 4 ............................... sound playFile 1, effectspath & "crank.aif"
  [ 14] ret
end
