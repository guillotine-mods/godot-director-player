on mouseUp
  [  0] pushcons 0 .............................. <"days">
  [  2] pusharglistnoret 1 ...................... <"days">
  [  4] extcall 36 .............................. soundspath("days")
  [  7] pushint8 2 .............................. <2>
  [ 10] pusharglist 1 ........................... <2>
  [ 12] extcall 48 .............................. <sprite(2)>
  [ 15] pushint8 255 ............................ <255>
  [ 18] setobjprop 51 ........................... sprite(2).volume = 255
  [ 21] pushcons 8 .............................. <"arcade">
  [ 23] pushcons 16 ............................. <"hotel1.dir">
  [ 25] pusharglistnoret 2 ...................... <"arcade", "hotel1.dir">
  [ 27] extcall 2 ............................... go("arcade", "hotel1.dir")
  [ 29] pushint8 30 ............................. <30>
  [ 32] pushint8 1 .............................. <1>
  [ 35] pusharglistnoret 2 ...................... <30, 1>
  [ 37] extcall 3 ............................... puppetSprite(30, 1)
  [ 39] pushint8 30 ............................. <30>
  [ 42] pushcons 24 ............................. <"standright5">
  [ 44] pushzero ................................ <0>
  [ 45] pushint8 10 ............................. <10>
  [ 48] get 9 ................................... <the number of member "standright5">
  [ 50] pushint8 35 ............................. <35>
  [ 53] set 6 ................................... set the memberNum of sprite 30 to the number of member "standright5"
  [ 55] pushint8 30 ............................. <30>
  [ 58] pusharglist 1 ........................... <30>
  [ 60] extcall 48 .............................. <sprite(30)>
  [ 63] pushint8 1 .............................. <1>
