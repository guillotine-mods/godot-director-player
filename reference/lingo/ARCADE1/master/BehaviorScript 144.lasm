on exitFrame
  [  0] pushcons 0 .............................. <EMPTY>
  [  2] pushint8 3 .............................. <3>
  [  5] set 0 ................................... set the keyDownScript to EMPTY
  [  7] pushsymb 34 ............................. <#playFile>
  [ 10] pushint8 1 .............................. <1>
  [ 13] getglobal 36 ............................ <soundspath>
  [ 16] pushcons 8 .............................. <"mnkbad2">
  [ 18] pushint8 3 .............................. <3>
  [ 21] pusharglist 1 ........................... <3>
  [ 23] extcall 18 .............................. <random(3)>
  [ 25] joinstr ................................. <"mnkbad2" & random(3)>
  [ 26] pushcons 16 ............................. <".aif">
  [ 28] joinstr ................................. <"mnkbad2" & random(3) & ".aif">
  [ 29] joinstr ................................. <soundspath & "mnkbad2" & random(3) & ".aif">
  [ 30] pusharglistnoret 3 ...................... <1, soundspath & "mnkbad2" & random(3) & ".aif">
  [ 32] extcall 35 .............................. sound playFile 1, soundspath & "mnkbad2" & random(3) & ".aif"
  [ 35] pushsymb 52 ............................. <#stop>
  [ 38] pushint8 2 .............................. <2>
  [ 41] pusharglistnoret 2 ...................... <2>
  [ 43] extcall 35 .............................. sound stop 2
  [ 46] ret
end
