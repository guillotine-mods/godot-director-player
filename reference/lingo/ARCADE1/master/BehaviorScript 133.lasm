on exitFrame
  [  0] pushcons 0 .............................. <"0">
  [  2] pushcons 8 .............................. <"score">
  [  4] pushzero ................................ <0>
  [  5] put 22 .................................. put "0" into field "score"
  [  7] pushint8 100 ............................ <100>
  [ 10] setlocal 0
  [ 12] getlocal 0
  [ 14] pushint8 109 ............................ <109>
  [ 17] lteq
  [ 18] jmpifz [ 44] ............................ repeat with i = 100 to 109
  [ 21] getlocal 0 .............................. <i>
  [ 23] pusharglist 1 ........................... <i>
  [ 25] extcall 48 .............................. <sprite(i)>
  [ 28] pushint8 1 .............................. <1>
  [ 31] setobjprop 49 ........................... sprite(i).visible = 1
  [ 34] pushint8 1
  [ 37] getlocal 0
  [ 39] add
  [ 40] setlocal 0
  [ 42] endrepeat [ 12]
  [ 44] pushcons 16 ............................. <EMPTY>
  [ 46] pushint8 3 .............................. <3>
  [ 49] set 0 ................................... set the keyDownScript to EMPTY
  [ 51] pushint8 94 ............................. <94>
  [ 54] pusharglist 1 ........................... <94>
  [ 56] extcall 48 .............................. <sprite(94)>
  [ 59] pushint8 1 .............................. <1>
  [ 62] setobjprop 49 ........................... sprite(94).visible = 1
  [ 65] pushint8 95 ............................. <95>
  [ 68] pusharglist 1 ........................... <95>
  [ 70] extcall 48 .............................. <sprite(95)>
  [ 73] pushint8 1 .............................. <1>
  [ 76] setobjprop 49 ........................... sprite(95).visible = 1
  [ 79] pushint8 96 ............................. <96>
  [ 82] pusharglist 1 ........................... <96>
  [ 84] extcall 48 .............................. <sprite(96)>
  [ 87] pushint8 1 .............................. <1>
  [ 90] setobjprop 49 ........................... sprite(96).visible = 1
  [ 93] pushint8 106 ............................ <106>
  [ 96] pusharglist 1 ........................... <106>
  [ 98] extcall 48 .............................. <sprite(106)>
  [101] pushint8 1 .............................. <1>
  [104] setobjprop 49 ........................... sprite(106).visible = 1
  [107] pushint8 1 .............................. <1>
  [110] pushzero ................................ <0>
  [111] pushzero ................................ <0>
  [112] pushzero ................................ <0>
  [113] pushzero ................................ <0>
  [114] pushint8 7 .............................. <7>
  [117] pushzero ................................ <0>
  [118] pushzero ................................ <0>
  [119] pushzero ................................ <0>
  [120] pushcons 24 ............................. <"infos">
  [122] pushzero ................................ <0>
  [123] putchunk 22 ............................. put 1 into item 7 of field "infos"
  [125] pushint8 2 .............................. <2>
  [128] pushint8 75 ............................. <75>
  [131] pushint8 1 .............................. <1>
  [134] set 4 ................................... set the volume of sound 2 to 75
  [136] pushcons 32 ............................. <"games">
  [138] pusharglistnoret 1 ...................... <"games">
  [140] extcall 36 .............................. soundspath("games")
  [143] ret
end
