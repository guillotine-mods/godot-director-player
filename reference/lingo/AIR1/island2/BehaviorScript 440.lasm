on exitFrame
  [  0] pushsymb 48 ............................. <#playFile>
  [  3] pushint8 2 .............................. <2>
  [  6] getglobal 31 ............................ <effectspath>
  [  8] pushcons 0 .............................. <"rachcome.aif">
  [ 10] joinstr ................................. <effectspath & "rachcome.aif">
  [ 11] pusharglistnoret 3 ...................... <2, effectspath & "rachcome.aif">
  [ 13] extcall 49 .............................. sound playFile 2, effectspath & "rachcome.aif"
  [ 16] ret
end
