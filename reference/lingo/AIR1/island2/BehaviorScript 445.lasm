on exitFrame
  [  0] pushint8 1 .............................. <1>
  [  3] pushint8 150 ............................ <150>
  [  6] pushint8 1 .............................. <1>
  [  9] set 4 ................................... set the volume of sound 1 to 150
  [ 11] pushsymb 48 ............................. <#playFile>
  [ 14] pushint8 1 .............................. <1>
  [ 17] getglobal 31 ............................ <effectspath>
  [ 19] pushcons 0 .............................. <"lilopen.aif">
  [ 21] joinstr ................................. <effectspath & "lilopen.aif">
  [ 22] pusharglistnoret 3 ...................... <1, effectspath & "lilopen.aif">
  [ 24] extcall 49 .............................. sound playFile 1, effectspath & "lilopen.aif"
  [ 27] ret
end
