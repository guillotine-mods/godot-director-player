on exitFrame
  [  0] getglobal 110 ........................... <whichsnd>
  [  3] pushcons 0 .............................. <"cats">
  [  5] nteq .................................... <whichsnd <> "cats">
  [  6] jmpifz [ 33] ............................ if whichsnd <> "cats" then / else
  [  9] pushsymb 48 ............................. <#playFile>
  [ 12] pushint8 2 .............................. <2>
  [ 15] getglobal 31 ............................ <effectspath>
  [ 17] pushcons 8 .............................. <"church2.aif">
  [ 19] joinstr ................................. <effectspath & "church2.aif">
  [ 20] pusharglistnoret 3 ...................... <2, effectspath & "church2.aif">
  [ 22] extcall 49 .............................. sound playFile 2, effectspath & "church2.aif"
  [ 25] pushcons 16 ............................. <"clif1">
  [ 27] setglobal 110 ........................... whichsnd = "clif1"
  [ 30] jmp [ 54]
  [ 33] pushsymb 48 ............................. <#playFile>
  [ 36] pushint8 2 .............................. <2>
  [ 39] getglobal 31 ............................ <effectspath>
  [ 41] pushcons 24 ............................. <"clif1.aif">
  [ 43] joinstr ................................. <effectspath & "clif1.aif">
  [ 44] pusharglistnoret 3 ...................... <2, effectspath & "clif1.aif">
  [ 46] extcall 49 .............................. sound playFile 2, effectspath & "clif1.aif"
  [ 49] pushcons 32 ............................. <"clif1">
  [ 51] setglobal 110 ........................... whichsnd = "clif1"
  [ 54] ret
end
