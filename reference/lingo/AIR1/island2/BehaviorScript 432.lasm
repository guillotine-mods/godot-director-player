on exitFrame
  [  0] pushzero ................................ <0>
  [  1] pushzero ................................ <0>
  [  2] pushzero ................................ <0>
  [  3] pushzero ................................ <0>
  [  4] pushint8 1 .............................. <1>
  [  7] pushzero ................................ <0>
  [  8] pushzero ................................ <0>
  [  9] pushzero ................................ <0>
  [ 10] getglobal 22 ............................ <nextroomdata>
  [ 12] getchunk ................................ <item 1 of nextroomdata>
  [ 13] pusharglistnoret 1 ...................... <item 1 of nextroomdata>
  [ 15] extcall 3 ............................... go(item 1 of nextroomdata)
  [ 17] pushint8 30 ............................. <30>
  [ 20] pushint8 1 .............................. <1>
  [ 23] pusharglistnoret 2 ...................... <30, 1>
  [ 25] extcall 33 .............................. puppetSprite(30, 1)
  [ 28] pushint8 30 ............................. <30>
  [ 31] pushcons 0 .............................. <"standright5">
  [ 33] pushzero ................................ <0>
  [ 34] pushint8 10 ............................. <10>
  [ 37] get 9 ................................... <the number of member "standright5">
  [ 39] pushint8 35 ............................. <35>
  [ 42] set 6 ................................... set the memberNum of sprite 30 to the number of member "standright5"
  [ 44] pusharglistnoret 0 ...................... <>
  [ 46] extcall 12 .............................. updateStage()
  [ 48] pushsymb 48 ............................. <#playFile>
  [ 51] pushint8 1 .............................. <1>
  [ 54] getglobal 31 ............................ <effectspath>
  [ 56] pushcons 8 .............................. <"doorshut.aif">
  [ 58] joinstr ................................. <effectspath & "doorshut.aif">
  [ 59] pusharglistnoret 3 ...................... <1, effectspath & "doorshut.aif">
  [ 61] extcall 49 .............................. sound playFile 1, effectspath & "doorshut.aif"
  [ 64] pushint8 2 .............................. <2>
  [ 67] pushint8 130 ............................ <130>
  [ 70] pushint8 1 .............................. <1>
  [ 73] set 4 ................................... set the volume of sound 2 to 130
  [ 75] pushint8 30 ............................. <30>
  [ 78] pusharglist 1 ........................... <30>
  [ 80] extcall 103 ............................. <sprite(30)>
  [ 83] pushint8 1 .............................. <1>
  [ 86] setobjprop 104 .......................... sprite(30).visible = 1
  [ 89] pushcons 16 ............................. <"000">
  [ 91] setglobal 22 ............................ nextroomdata = "000"
  [ 93] ret
end
