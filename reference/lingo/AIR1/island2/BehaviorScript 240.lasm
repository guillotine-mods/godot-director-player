on exitFrame
  [  0] pushsymb 48 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  4] getglobal 30 ............................ <soundspath>
  [  6] pushcons 0 .............................. <"igkeytak.aif">
  [  8] joinstr ................................. <soundspath & "igkeytak.aif">
  [  9] pusharglistnoret 3 ...................... <1, soundspath & "igkeytak.aif">
  [ 11] extcall 49 .............................. sound playFile 1, soundspath & "igkeytak.aif"
  [ 13] ret
end
