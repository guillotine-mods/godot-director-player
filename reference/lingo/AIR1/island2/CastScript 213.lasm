on mouseUp
  [  0] pushcons 0 .............................. <"000">
  [  2] setglobal 22 ............................ nextroomdata = "000"
  [  4] getglobal 11 ............................ <egozv>
  [  6] pushint8 328 ............................ <328>
  [  9] nteq .................................... <egozv <> 328>
  [ 10] getglobal 10 ............................ <egozh>
  [ 12] pushint8 244 ............................ <244>
  [ 15] nteq .................................... <egozh <> 244>
  [ 16] or ...................................... <(egozv <> 328) or (egozh <> 244)>
  [ 17] jmpifz [ 37] ............................ if (egozv <> 328) or (egozh <> 244) then / else
  [ 20] pushint8 328 ............................ <328>
  [ 23] setglobal 11 ............................ egozv = 328
  [ 25] pushint8 244 ............................ <244>
  [ 28] setglobal 10 ............................ egozh = 244
  [ 30] pusharglistnoret 0 ...................... <>
  [ 32] extcall 15 .............................. walkonby()
  [ 34] jmp [ 58]
  [ 37] getglobal 13 ............................ <whatodo>
  [ 39] pushcons 8 .............................. <"stand">
  [ 41] eq ...................................... <whatodo = "stand">
  [ 42] jmpifz [ 58] ............................ if whatodo = "stand" then
  [ 45] pushint8 30 ............................. <30>
  [ 47] pushzero ................................ <0>
  [ 48] pushint8 25 ............................. <25>
  [ 50] set 6 ................................... set the visible of sprite 30 to 0
  [ 52] pushcons 16 ............................. <"toolsfall">
  [ 54] pusharglistnoret 1 ...................... <"toolsfall">
  [ 56] extcall 3 ............................... go("toolsfall")
  [ 58] ret
end
