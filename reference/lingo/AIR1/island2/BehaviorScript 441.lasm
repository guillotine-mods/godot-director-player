on exitFrame
  [  0] pushint8 1 .............................. <1>
  [  3] pushint8 255 ............................ <255>
  [  6] pushint8 1 .............................. <1>
  [  9] set 4 ................................... set the volume of sound 1 to 255
  [ 11] pushint8 2 .............................. <2>
  [ 14] pushint8 255 ............................ <255>
  [ 17] pushint8 1 .............................. <1>
  [ 20] set 4 ................................... set the volume of sound 2 to 255
  [ 22] pushsymb 48 ............................. <#playFile>
  [ 25] pushint8 2 .............................. <2>
  [ 28] getglobal 31 ............................ <effectspath>
  [ 30] pushcons 0 .............................. <"liftup.aif">
  [ 32] joinstr ................................. <effectspath & "liftup.aif">
  [ 33] pusharglistnoret 3 ...................... <2, effectspath & "liftup.aif">
  [ 35] extcall 49 .............................. sound playFile 2, effectspath & "liftup.aif"
  [ 38] ret
end
