on exitFrame
  [  0] pushsymb 48 ............................. <#playFile>
  [  3] pushint8 2 .............................. <2>
  [  6] getglobal 31 ............................ <effectspath>
  [  8] pushcons 0 .............................. <"sky.aif">
  [ 10] joinstr ................................. <effectspath & "sky.aif">
  [ 11] pusharglistnoret 3 ...................... <2, effectspath & "sky.aif">
  [ 13] extcall 49 .............................. sound playFile 2, effectspath & "sky.aif"
  [ 16] pushsymb 48 ............................. <#playFile>
  [ 19] pushint8 1 .............................. <1>
  [ 22] getglobal 30 ............................ <soundspath>
  [ 24] pushcons 8 .............................. <"onwayout.aif">
  [ 26] joinstr ................................. <soundspath & "onwayout.aif">
  [ 27] pusharglistnoret 3 ...................... <1, soundspath & "onwayout.aif">
  [ 29] extcall 49 .............................. sound playFile 1, soundspath & "onwayout.aif"
  [ 32] ret
end
