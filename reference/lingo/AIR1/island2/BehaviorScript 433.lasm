on exitFrame
  [  0] getglobal 91 ............................ <globalday>
  [  2] pushint8 3 .............................. <3>
  [  4] eq ...................................... <globalday = 3>
  [  5] pushzero ................................ <0>
  [  6] pushzero ................................ <0>
  [  7] pushzero ................................ <0>
  [  8] pushzero ................................ <0>
  [  9] pushint8 12 ............................. <12>
  [ 11] pushzero ................................ <0>
  [ 12] pushzero ................................ <0>
  [ 13] pushzero ................................ <0>
  [ 14] getglobal 92 ............................ <wreck>
  [ 16] getchunk ................................ <item 12 of wreck>
  [ 17] pushcons 0 .............................. <"0">
  [ 19] eq ...................................... <item 12 of wreck = "0">
  [ 20] and ..................................... <(globalday = 3) and (item 12 of wreck = "0")>
  [ 21] jmpifz [ 32] ............................ if (globalday = 3) and (item 12 of wreck = "0") then
  [ 24] pushint8 1 .............................. <1>
  [ 26] pushcons 8 .............................. <"figtair.dir">
  [ 28] pusharglistnoret 2 ...................... <1, "figtair.dir">
  [ 30] extcall 3 ............................... go(1, "figtair.dir")
  [ 32] ret
end
