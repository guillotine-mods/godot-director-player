on exitFrame
  [  0] pushint8 30 ............................. <30>
  [  2] pushint8 1 .............................. <1>
  [  4] pushint8 25 ............................. <25>
  [  6] set 6 ................................... set the visible of sprite 30 to 1
  [  8] pushcons 0 .............................. <"rachdown">
  [ 10] pusharglistnoret 1 ...................... <"rachdown">
  [ 12] extcall 3 ............................... go("rachdown")
  [ 14] ret
end
