on exitFrame
  [  0] pushsymb 48 ............................. <#playFile>
  [  3] pushint8 1 .............................. <1>
  [  6] getglobal 30 ............................ <soundspath>
  [  8] pushcons 0 .............................. <"kibini.aif">
  [ 10] joinstr ................................. <soundspath & "kibini.aif">
  [ 11] pusharglistnoret 3 ...................... <1, soundspath & "kibini.aif">
  [ 13] extcall 49 .............................. sound playFile 1, soundspath & "kibini.aif"
  [ 16] ret
end
