on mouseUp
  [  0] pushsymb 48 ............................. <#playFile>
  [  3] pushint8 1 .............................. <1>
  [  6] getglobal 30 ............................ <soundspath>
  [  8] pushcons 0 .............................. <"grdgail.aif">
  [ 10] joinstr ................................. <soundspath & "grdgail.aif">
  [ 11] pusharglistnoret 3 ...................... <1, soundspath & "grdgail.aif">
  [ 13] extcall 49 .............................. sound playFile 1, soundspath & "grdgail.aif"
  [ 16] pushcons 8 .............................. <"guardspk">
  [ 18] pusharglistnoret 1 ...................... <"guardspk">
  [ 20] extcall 81 .............................. play frame "guardspk"
  [ 23] ret
end
