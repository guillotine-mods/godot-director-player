on exitFrame
  [  0] pushcons 0 .............................. <"show">
  [  2] setlocal 0 .............................. x = "show"
  [  4] pushint8 1 .............................. <1>
  [  7] setlocal 8
  [  9] getlocal 8
  [ 11] pushint8 30 ............................. <30>
  [ 14] lteq
  [ 15] jmpifz [ 54] ............................ repeat with i = 1 to 30
  [ 18] pushzero ................................ <0>
  [ 19] pushzero ................................ <0>
  [ 20] pushzero ................................ <0>
  [ 21] pushzero ................................ <0>
  [ 22] pushzero ................................ <0>
  [ 23] pushzero ................................ <0>
  [ 24] getlocal 8 .............................. <i>
  [ 26] pushzero ................................ <0>
  [ 27] pushcons 8 .............................. <"objectsfield">
  [ 29] pushcons 16 ............................. <"master">
  [ 31] getfield ................................ <field("objectsfield", "master")>
  [ 32] getchunk ................................ <line i of field "objectsfield" of castLib "master">
  [ 33] pushcons 24 ............................. <"tools">
  [ 35] eq ...................................... <line i of field "objectsfield" of castLib "master" = "tools">
  [ 36] jmpifz [ 43] ............................ if line i of field "objectsfield" of castLib "master" = "tools" then
  [ 39] pushcons 32 ............................. <"hide">
  [ 41] setlocal 0 .............................. x = "hide"
  [ 43] pushint8 1
  [ 46] getlocal 8
  [ 48] add
  [ 49] setlocal 8
  [ 51] endrepeat [  9]
  [ 54] getlocal 0 .............................. <x>
  [ 56] pushcons 40 ............................. <"hide">
  [ 58] eq ...................................... <x = "hide">
  [ 59] jmpifz [ 77] ............................ if x = "hide" then / else
  [ 62] pushint8 17 ............................. <17>
  [ 65] pusharglist 1 ........................... <17>
  [ 67] extcall 103 ............................. <sprite(17)>
  [ 70] pushzero ................................ <0>
  [ 71] setobjprop 104 .......................... sprite(17).visible = 0
  [ 74] jmp [ 91]
  [ 77] pushint8 17 ............................. <17>
  [ 80] pusharglist 1 ........................... <17>
  [ 82] extcall 103 ............................. <sprite(17)>
  [ 85] pushint8 1 .............................. <1>
  [ 88] setobjprop 104 .......................... sprite(17).visible = 1
  [ 91] pushint8 2 .............................. <2>
  [ 94] pusharglist 1 ........................... <2>
  [ 96] extcall 54 .............................. <soundBusy(2)>
  [ 99] not ..................................... <not soundBusy(2)>
  [100] getglobal 110 ........................... <whichsnd>
  [103] pushcons 48 ............................. <"rachbal2">
  [105] nteq .................................... <whichsnd <> "rachbal2">
  [106] or ...................................... <not soundBusy(2) or (whichsnd <> "rachbal2")>
  [107] jmpifz [142] ............................ if not soundBusy(2) or (whichsnd <> "rachbal2") then
  [110] pushint8 2 .............................. <2>
  [113] pushint8 170 ............................ <170>
  [116] pushint8 1 .............................. <1>
  [119] set 4 ................................... set the volume of sound 2 to 170
  [121] pushsymb 48 ............................. <#playFile>
  [124] pushint8 2 .............................. <2>
  [127] getglobal 31 ............................ <effectspath>
  [129] pushcons 56 ............................. <"rachbal2.aif">
  [131] joinstr ................................. <effectspath & "rachbal2.aif">
  [132] pusharglistnoret 3 ...................... <2, effectspath & "rachbal2.aif">
  [134] extcall 49 .............................. sound playFile 2, effectspath & "rachbal2.aif"
  [137] pushcons 64 ............................. <"rachbal2">
  [139] setglobal 110 ........................... whichsnd = "rachbal2"
  [142] ret
end
