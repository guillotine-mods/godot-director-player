on exitFrame
  [  0] pushcons 0 .............................. <"s_days">
  [  2] pusharglistnoret 1 ...................... <"s_days">
  [  4] extcall 30 .............................. soundspath("s_days")
  [  6] pushcons 8 .............................. <"rachbalout">
  [  8] pushcons 16 ............................. <"day1.dir">
  [ 10] pusharglistnoret 2 ...................... <"rachbalout", "day1.dir">
  [ 12] extcall 3 ............................... go("rachbalout", "day1.dir")
  [ 14] pushint8 71 ............................. <71>
  [ 17] setglobal 10 ............................ egozh = 71
  [ 19] pushint8 288 ............................ <288>
  [ 22] setglobal 11 ............................ egozv = 288
  [ 24] pushint8 30 ............................. <30>
  [ 27] pushint8 1 .............................. <1>
  [ 30] pusharglistnoret 2 ...................... <30, 1>
  [ 32] extcall 33 .............................. puppetSprite(30, 1)
  [ 35] pushint8 30 ............................. <30>
  [ 38] pusharglist 1 ........................... <30>
  [ 40] extcall 103 ............................. <sprite(30)>
  [ 43] pushint8 1 .............................. <1>
