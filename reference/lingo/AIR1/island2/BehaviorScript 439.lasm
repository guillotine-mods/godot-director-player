on exitFrame
  [  0] pushsymb 111 ............................ <#stop>
  [  3] pushint8 2 .............................. <2>
  [  6] pusharglistnoret 2 ...................... <2>
  [  8] extcall 49 .............................. sound stop 2
  [ 11] pushsymb 48 ............................. <#playFile>
  [ 14] pushint8 1 .............................. <1>
  [ 17] getglobal 30 ............................ <soundspath>
  [ 19] pushcons 0 .............................. <"hfall.aif">
  [ 21] joinstr ................................. <soundspath & "hfall.aif">
  [ 22] pusharglistnoret 3 ...................... <1, soundspath & "hfall.aif">
  [ 24] extcall 49 .............................. sound playFile 1, soundspath & "hfall.aif"
  [ 27] ret
end
