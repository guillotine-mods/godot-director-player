on mouseUp
  [  0] pushint8 10 ............................. <10>
  [  3] setlocal 0 .............................. y = 10
  [  5] pushint8 1 .............................. <1>
  [  8] setlocal 8
  [ 10] getlocal 8
  [ 12] pushint8 10 ............................. <10>
  [ 15] lteq
  [ 16] jmpifz [ 59] ............................ repeat with i = 1 to 10
  [ 19] pushzero ................................ <0>
  [ 20] pushzero ................................ <0>
  [ 21] pushzero ................................ <0>
  [ 22] pushzero ................................ <0>
  [ 23] pushzero ................................ <0>
  [ 24] pushzero ................................ <0>
  [ 25] getlocal 8 .............................. <i>
  [ 27] pushzero ................................ <0>
  [ 28] pushcons 0 .............................. <"plane">
  [ 30] pushcons 8 .............................. <"master">
  [ 32] getfield ................................ <field("plane", "master")>
  [ 33] getchunk ................................ <line i of field "plane" of castLib "master">
  [ 34] pushcons 16 ............................. <"empty">
  [ 36] eq ...................................... <line i of field "plane" of castLib "master" = "empty">
  [ 37] jmpifz [ 48] ............................ if line i of field "plane" of castLib "master" = "empty" then
  [ 40] getlocal 0 .............................. <y>
  [ 42] pushint8 1 .............................. <1>
  [ 45] sub ..................................... <y - 1>
  [ 46] setlocal 0 .............................. y = y - 1
  [ 48] pushint8 1
  [ 51] getlocal 8
  [ 53] add
  [ 54] setlocal 8
  [ 56] endrepeat [ 10]
  [ 59] pushcons 24 ............................. <"air">
  [ 61] pusharglistnoret 1 ...................... <"air">
  [ 63] extcall 30 .............................. soundspath("air")
  [ 65] pushsymb 48 ............................. <#playFile>
  [ 68] pushint8 1 .............................. <1>
  [ 71] getglobal 30 ............................ <soundspath>
  [ 73] pushcons 32 ............................. <"misin">
  [ 75] getlocal 0 .............................. <y>
  [ 77] joinstr ................................. <"misin" & y>
  [ 78] pushcons 40 ............................. <".aif">
  [ 80] joinstr ................................. <"misin" & y & ".aif">
  [ 81] joinstr ................................. <soundspath & "misin" & y & ".aif">
  [ 82] pusharglistnoret 3 ...................... <1, soundspath & "misin" & y & ".aif">
  [ 84] extcall 49 .............................. sound playFile 1, soundspath & "misin" & y & ".aif"
  [ 87] ret
end
