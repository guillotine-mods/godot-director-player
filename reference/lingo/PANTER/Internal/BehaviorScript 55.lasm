on exitFrame
  [  0] pushsymb 26 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 28 ............................ <soundspath>
  [  7] pushcons 0 .............................. <"panter6.aif">
  [  9] joinstr ................................. <soundspath & "panter6.aif">
  [ 10] pusharglistnoret 3 ...................... <1, soundspath & "panter6.aif">
  [ 12] extcall 27 .............................. sound playFile 1, soundspath & "panter6.aif"
  [ 14] ret
end
