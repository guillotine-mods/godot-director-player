on mouseUp
  [  0] pushsymb 26 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 28 ............................ <soundspath>
  [  7] pushcons 0 .............................. <"panter3c.aif">
  [  9] joinstr ................................. <soundspath & "panter3c.aif">
  [ 10] pusharglistnoret 3 ...................... <1, soundspath & "panter3c.aif">
  [ 12] extcall 27 .............................. sound playFile 1, soundspath & "panter3c.aif"
  [ 14] pushcons 8 .............................. <"choose1b">
  [ 16] pusharglistnoret 1 ...................... <"choose1b">
  [ 18] extcall 18 .............................. go("choose1b")
  [ 20] ret
end
