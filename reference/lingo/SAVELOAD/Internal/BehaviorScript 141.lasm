on exitFrame
  [  0] pushsymb 81 ............................. <#stop>
  [  3] pushint8 2 .............................. <2>
  [  6] pusharglistnoret 2 ...................... <2>
  [  8] extcall 27 .............................. sound stop 2
  [ 10] pushsymb 26 ............................. <#playFile>
  [ 12] pushint8 1 .............................. <1>
  [ 15] getglobal 28 ............................ <soundspath>
  [ 17] pushcons 0 .............................. <"out">
  [ 19] pushint8 3 .............................. <3>
  [ 22] pusharglist 1 ........................... <3>
  [ 24] extcall 65 .............................. <random(3)>
  [ 27] joinstr ................................. <"out" & random(3)>
  [ 28] pushcons 8 .............................. <".aif">
  [ 30] joinstr ................................. <"out" & random(3) & ".aif">
  [ 31] joinstr ................................. <soundspath & "out" & random(3) & ".aif">
  [ 32] pusharglistnoret 3 ...................... <1, soundspath & "out" & random(3) & ".aif">
  [ 34] extcall 27 .............................. sound playFile 1, soundspath & "out" & random(3) & ".aif"
  [ 36] ret
end
