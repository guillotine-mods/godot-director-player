on mouseUp
  [  0] pushsymb 26 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 66 ............................ <effectspath>
  [  8] pushcons 0 .............................. <"clik3.aif">
  [ 10] joinstr ................................. <effectspath & "clik3.aif">
  [ 11] pusharglistnoret 3 ...................... <1, effectspath & "clik3.aif">
  [ 13] extcall 27 .............................. sound playFile 1, effectspath & "clik3.aif"
  [ 15] getglobal 33 ............................ <cdsavepath>
  [ 18] pushcons 8 .............................. <"saveload.dxr">
  [ 20] joinstr ................................. <cdsavepath & "saveload.dxr">
  [ 21] pusharglist 1 ........................... <cdsavepath & "saveload.dxr">
  [ 23] extcall 36 .............................. <window(cdsavepath & "saveload.dxr")>
  [ 26] pusharglistnoret 1 ...................... <window(cdsavepath & "saveload.dxr")>
  [ 28] extcall 35 .............................. forget(window(cdsavepath & "saveload.dxr"))
  [ 31] ret
end
