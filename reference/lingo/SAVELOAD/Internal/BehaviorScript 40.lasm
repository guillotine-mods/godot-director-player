on mouseUp
  [  0] pushint8 28 ............................. <28>
  [  3] setlocal 0
  [  5] getlocal 0
  [  7] pushint8 35 ............................. <35>
  [ 10] lteq
  [ 11] jmpifz [ 44] ............................ repeat with i = 28 to 35
  [ 14] getlocal 0 .............................. <i>
  [ 16] pusharglist 1 ........................... <i>
  [ 18] extcall 14 .............................. <sprite(i)>
  [ 20] getobjprop 15 ........................... <sprite(i).visible>
  [ 22] pushint8 1 .............................. <1>
  [ 25] eq ...................................... <sprite(i).visible = 1>
  [ 26] jmpifz [ 33] ............................ if sprite(i).visible = 1 then
  [ 29] getlocal 0 .............................. <i>
  [ 31] setlocal 8 .............................. x = i
  [ 33] pushint8 1
  [ 36] getlocal 0
  [ 38] add
  [ 39] setlocal 0
  [ 41] endrepeat [  5]
  [ 44] getlocal 8 .............................. <x>
  [ 46] pushint8 27 ............................. <27>
  [ 49] sub ..................................... <x - 27>
  [ 50] setlocal 8 .............................. x = x - 27
  [ 52] getlocal 8 .............................. <x>
  [ 54] setglobal 22 ............................ saveNum = x
  [ 56] pushcons 0 .............................. <"doload">
  [ 58] getglobal 3 ............................. <savepath>
  [ 60] pushcons 8 .............................. <"hezsave.dir">
  [ 62] joinstr ................................. <savepath & "hezsave.dir">
  [ 63] pusharglistnoret 2 ...................... <"doload", savepath & "hezsave.dir">
  [ 65] extcall 4 ............................... go("doload", savepath & "hezsave.dir")
  [ 67] ret
end
