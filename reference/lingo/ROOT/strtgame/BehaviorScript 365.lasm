on exitFrame
  [  0] pushint8 3 .............................. <3>
  [  3] get 0 ................................... <the keyDownScript>
  [  5] pushcons 0 .............................. <"fromnow">
  [  7] nteq .................................... <the keyDownScript <> "fromnow">
  [  8] pushint8 2 .............................. <2>
  [ 11] pusharglist 1 ........................... <2>
  [ 13] extcall 17 .............................. <soundBusy(2)>
  [ 15] not ..................................... <not soundBusy(2)>
  [ 16] or ...................................... <(the keyDownScript <> "fromnow") or not soundBusy(2)>
  [ 17] jmpifz [ 61] ............................ if (the keyDownScript <> "fromnow") or not soundBusy(2) then
  [ 20] pushcons 8 .............................. <"fromnow">
  [ 22] pushint8 3 .............................. <3>
  [ 25] set 0 ................................... set the keyDownScript to "fromnow"
  [ 27] pushsymb 30 ............................. <#stop>
  [ 29] pushint8 1 .............................. <1>
  [ 32] pusharglistnoret 2 ...................... <1>
  [ 34] extcall 16 .............................. sound stop 1
  [ 36] pushint8 2 .............................. <2>
  [ 39] pushint8 255 ............................ <255>
  [ 42] pushint8 1 .............................. <1>
  [ 45] set 4 ................................... set the volume of sound 2 to 255
  [ 47] pushsymb 15 ............................. <#playFile>
  [ 49] pushint8 2 .............................. <2>
  [ 52] getglobal 21 ............................ <effectspath>
  [ 54] pushcons 16 ............................. <"song1.aif">
  [ 56] joinstr ................................. <effectspath & "song1.aif">
  [ 57] pusharglistnoret 3 ...................... <2, effectspath & "song1.aif">
  [ 59] extcall 16 .............................. sound playFile 2, effectspath & "song1.aif"
  [ 61] ret
end
