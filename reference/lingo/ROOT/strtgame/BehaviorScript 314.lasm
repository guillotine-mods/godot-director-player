on exitFrame
  [  0] pushsymb 15 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 22 ............................ <soundspath>
  [  7] pushcons 0 .............................. <"boom.aif">
  [  9] joinstr ................................. <soundspath & "boom.aif">
  [ 10] pusharglistnoret 3 ...................... <1, soundspath & "boom.aif">
  [ 12] extcall 16 .............................. sound playFile 1, soundspath & "boom.aif"
  [ 14] ret
end
