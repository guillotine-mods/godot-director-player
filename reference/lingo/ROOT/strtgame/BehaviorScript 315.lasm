on exitFrame
  [  0] pushsymb 15 ............................. <#playFile>
  [  2] pushint8 3 .............................. <3>
  [  5] getglobal 20 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"blown.aif">
  [  9] joinstr ................................. <tlkpath & "blown.aif">
  [ 10] pusharglistnoret 3 ...................... <3, tlkpath & "blown.aif">
  [ 12] extcall 16 .............................. sound playFile 3, tlkpath & "blown.aif"
  [ 14] ret
end
