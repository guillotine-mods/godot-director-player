on mouseUp
  [  0] pushint8 93 ............................. <93>
  [  3] pusharglist 1 ........................... <93>
  [  5] extcall 8 ............................... <sprite(93)>
  [  7] pushzero ................................ <0>
  [  8] setobjprop 22 ........................... sprite(93).visible = 0
  [ 10] pushint8 100 ............................ <100>
  [ 13] pusharglist 1 ........................... <100>
  [ 15] extcall 8 ............................... <sprite(100)>
  [ 17] pushzero ................................ <0>
  [ 18] setobjprop 22 ........................... sprite(100).visible = 0
  [ 20] pushint8 103 ............................ <103>
  [ 23] setlocal 0
  [ 25] getlocal 0
  [ 27] pushint8 110 ............................ <110>
  [ 30] lteq
  [ 31] jmpifz [ 53] ............................ repeat with i = 103 to 110
  [ 34] getlocal 0 .............................. <i>
  [ 36] pusharglist 1 ........................... <i>
  [ 38] extcall 8 ............................... <sprite(i)>
  [ 40] pushzero ................................ <0>
  [ 41] setobjprop 22 ........................... sprite(i).visible = 0
  [ 43] pushint8 1
  [ 46] getlocal 0
  [ 48] add
  [ 49] setlocal 0
  [ 51] endrepeat [ 25]
  [ 53] pushcons 0 .............................. <"book5">
  [ 55] pusharglistnoret 1 ...................... <"book5">
  [ 57] extcall 2 ............................... go("book5")
  [ 59] ret
end
