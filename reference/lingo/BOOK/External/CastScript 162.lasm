on mouseUp
  [  0] pushint8 93 ............................. <93>
  [  3] pusharglist 1 ........................... <93>
  [  5] extcall 8 ............................... <sprite(93)>
  [  7] pushint8 1 .............................. <1>
  [ 10] setobjprop 22 ........................... sprite(93).visible = 1
  [ 12] pushint8 100 ............................ <100>
  [ 15] pusharglist 1 ........................... <100>
  [ 17] extcall 8 ............................... <sprite(100)>
  [ 19] pushint8 1 .............................. <1>
  [ 22] setobjprop 22 ........................... sprite(100).visible = 1
  [ 24] pushint8 103 ............................ <103>
  [ 27] setlocal 0
  [ 29] getlocal 0
  [ 31] pushint8 110 ............................ <110>
  [ 34] lteq
  [ 35] jmpifz [ 59] ............................ repeat with i = 103 to 110
  [ 38] getlocal 0 .............................. <i>
  [ 40] pusharglist 1 ........................... <i>
  [ 42] extcall 8 ............................... <sprite(i)>
  [ 44] pushint8 1 .............................. <1>
  [ 47] setobjprop 22 ........................... sprite(i).visible = 1
  [ 49] pushint8 1
  [ 52] getlocal 0
  [ 54] add
  [ 55] setlocal 0
  [ 57] endrepeat [ 29]
  [ 59] pushcons 0 .............................. <"lib">
  [ 61] pusharglistnoret 1 ...................... <"lib">
  [ 63] extcall 2 ............................... go("lib")
  [ 65] ret
end
