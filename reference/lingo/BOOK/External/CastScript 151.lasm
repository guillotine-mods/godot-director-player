on mouseUp
  [  0] pushint8 10 ............................. <10>
  [  3] pushzero ................................ <0>
  [  4] pusharglistnoret 2 ...................... <10, 0>
  [  6] extcall 19 .............................. puppetSprite(10, 0)
  [  8] pushint8 11 ............................. <11>
  [ 11] pushzero ................................ <0>
  [ 12] pusharglistnoret 2 ...................... <11, 0>
  [ 14] extcall 19 .............................. puppetSprite(11, 0)
  [ 16] pushint8 93 ............................. <93>
  [ 19] pusharglist 1 ........................... <93>
  [ 21] extcall 8 ............................... <sprite(93)>
  [ 23] pushint8 1 .............................. <1>
  [ 26] setobjprop 22 ........................... sprite(93).visible = 1
  [ 28] pushint8 100 ............................ <100>
  [ 31] pusharglist 1 ........................... <100>
  [ 33] extcall 8 ............................... <sprite(100)>
  [ 35] pushint8 1 .............................. <1>
  [ 38] setobjprop 22 ........................... sprite(100).visible = 1
  [ 40] pushint8 103 ............................ <103>
  [ 43] setlocal 0
  [ 45] getlocal 0
  [ 47] pushint8 110 ............................ <110>
  [ 50] lteq
  [ 51] jmpifz [ 75] ............................ repeat with i = 103 to 110
  [ 54] getlocal 0 .............................. <i>
  [ 56] pusharglist 1 ........................... <i>
  [ 58] extcall 8 ............................... <sprite(i)>
  [ 60] pushint8 1 .............................. <1>
  [ 63] setobjprop 22 ........................... sprite(i).visible = 1
  [ 65] pushint8 1
  [ 68] getlocal 0
  [ 70] add
  [ 71] setlocal 0
  [ 73] endrepeat [ 45]
  [ 75] pushcons 0 .............................. <"lib">
  [ 77] pusharglistnoret 1 ...................... <"lib">
  [ 79] extcall 2 ............................... go("lib")
  [ 81] ret
end
