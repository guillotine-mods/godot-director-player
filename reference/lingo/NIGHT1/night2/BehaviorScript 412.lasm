on exitFrame
  [  0] pushzero ................................ <0>
  [  1] pushzero ................................ <0>
  [  2] pushzero ................................ <0>
  [  3] pushzero ................................ <0>
  [  4] pushint8 3 .............................. <3>
  [  6] pushzero ................................ <0>
  [  7] pushzero ................................ <0>
  [  8] pushzero ................................ <0>
  [  9] getglobal 82 ............................ <globalnight>
  [ 11] getchunk ................................ <item 3 of globalnight>
  [ 12] pushcons 0 .............................. <"0">
  [ 14] eq ...................................... <item 3 of globalnight = "0">
  [ 15] getglobal 74 ............................ <globalday>
  [ 17] pushint8 2 .............................. <2>
  [ 19] eq ...................................... <globalday = 2>
  [ 20] and ..................................... <(item 3 of globalnight = "0") and (globalday = 2)>
  [ 21] jmpifz [ 35] ............................ if (item 3 of globalnight = "0") and (globalday = 2) then / else
  [ 24] pushint8 15 ............................. <15>
  [ 26] pushint8 1 .............................. <1>
  [ 28] pushint8 25 ............................. <25>
  [ 30] set 6 ................................... set the visible of sprite 15 to 1
  [ 32] jmp [ 42]
  [ 35] pushint8 15 ............................. <15>
  [ 37] pushzero ................................ <0>
  [ 38] pushint8 25 ............................. <25>
  [ 40] set 6 ................................... set the visible of sprite 15 to 0
  [ 42] ret
end
