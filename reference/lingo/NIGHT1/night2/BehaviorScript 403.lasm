on exitFrame
  [  0] pushint8 1 .............................. <1>
  [  2] pusharglist 1 ........................... <1>
  [  4] extcall 50 .............................. <soundBusy(1)>
  [  6] not ..................................... <not soundBusy(1)>
  [  7] jmpifz [ 16] ............................ if not soundBusy(1) then
  [ 10] pushcons 0 .............................. <"path5go">
  [ 12] pusharglistnoret 1 ...................... <"path5go">
  [ 14] extcall 3 ............................... go("path5go")
  [ 16] ret
end
