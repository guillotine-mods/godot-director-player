on exitFrame
  [  0] getglobal 74 ............................ <globalday>
  [  3] pushint8 2 .............................. <2>
  [  6] eq ...................................... <globalday = 2>
  [  7] pushzero ................................ <0>
  [  8] pushzero ................................ <0>
  [  9] pushzero ................................ <0>
  [ 10] pushzero ................................ <0>
  [ 11] pushint8 2 .............................. <2>
  [ 14] pushzero ................................ <0>
  [ 15] pushzero ................................ <0>
  [ 16] pushzero ................................ <0>
  [ 17] getglobal 82 ............................ <globalnight>
  [ 20] getchunk ................................ <item 2 of globalnight>
  [ 21] pushcons 0 .............................. <"0">
  [ 23] eq ...................................... <item 2 of globalnight = "0">
  [ 24] and ..................................... <(globalday = 2) and (item 2 of globalnight = "0")>
  [ 25] jmpifz [ 85] ............................ if (globalday = 2) and (item 2 of globalnight = "0") then
  [ 28] pushcons 8 .............................. <"points">
  [ 30] pushcons 16 ............................. <"master">
  [ 32] pushint8 2 .............................. <2>
  [ 35] get 11 .................................. <the text of field "points" of castLib "master">
  [ 37] pusharglist 1 ........................... <the text of field "points" of castLib "master">
  [ 39] extcall 15 .............................. <value(the text of field "points" of castLib "master")>
  [ 41] setlocal 0 .............................. x = value(the text of field "points" of castLib "master")
  [ 43] getlocal 0 .............................. <x>
  [ 45] pushint8 1 .............................. <1>
  [ 48] add ..................................... <x + 1>
  [ 49] setlocal 0 .............................. x = x + 1
  [ 51] getlocal 0 .............................. <x>
  [ 53] pushint8 10 ............................. <10>
  [ 56] lt ...................................... <x < 10>
  [ 57] jmpifz [ 74] ............................ if x < 10 then / else
  [ 60] pushcons 24 ............................. <"00">
  [ 62] getlocal 0 .............................. <x>
  [ 64] joinstr ................................. <"00" & x>
  [ 65] pushcons 32 ............................. <"points">
  [ 67] pushcons 40 ............................. <"master">
  [ 69] put 22 .................................. put "00" & x into field "points" of castLib "master"
  [ 71] jmp [ 85]
  [ 74] pushcons 48 ............................. <"0">
  [ 76] getlocal 0 .............................. <x>
  [ 78] joinstr ................................. <"0" & x>
  [ 79] pushcons 56 ............................. <"points">
  [ 81] pushcons 64 ............................. <"master">
  [ 83] put 22 .................................. put "0" & x into field "points" of castLib "master"
