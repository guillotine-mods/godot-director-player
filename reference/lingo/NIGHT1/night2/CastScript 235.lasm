  [ 54] eq ...................................... <x = "continue">
  [ 55] and ..................................... <(line i of field "objectsfield" of castLib "master" = "empty") and (x = "continue")>
  [ 56] jmpifz [ 80] ............................ if (line i of field "objectsfield" of castLib "master" = "empty") and (x = "continue") then
  [ 59] pushcons 56 ............................. <"sciser">
  [ 61] pushzero ................................ <0>
  [ 62] pushzero ................................ <0>
  [ 63] pushzero ................................ <0>
  [ 64] pushzero ................................ <0>
  [ 65] pushzero ................................ <0>
