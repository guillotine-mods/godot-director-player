  [ 19] pushcons 8 .............................. <"objectsfield">
  [ 21] pushcons 16 ............................. <"master">
  [ 23] getfield ................................ <field("objectsfield", "master")>
  [ 24] pushint8 4 .............................. <4>
  [ 26] get 1 ................................... <the number of lines in field "objectsfield" of castLib "master">
  [ 28] lteq
