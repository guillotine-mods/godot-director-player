on exitFrame
  [  0] pushsymb 42 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  4] getglobal 31 ............................ <soundspath>
  [  6] pushcons 0 .............................. <"pfhair.aif">
  [  8] joinstr ................................. <soundspath & "pfhair.aif">
  [  9] pusharglistnoret 3 ...................... <1, soundspath & "pfhair.aif">
  [ 11] extcall 43 .............................. sound playFile 1, soundspath & "pfhair.aif"
  [ 13] pushint8 15 ............................. <15>
  [ 15] pushzero ................................ <0>
  [ 16] pushint8 25 ............................. <25>
  [ 18] set 6 ................................... set the visible of sprite 15 to 0
  [ 20] pushcons 8 .............................. <"done">
  [ 22] pushzero ................................ <0>
  [ 23] pushzero ................................ <0>
  [ 24] pushzero ................................ <0>
  [ 25] pushzero ................................ <0>
  [ 26] pushint8 3 .............................. <3>
  [ 28] pushzero ................................ <0>
  [ 29] pushzero ................................ <0>
  [ 30] pushzero ................................ <0>
  [ 31] pushvarref 82 ........................... <globalnight>
  [ 33] putchunk 18 ............................. put "done" into item 3 of globalnight
  [ 35] pusharglistnoret 0 ...................... <>
  [ 37] extcall 67 .............................. play done
  [ 39] ret
end
