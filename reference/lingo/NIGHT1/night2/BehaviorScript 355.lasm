on exitFrame
  [  0] pushzero ................................ <0>
  [  1] pushzero ................................ <0>
  [  2] pushzero ................................ <0>
  [  3] pushzero ................................ <0>
  [  4] pushint8 2 .............................. <2>
  [  7] pushzero ................................ <0>
  [  8] pushzero ................................ <0>
  [  9] pushzero ................................ <0>
  [ 10] getglobal 82 ............................ <globalnight>
  [ 13] getchunk ................................ <item 2 of globalnight>
  [ 14] pushcons 0 .............................. <"0">
  [ 16] eq ...................................... <item 2 of globalnight = "0">
  [ 17] jmpifz [ 48] ............................ if item 2 of globalnight = "0" then
  [ 20] pushint8 1 .............................. <1>
  [ 23] pusharglist 1 ........................... <1>
  [ 25] extcall 50 .............................. <soundBusy(1)>
  [ 28] not ..................................... <not soundBusy(1)>
  [ 29] jmpifz [ 48] ............................ if not soundBusy(1) then
  [ 32] pushsymb 42 ............................. <#playFile>
  [ 35] pushint8 1 .............................. <1>
  [ 38] getglobal 31 ............................ <soundspath>
