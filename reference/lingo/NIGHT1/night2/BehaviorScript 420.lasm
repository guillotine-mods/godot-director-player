on exitFrame
  [  0] pushcons 0 .............................. <"points">
  [  2] pushcons 8 .............................. <"master">
  [  4] pushint8 2 .............................. <2>
  [  7] get 11 .................................. <the text of field "points" of castLib "master">
  [  9] pusharglist 1 ........................... <the text of field "points" of castLib "master">
  [ 11] extcall 15 .............................. <value(the text of field "points" of castLib "master")>
  [ 13] setlocal 0 .............................. x = value(the text of field "points" of castLib "master")
  [ 15] getlocal 0 .............................. <x>
  [ 17] pushint8 1 .............................. <1>
  [ 20] add ..................................... <x + 1>
  [ 21] setlocal 0 .............................. x = x + 1
  [ 23] getlocal 0 .............................. <x>
  [ 25] pushint8 10 ............................. <10>
  [ 28] lt ...................................... <x < 10>
  [ 29] jmpifz [ 46] ............................ if x < 10 then / else
  [ 32] pushcons 16 ............................. <"00">
  [ 34] getlocal 0 .............................. <x>
  [ 36] joinstr ................................. <"00" & x>
  [ 37] pushcons 24 ............................. <"points">
  [ 39] pushcons 32 ............................. <"master">
  [ 41] put 22 .................................. put "00" & x into field "points" of castLib "master"
  [ 43] jmp [ 57]
  [ 46] pushcons 40 ............................. <"0">
  [ 48] getlocal 0 .............................. <x>
  [ 50] joinstr ................................. <"0" & x>
  [ 51] pushcons 48 ............................. <"points">
  [ 53] pushcons 56 ............................. <"master">
  [ 55] put 22 .................................. put "0" & x into field "points" of castLib "master"
  [ 57] ret
end
