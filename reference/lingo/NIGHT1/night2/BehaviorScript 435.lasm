on exitFrame
  [  0] pushint8 2 .............................. <2>
  [  3] pushint8 200 ............................ <200>
  [  6] pushint8 1 .............................. <1>
  [  9] set 4 ................................... set the volume of sound 2 to 200
  [ 11] pushsymb 42 ............................. <#playFile>
  [ 14] pushint8 1 .............................. <1>
  [ 17] getglobal 32 ............................ <effectspath>
  [ 20] pushcons 0 .............................. <"doorshut.aif">
  [ 22] joinstr ................................. <effectspath & "doorshut.aif">
  [ 23] pusharglistnoret 3 ...................... <1, effectspath & "doorshut.aif">
  [ 25] extcall 43 .............................. sound playFile 1, effectspath & "doorshut.aif"
  [ 28] ret
end
