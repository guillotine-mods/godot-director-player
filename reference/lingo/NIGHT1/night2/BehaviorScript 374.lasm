on exitFrame
  [  0] getglobal 74 ............................ <globalday>
  [  3] pushint8 1 .............................. <1>
  [  6] eq ...................................... <globalday = 1>
  [  7] jmpifz [ 22] ............................ if globalday = 1 then / else
  [ 10] pushint8 1 .............................. <1>
  [ 13] pushcons 0 .............................. <"sleep1.dir">
  [ 15] pusharglistnoret 2 ...................... <1, "sleep1.dir">
  [ 17] extcall 3 ............................... go(1, "sleep1.dir")
  [ 19] jmp [ 31]
  [ 22] pushint8 1 .............................. <1>
  [ 25] pushcons 8 .............................. <"sleep2.dir">
  [ 27] pusharglistnoret 2 ...................... <1, "sleep2.dir">
  [ 29] extcall 3 ............................... go(1, "sleep2.dir")
  [ 31] ret
end
