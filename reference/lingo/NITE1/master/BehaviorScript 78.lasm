on exitFrame
  [  0] pushsymb 26 ............................. <#playFile>
  [  2] pushint8 2 .............................. <2>
  [  5] getglobal 28 ............................ <soundspath>
  [  7] pushcons 0 .............................. <"tofaaa.aif">
  [  9] joinstr ................................. <soundspath & "tofaaa.aif">
  [ 10] pusharglistnoret 3 ...................... <2, soundspath & "tofaaa.aif">
  [ 12] extcall 27 .............................. sound playFile 2, soundspath & "tofaaa.aif"
  [ 14] pushsymb 26 ............................. <#playFile>
  [ 16] pushint8 1 .............................. <1>
  [ 19] getglobal 28 ............................ <soundspath>
  [ 21] pushcons 8 .............................. <"pipaa.aif">
  [ 23] joinstr ................................. <soundspath & "pipaa.aif">
  [ 24] pusharglistnoret 3 ...................... <1, soundspath & "pipaa.aif">
  [ 26] extcall 27 .............................. sound playFile 1, soundspath & "pipaa.aif"
  [ 28] ret
end
