on exitFrame
  [  0] pushsymb 25 ............................. <#playFile>
  [  2] pushint8 2 .............................. <2>
  [  5] getglobal 32 ............................ <effectspath>
  [  8] pushcons 0 .............................. <"clik2.aif">
  [ 10] joinstr ................................. <effectspath & "clik2.aif">
  [ 11] pusharglistnoret 3 ...................... <2, effectspath & "clik2.aif">
  [ 13] extcall 26 .............................. sound playFile 2, effectspath & "clik2.aif"
  [ 15] pushsymb 25 ............................. <#playFile>
  [ 17] pushint8 1 .............................. <1>
  [ 20] getglobal 27 ............................ <soundspath>
  [ 22] pushcons 8 .............................. <"fug12.aif">
  [ 24] joinstr ................................. <soundspath & "fug12.aif">
  [ 25] pusharglistnoret 3 ...................... <1, soundspath & "fug12.aif">
  [ 27] extcall 26 .............................. sound playFile 1, soundspath & "fug12.aif"
  [ 29] ret
end
