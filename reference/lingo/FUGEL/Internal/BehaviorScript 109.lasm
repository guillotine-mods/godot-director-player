on exitFrame
  [  0] pushsymb 25 ............................. <#playFile>
  [  2] pushint8 2 .............................. <2>
  [  5] getglobal 27 ............................ <soundspath>
  [  7] pushcons 0 .............................. <"fug24.aif">
  [  9] joinstr ................................. <soundspath & "fug24.aif">
  [ 10] pusharglistnoret 3 ...................... <2, soundspath & "fug24.aif">
  [ 12] extcall 26 .............................. sound playFile 2, soundspath & "fug24.aif"
  [ 14] ret
end
