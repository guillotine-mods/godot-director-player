on exitFrame
  [  0] pushzero ................................ <0>
  [  1] setglobal 12 ............................ optcount = 0
  [  3] pushsymb 15 ............................. <#playFile>
  [  5] pushint8 1 .............................. <1>
  [  8] getglobal 14 ............................ <tlkpath>
  [ 10] pushcons 0 .............................. <"hez30.aif">
  [ 12] joinstr ................................. <tlkpath & "hez30.aif">
  [ 13] pusharglistnoret 3 ...................... <1, tlkpath & "hez30.aif">
  [ 15] extcall 16 .............................. sound playFile 1, tlkpath & "hez30.aif"
  [ 17] ret
end
