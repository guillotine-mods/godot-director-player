on mouseUp
  [  0] pushsymb 15 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 14 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"hez38.aif">
  [  9] joinstr ................................. <tlkpath & "hez38.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "hez38.aif">
  [ 12] extcall 16 .............................. sound playFile 1, tlkpath & "hez38.aif"
  [ 14] pushcons 8 .............................. <"choose1c">
  [ 16] pusharglistnoret 1 ...................... <"choose1c">
  [ 18] extcall 13 .............................. go("choose1c")
  [ 20] ret
end
