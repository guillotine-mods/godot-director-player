on exitFrame
  [  0] getglobal 12 ............................ <optcount>
  [  2] pushint8 1 .............................. <1>
  [  5] add ..................................... <optcount + 1>
  [  6] setglobal 12 ............................ optcount = optcount + 1
  [  8] getglobal 12 ............................ <optcount>
  [ 10] pushint8 2 .............................. <2>
  [ 13] gt ...................................... <optcount > 2>
  [ 14] jmpifz [ 26] ............................ if optcount > 2 then / else
  [ 17] pushcons 0 .............................. <"conect2">
  [ 19] pusharglistnoret 1 ...................... <"conect2">
  [ 21] extcall 13 .............................. go("conect2")
  [ 23] jmp [ 32]
  [ 26] pushcons 8 .............................. <"choose2">
  [ 28] pusharglistnoret 1 ...................... <"choose2">
  [ 30] extcall 13 .............................. go("choose2")
  [ 32] ret
end
