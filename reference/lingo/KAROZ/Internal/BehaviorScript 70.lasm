on exitFrame
  [  0] pushsymb 25 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 27 ............................ <soundspath>
  [  7] pushcons 0 .............................. <"kar3.aif">
  [  9] joinstr ................................. <soundspath & "kar3.aif">
  [ 10] pusharglistnoret 3 ...................... <1, soundspath & "kar3.aif">
  [ 12] extcall 26 .............................. sound playFile 1, soundspath & "kar3.aif"
  [ 14] ret
end
