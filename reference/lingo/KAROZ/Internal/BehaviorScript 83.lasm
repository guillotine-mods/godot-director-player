on exitFrame
  [  0] pushsymb 25 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 27 ............................ <soundspath>
  [  7] pushcons 0 .............................. <"kar12.aif">
  [  9] joinstr ................................. <soundspath & "kar12.aif">
  [ 10] pusharglistnoret 3 ...................... <1, soundspath & "kar12.aif">
  [ 12] extcall 26 .............................. sound playFile 1, soundspath & "kar12.aif"
  [ 14] pushsymb 25 ............................. <#playFile>
  [ 16] pushint8 2 .............................. <2>
  [ 19] getglobal 29 ............................ <effectspath>
  [ 21] pushcons 8 .............................. <"night1.aif">
  [ 23] joinstr ................................. <effectspath & "night1.aif">
  [ 24] pusharglistnoret 3 ...................... <2, effectspath & "night1.aif">
  [ 26] extcall 26 .............................. sound playFile 2, effectspath & "night1.aif"
  [ 28] ret
end
