on mouseUp
  [  0] pushsymb 25 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 27 ............................ <soundspath>
  [  7] pushcons 0 .............................. <"kar2b.aif">
  [  9] joinstr ................................. <soundspath & "kar2b.aif">
  [ 10] pusharglistnoret 3 ...................... <1, soundspath & "kar2b.aif">
  [ 12] extcall 26 .............................. sound playFile 1, soundspath & "kar2b.aif"
  [ 14] pushcons 8 .............................. <"choose1a">
  [ 16] pusharglistnoret 1 ...................... <"choose1a">
  [ 18] extcall 18 .............................. go("choose1a")
  [ 20] ret
end
