on mouseUp
  [  0] pushint16 10 ............................ <10>
  [  3] pusharglist 1 ........................... <10>
  [  5] extcall 20 .............................. <sprite(10)>
  [  7] pushint16 1 ............................. <1>
  [ 10] setobjprop 21 ........................... sprite(10).visible = 1
  [ 12] pushint16 12 ............................ <12>
  [ 15] pusharglist 1 ........................... <12>
  [ 17] extcall 20 .............................. <sprite(12)>
  [ 19] pushint16 1 ............................. <1>
  [ 22] setobjprop 21 ........................... sprite(12).visible = 1
  [ 24] pushcons 0 .............................. <"roomafromver">
  [ 26] pusharglistnoret 1 ...................... <"roomafromver">
  [ 28] extcall 68 .............................. go("roomafromver")
  [ 31] ret
end
