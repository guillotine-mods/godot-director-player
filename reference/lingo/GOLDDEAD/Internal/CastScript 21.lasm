on mouseUp
  [  0] pushsymb 14 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 21 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"hez83.aif">
  [  9] joinstr ................................. <tlkpath & "hez83.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "hez83.aif">
  [ 12] extcall 15 .............................. sound playFile 1, tlkpath & "hez83.aif"
  [ 14] pushcons 8 .............................. <"choose1b">
  [ 16] pusharglistnoret 1 ...................... <"choose1b">
  [ 18] extcall 17 .............................. go("choose1b")
  [ 20] ret
end
