on exitFrame
  [  0] pushsymb 14 ............................. <#playFile>
  [  2] pushint8 1 .............................. <1>
  [  5] getglobal 21 ............................ <tlkpath>
  [  7] pushcons 0 .............................. <"mog32.aif">
  [  9] joinstr ................................. <tlkpath & "mog32.aif">
  [ 10] pusharglistnoret 3 ...................... <1, tlkpath & "mog32.aif">
  [ 12] extcall 15 .............................. sound playFile 1, tlkpath & "mog32.aif"
  [ 14] ret
end
