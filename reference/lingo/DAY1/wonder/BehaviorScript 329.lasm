on exitFrame
  [  0] pushint8 23 ............................. <23>
  [  3] pusharglist 1 ........................... <23>
  [  5] extcall 94 .............................. <sprite(23)>
  [  8] pushzero ................................ <0>
  [  9] setobjprop 95 ........................... sprite(23).visible = 0
  [ 12] ret
end
