on exitFrame
  [  0] pushint8 30 ............................. <30>
  [  3] pushint8 14 ............................. <14>
  [  6] get 6 ................................... <the locV of sprite 30>
  [  8] pushint8 279 ............................ <279>
  [ 11] gt ...................................... <the locV of sprite 30 > 279>
  [ 12] jmpifz [ 30] ............................ if the locV of sprite 30 > 279 then / else
  [ 15] pushint8 34 ............................. <34>
  [ 18] pusharglist 1 ........................... <34>
  [ 20] extcall 94 .............................. <sprite(34)>
  [ 23] pushzero ................................ <0>
  [ 24] setobjprop 95 ........................... sprite(34).visible = 0
  [ 27] jmp [ 44]
  [ 30] pushint8 34 ............................. <34>
  [ 33] pusharglist 1 ........................... <34>
  [ 35] extcall 94 .............................. <sprite(34)>
  [ 38] pushint8 1 .............................. <1>
  [ 41] setobjprop 95 ........................... sprite(34).visible = 1
  [ 44] pushint8 2 .............................. <2>
  [ 47] pusharglist 1 ........................... <2>
  [ 49] extcall 50 .............................. <soundBusy(2)>
  [ 52] not ..................................... <not soundBusy(2)>
  [ 53] getglobal 118 ........................... <whichsnd>
  [ 56] pushcons 0 .............................. <"field">
  [ 58] nteq .................................... <whichsnd <> "field">
  [ 59] or ...................................... <not soundBusy(2) or (whichsnd <> "field")>
  [ 60] jmpifz [ 85] ............................ if not soundBusy(2) or (whichsnd <> "field") then
  [ 63] pushsymb 42 ............................. <#playFile>
  [ 66] pushint8 2 .............................. <2>
  [ 69] getglobal 32 ............................ <effectspath>
  [ 72] pushcons 8 .............................. <"field.aif">
  [ 74] joinstr ................................. <effectspath & "field.aif">
  [ 75] pusharglistnoret 3 ...................... <2, effectspath & "field.aif">
  [ 77] extcall 43 .............................. sound playFile 2, effectspath & "field.aif"
  [ 80] pushcons 16 ............................. <"field">
  [ 82] setglobal 118 ........................... whichsnd = "field"
  [ 85] ret
end
