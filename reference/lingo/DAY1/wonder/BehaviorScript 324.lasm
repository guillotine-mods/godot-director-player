on exitFrame
  [  0] pushint8 8 .............................. <8>
  [  3] pusharglist 1 ........................... <8>
  [  5] extcall 94 .............................. <sprite(8)>
  [  8] pushzero ................................ <0>
  [  9] setobjprop 95 ........................... sprite(8).visible = 0
  [ 12] pushzero ................................ <0>
  [ 13] pushzero ................................ <0>
  [ 14] pushzero ................................ <0>
  [ 15] pushzero ................................ <0>
  [ 16] pushint8 5 .............................. <5>
  [ 19] pushzero ................................ <0>
  [ 20] pushint8 1 .............................. <1>
  [ 23] pushzero ................................ <0>
  [ 24] pushcons 0 .............................. <"Dprocess">
  [ 26] pushzero ................................ <0>
  [ 27] getfield ................................ <field("Dprocess")>
  [ 28] getchunk ................................ <item 5 of line 1 of field "Dprocess">
  [ 29] pushcons 8 .............................. <"rotor">
  [ 31] eq ...................................... <item 5 of line 1 of field "Dprocess" = "rotor">
  [ 32] jmpifz [ 47] ............................ if item 5 of line 1 of field "Dprocess" = "rotor" then
  [ 35] pushint8 7 .............................. <7>
  [ 38] pusharglist 1 ........................... <7>
  [ 40] extcall 94 .............................. <sprite(7)>
  [ 43] pushzero ................................ <0>
  [ 44] setobjprop 95 ........................... sprite(7).visible = 0
  [ 47] pushsymb 42 ............................. <#playFile>
  [ 50] pushint8 1 .............................. <1>
  [ 53] getglobal 31 ............................ <soundspath>
  [ 55] pushcons 16 ............................. <"lturn">
  [ 57] pushint8 3 .............................. <3>
  [ 60] pusharglist 1 ........................... <3>
  [ 62] extcall 44 .............................. <random(3)>
  [ 65] joinstr ................................. <"lturn" & random(3)>
  [ 66] pushcons 24 ............................. <".aif">
  [ 68] joinstr ................................. <"lturn" & random(3) & ".aif">
  [ 69] joinstr ................................. <soundspath & "lturn" & random(3) & ".aif">
  [ 70] pusharglistnoret 3 ...................... <1, soundspath & "lturn" & random(3) & ".aif">
  [ 72] extcall 43 .............................. sound playFile 1, soundspath & "lturn" & random(3) & ".aif"
  [ 75] ret
end
