  [ 51] extcall 43 .............................. sound playFile 2, effectspath & "lgtbrk.aif"
  [ 54] pushcons 16 ............................. <"lgtbrk">
  [ 56] setglobal 118 ........................... whichsnd = "lgtbrk"
  [ 59] jmp [103]
  [ 62] pushint8 2 .............................. <2>
  [ 65] pusharglist 1 ........................... <2>
  [ 67] extcall 50 .............................. <soundBusy(2)>
  [ 70] not ..................................... <not soundBusy(2)>
  [ 71] getglobal 118 ........................... <whichsnd>
  [ 74] pushcons 24 ............................. <"lgteng">
