on exitFrame
  [  0] pushint8 34 ............................. <34>
  [  3] pusharglist 1 ........................... <34>
  [  5] extcall 94 .............................. <sprite(34)>
  [  8] pushint8 1 .............................. <1>
  [ 11] setobjprop 95 ........................... sprite(34).visible = 1
  [ 14] ret
end
