on exitFrame
  [  0] pushsymb 42 ............................. <#playFile>
  [  3] pushint8 1 .............................. <1>
  [  6] getglobal 32 ............................ <effectspath>
  [  9] pushcons 0 .............................. <"sabcar.aif">
  [ 11] joinstr ................................. <effectspath & "sabcar.aif">
  [ 12] pusharglistnoret 3 ...................... <1, effectspath & "sabcar.aif">
  [ 14] extcall 43 .............................. sound playFile 1, effectspath & "sabcar.aif"
  [ 17] ret
end
