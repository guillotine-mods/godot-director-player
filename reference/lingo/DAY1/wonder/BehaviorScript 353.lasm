on exitFrame
  [  0] pushint8 2 .............................. <2>
  [  3] pusharglist 1 ........................... <2>
  [  5] extcall 50 .............................. <soundBusy(2)>
  [  8] not ..................................... <not soundBusy(2)>
  [  9] getglobal 118 ........................... <whichsnd>
  [ 12] pushcons 0 .............................. <"field">
  [ 14] nteq .................................... <whichsnd <> "field">
  [ 15] or ...................................... <not soundBusy(2) or (whichsnd <> "field")>
  [ 16] jmpifz [ 41] ............................ if not soundBusy(2) or (whichsnd <> "field") then
  [ 19] pushsymb 42 ............................. <#playFile>
  [ 22] pushint8 2 .............................. <2>
  [ 25] getglobal 32 ............................ <effectspath>
  [ 28] pushcons 8 .............................. <"field.aif">
  [ 30] joinstr ................................. <effectspath & "field.aif">
  [ 31] pusharglistnoret 3 ...................... <2, effectspath & "field.aif">
  [ 33] extcall 43 .............................. sound playFile 2, effectspath & "field.aif"
  [ 36] pushcons 16 ............................. <"field">
  [ 38] setglobal 118 ........................... whichsnd = "field"
  [ 41] ret
end
