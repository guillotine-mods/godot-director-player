on mouseUp
  [  0] pushcons 0 .............................. <"000">
  [  2] setglobal 17 ............................ nextroomdata = "000"
  [  4] getglobal 10 ............................ <egozv>
  [  6] pushint8 276 ............................ <276>
  [  9] nteq .................................... <egozv <> 276>
  [ 10] getglobal 6 ............................. <egozh>
  [ 12] pushint8 145 ............................ <145>
  [ 15] nteq .................................... <egozh <> 145>
  [ 16] and ..................................... <(egozv <> 276) and (egozh <> 145)>
  [ 17] jmpifz [ 37] ............................ if (egozv <> 276) and (egozh <> 145) then / else
  [ 20] pushint8 276 ............................ <276>
  [ 23] setglobal 10 ............................ egozv = 276
  [ 25] pushint8 145 ............................ <145>
  [ 28] setglobal 6 ............................. egozh = 145
  [ 30] pusharglistnoret 0 ...................... <>
  [ 32] extcall 4 ............................... walkonby()
  [ 34] jmp [ 68]
  [ 37] getglobal 8 ............................. <whatodo>
  [ 39] pushcons 8 .............................. <"stand">
  [ 41] eq ...................................... <whatodo = "stand">
  [ 42] jmpifz [ 68] ............................ if whatodo = "stand" then
  [ 45] pushsymb 42 ............................. <#playFile>
  [ 47] pushint8 1 .............................. <1>
  [ 49] getglobal 31 ............................ <soundspath>
  [ 51] pushcons 16 ............................. <"pgold">
  [ 53] pushint8 5 .............................. <5>
  [ 55] pusharglist 1 ........................... <5>
  [ 57] extcall 44 .............................. <random(5)>
  [ 59] joinstr ................................. <"pgold" & random(5)>
  [ 60] pushcons 24 ............................. <".aif">
  [ 62] joinstr ................................. <"pgold" & random(5) & ".aif">
  [ 63] joinstr ................................. <soundspath & "pgold" & random(5) & ".aif">
  [ 64] pusharglistnoret 3 ...................... <1, soundspath & "pgold" & random(5) & ".aif">
  [ 66] extcall 43 .............................. sound playFile 1, soundspath & "pgold" & random(5) & ".aif"
  [ 68] ret
end
