on exitFrame
  [  0] pushint8 30 ............................. <30>
  [  3] pushcons 0 .............................. <"miad">
  [  5] getglobal 7 ............................. <syz>
  [  7] joinstr ................................. <"miad" & syz>
  [  8] pushzero ................................ <0>
  [  9] pushint8 10 ............................. <10>
  [ 12] get 9 ................................... <the number of member ("miad" & syz)>
  [ 14] pushint8 35 ............................. <35>
  [ 17] set 6 ................................... set the memberNum of sprite 30 to the number of member ("miad" & syz)
  [ 19] ret
end
