on exitFrame
  [  0] pushint8 2 .............................. <2>
  [  3] pusharglist 1 ........................... <2>
  [  5] extcall 50 .............................. <soundBusy(2)>
  [  8] not ..................................... <not soundBusy(2)>
  [  9] getglobal 118 ........................... <whichsnd>
  [ 12] pushcons 0 .............................. <"veranda">
  [ 14] nteq .................................... <whichsnd <> "veranda">
  [ 15] or ...................................... <not soundBusy(2) or (whichsnd <> "veranda")>
  [ 16] jmpifz [ 41] ............................ if not soundBusy(2) or (whichsnd <> "veranda") then
  [ 19] pushsymb 42 ............................. <#playFile>
  [ 22] pushint8 2 .............................. <2>
  [ 25] getglobal 32 ............................ <effectspath>
  [ 28] pushcons 8 .............................. <"veranda.aif">
  [ 30] joinstr ................................. <effectspath & "veranda.aif">
  [ 31] pusharglistnoret 3 ...................... <2, effectspath & "veranda.aif">
  [ 33] extcall 43 .............................. sound playFile 2, effectspath & "veranda.aif"
  [ 36] pushcons 16 ............................. <"veranda">
  [ 38] setglobal 118 ........................... whichsnd = "veranda"
  [ 41] ret
end
