# Godot 4
.godot/
*.translation
export.cfg
*.tmp
build/
android/*.keystore
android/*.jks

# Broken keep-importer stubs — BMPs/WAVs load at runtime from source files
**/*.import

# Build artifacts / local logs
*.apk
smoke_log.txt

# OS / editor
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/

# Local overrides
*.local
user://

# Python bytecode
__pycache__/
*.pyc

# ScummVM reference sources, fetched by tools/fetch_scummvm_reference.sh.
# GPL-2.0-or-later, read for the model only — never vendored.
reference/scummvm/
.traces/

# Agent worktrees: full checkouts, 2.5 GB and counting. Never committed.
.claude/worktrees/

# The original Director game data the runtime reads: hundreds of megabytes, and
# not ours to redistribute. Point `director_game.cfg` at a local copy.
games/
